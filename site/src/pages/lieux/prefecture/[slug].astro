---
// Phase 4's first place pages (docs/plan.md Sec2.4) - one per préfecture,
// generated from site/src/data/lieux_prefectures.json
// (pipeline/export_lieux_prefecture_json.py). First getStaticPaths route
// in the project; every other page so far has been a flat file.
//
// Scope for this first pass, deliberately not the full Sec2.4 spec:
// population and prix are the only 2 themes with real préfecture-level
// data (this session's Phase 4 audit, docs/decisions.md); santé reaches
// one level short of that, région (7, each covering several préfectures),
// and is shown as its own honest middle case rather than folded into
// "available" or "not available" - see the freshness table below and
// pipeline/export_lieux_prefecture_json.py. The other 4 themes don't
// reach below national yet, stated plainly rather than faking a
// breakdown. Sous-préfecture "children" pages are named as not-yet-built
// rather than silently absent - 85 more pages, too large for this same
// pass. Locator maps added 2026-09-12
// (pipeline/build_geo_prefectures.py + export_prefecture_maps_json.py) -
// ready SVG path strings, no GeoJSON parsing or projection math here.
import lieux from "../../../data/lieux_prefectures.json";
import prefectureMaps from "../../../data/prefecture_maps.json";
import ThemeInit from "../../../components/ThemeInit.astro";
import SiteNav from "../../../components/SiteNav.astro";

export function getStaticPaths() {
  return Object.values(lieux).map((p: any) => ({
    params: { slug: p.slug },
    props: { place: p },
  }));
}

const { place } = Astro.props;
const currentMapPath = (prefectureMaps.prefectures as any)[place.entity_id]?.path;
const otherPrefectures = Object.entries(prefectureMaps.prefectures as any).filter(
  ([entityId]) => entityId !== place.entity_id
);

const fmt = (n: number) => Math.round(n).toLocaleString("fr-FR");
const fmtPrice = (n: number) => n.toLocaleString("fr-FR", { maximumFractionDigits: 1 });

const DENREE_SHORT: Record<string, string> = {
  prix_manioc_kg: "Manioc",
  prix_riz_kg: "Riz",
  prix_mais_kg: "Maïs",
  prix_boeuf_kg: "Bœuf",
  prix_huile_palme_l: "Huile",
};
const DENREE_ORDER = Object.keys(DENREE_SHORT);

// Sibling comparison bars: this préfecture plus its régional siblings,
// ranked by population - only built when population data exists for all
// of them, which it does for every préfecture today.
const comparisonRows = place.population
  ? [
      { name_fr: place.name_fr, pop_2021: place.population.pop_2021, isSelf: true },
      ...place.siblings.filter((s: any) => s.pop_2021 != null),
    ].sort((a, b) => b.pop_2021 - a.pop_2021)
  : [];
const maxComparisonPop = Math.max(1, ...comparisonRows.map((r) => r.pop_2021));

// National comparison: this préfecture against the national average per
// préfecture (national_2021 / 20), not the whole-country total - dividing
// by 20 first keeps the two bars on a comparable scale, which comparing
// straight against the national total wouldn't. Phase 4 step 6's other
// half (docs/plan.md, "Parked" note) - the régional-sibling comparison
// above already covers the first half.
const nationalAveragePop = place.population
  ? place.population.national_2021 / place.population.total_prefectures
  : 0;
const nationalComparisonRows = place.population
  ? [
      { name_fr: place.name_fr, pop_2021: place.population.pop_2021, isSelf: true },
      { name_fr: "Moyenne nationale par préfecture", pop_2021: nationalAveragePop, isSelf: false },
    ]
  : [];
const maxNationalComparisonPop = Math.max(1, ...nationalComparisonRows.map((r) => r.pop_2021));
const nationalRatio = place.population ? place.population.pop_2021 / nationalAveragePop : 0;
---
<!doctype html>
<html lang="fr">
  <head>
    <ThemeInit />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{place.name_fr} - BêAfrîka Data</title>
    <style>
      :root {
        --paper: #23251F; --surface: #2B2E27; --ink: #E8E6DA; --ink-muted: #A6A895;
        --ink-faint: #6E7161; --line: #33362A;
        --t-lieu: #D4A574;
        --stale: #E2694A; --stale-soft: #3A211A;
        --ochre: #E0A83D; --ochre-soft: #3A2E12;
      }
      :root[data-theme="light"] {
        --paper: #EDEEE6; --surface: #F8F8F2; --ink: #1B2420; --ink-muted: #5A6259;
        --ink-faint: #8B9188; --line: #D6D7C9;
        --t-lieu: #8B5E3C;
        --stale: #AC3A1E; --stale-soft: #F6DCD5;
        --ochre: #B8790F; --ochre-soft: #F1E3C6;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background-color: var(--paper);
        background-image:
          radial-gradient(1000px 520px at 10% -10%, color-mix(in srgb, var(--t-lieu) 9%, transparent), transparent 60%),
          radial-gradient(700px 420px at 100% 100%, color-mix(in srgb, var(--t-lieu) 6%, transparent), transparent 60%);
        background-attachment: fixed;
        color: var(--ink); font-family: system-ui, sans-serif; font-size: 15px; line-height: 1.5;
      }
      main { max-width: 1080px; margin: 0 auto; padding: 84px 24px 80px; }
      .crumb { font-family: ui-monospace, monospace; font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--ink-faint); margin-bottom: 6px; }
      .crumb a { color: var(--ink-faint); text-decoration: none; }
      .crumb a:hover { color: var(--t-lieu); text-decoration: underline; }
      h1 {
        font-size: 1.8rem; margin: 0 0 4px; display: inline-block;
        border-bottom: 3px solid var(--t-lieu); padding-bottom: 4px;
      }
      .level-tag {
        display: inline-block; font-family: ui-monospace, monospace; font-size: 11px;
        text-transform: uppercase; letter-spacing: 0.04em; color: var(--t-lieu);
        background: color-mix(in srgb, var(--t-lieu) 12%, var(--surface));
        padding: 2px 8px; border-radius: 2px; margin-left: 10px; vertical-align: middle;
      }
      .identity-block {
        margin: 16px 0 28px; padding: 14px 18px; background: var(--surface);
        border: 1px solid var(--line); border-left: 3px solid var(--t-lieu); border-radius: 3px;
        font-size: 13.5px; color: var(--ink-muted);
      }
      .identity-block dl { display: grid; grid-template-columns: max-content 1fr; gap: 4px 12px; margin: 0; }
      .identity-block dt { color: var(--ink-faint); font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.03em; padding-top: 2px; }
      .identity-block dd { margin: 0; }
      .identity-block code { font-family: ui-monospace, monospace; font-size: 0.92em; background: rgba(0,0,0,0.05); padding: 1px 4px; border-radius: 2px; }
      .locator-map { margin: 0 0 28px; }
      .locator-map svg { display: block; width: 100%; max-width: 380px; height: auto; margin: 0 auto; }
      .map-country { fill: var(--surface); stroke: var(--line); stroke-width: 1; }
      .map-prefecture { fill: none; stroke: var(--line); stroke-width: 0.6; }
      .map-prefecture-current { fill: var(--t-lieu); fill-opacity: 0.7; stroke: var(--t-lieu); stroke-width: 1.5; }
      .map-caption { text-align: center; font-size: 12px; color: var(--ink-faint); margin: 6px 0 0; }
      .headline-block {
        margin: 0 0 32px; padding: 22px 24px; background: var(--surface);
        border: 1px solid var(--line); border-left: 4px solid var(--t-lieu); border-radius: 3px;
      }
      .headline-value {
        font-family: ui-monospace, monospace; font-size: 2.6rem; font-weight: 600;
        color: var(--t-lieu); display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
      }
      .headline-value .unit { font-size: 1.1rem; color: var(--ink-faint); font-family: system-ui, sans-serif; }
      .headline-caption { color: var(--ink-muted); font-size: 13.5px; margin: 4px 0 0; }
      .badge {
        display: inline-block; font-family: ui-monospace, monospace; font-size: 10.5px;
        padding: 2px 6px; border-radius: 2px; margin-left: 6px; vertical-align: middle;
      }
      .badge.estime { background: var(--ochre-soft); color: var(--ochre); }
      h2 { font-size: 1.15rem; margin: 40px 0 12px; padding-top: 18px; border-top: 1px solid var(--line); }
      .section-toggle { margin: 40px 0 12px; padding-top: 18px; border-top: 1px solid var(--line); }
      .section-toggle summary {
        font-size: 1.15rem; cursor: pointer; list-style: none;
        display: flex; align-items: center; gap: 8px;
      }
      .section-toggle summary::-webkit-details-marker { display: none; }
      .section-toggle summary::before { content: "▸"; font-size: 14px; color: var(--t-lieu); transition: transform 0.15s ease; }
      .section-toggle[open] summary::before { transform: rotate(90deg); }
      .sentence {
        font-style: italic; font-size: 15.5px; line-height: 1.5; color: var(--ink);
        margin: 12px 0 0; padding-left: 12px; border-left: 2px solid var(--t-lieu);
      }
      .comparison-row { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
      .comparison-label { width: 130px; flex: none; font-size: 13px; text-align: right; color: var(--ink-muted); }
      .comparison-label.isSelf { color: var(--t-lieu); font-weight: 600; }
      .comparison-bar-track { flex: 1; background: var(--line); border-radius: 2px; height: 18px; overflow: hidden; }
      .comparison-bar-fill { height: 100%; background: var(--ink-faint); border-radius: 2px 0 0 2px; }
      .comparison-bar-fill.isSelf { background: var(--t-lieu); }
      .comparison-value { width: 90px; flex: none; font-family: ui-monospace, monospace; font-size: 12.5px; color: var(--ink-muted); }
      .prefecture-block table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; margin-top: 8px; }
      .prefecture-block th { text-align: right; font-size: 10px; color: var(--ink-faint); font-weight: 400; padding: 0 0 4px 6px; }
      .prefecture-block th:first-child { text-align: left; padding-left: 0; }
      .prefecture-block td { text-align: right; padding: 5px 0 5px 6px; border-top: 1px solid var(--line); font-size: 13px; }
      .prefecture-block td:first-child { text-align: left; color: var(--ink-muted); }
      .freshness-table { width: 100%; border-collapse: collapse; font-size: 13.5px; margin-top: 8px; }
      .freshness-table th { text-align: left; font-size: 10.5px; text-transform: uppercase; color: var(--ink-faint); font-weight: 400; padding: 0 8px 6px 0; }
      .freshness-table td { padding: 7px 8px 7px 0; border-top: 1px solid var(--line); }
      .freshness-table .yes { color: var(--t-lieu); font-weight: 600; }
      .freshness-table .no { color: var(--ink-faint); font-style: italic; }
      .not-measured { margin: 14px 0 0; padding-left: 20px; color: var(--ink-muted); font-size: 14px; line-height: 1.7; }
      .not-measured li { margin-bottom: 4px; }
      footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 12px; color: var(--ink-faint); }
      footer a { color: var(--ink-muted); }
      .site-nav { display: flex; gap: 14px; margin-top: 14px; flex-wrap: wrap; }
      .site-nav a { color: var(--t-lieu); font-size: 12.5px; transition: opacity 0.15s ease; }
      .site-nav a:hover { opacity: 0.7; }
    </style>
  </head>
  <body>
    <SiteNav />
    <main>
      <div class="crumb">
        <a href="/">République centrafricaine</a> / <a href="/lieux/">Lieux</a>
      </div>
      <h1>{place.name_fr}<span class="level-tag">préfecture</span></h1>

      <div class="identity-block">
        <dl>
          <dt>Région</dt><dd>{place.region_name}</dd>
          <dt>Découpage en vigueur depuis</dt><dd>{place.valid_from}</dd>
          {place.aliases.length > 0 && (
            <>
              <dt>Codes sources</dt>
              <dd>{place.aliases.map((a: any) => <code>{a.code}</code>).reduce((prev: any, curr: any) => [prev, " ", curr])}</dd>
            </>
          )}
        </dl>
      </div>

      {currentMapPath && (
        <div class="locator-map">
          <svg viewBox={prefectureMaps.view_box} role="img" aria-label={`Localisation de ${place.name_fr} en République centrafricaine`}>
            <path class="map-country" fill-rule="evenodd" d={prefectureMaps.country_path} />
            {otherPrefectures.map(([, p]: any) => (
              <path class="map-prefecture" fill-rule="evenodd" d={p.path} />
            ))}
            <path class="map-prefecture-current" fill-rule="evenodd" d={currentMapPath} />
          </svg>
          <p class="map-caption">Localisation de {place.name_fr} en République centrafricaine.</p>
        </div>
      )}

      {place.population && (
        <div class="headline-block">
          <div class="headline-value">
            {fmt(place.population.pop_2021)}<span class="unit">habitants, 2021</span>
            {place.population.pop_2021_flag === "estime" && <span class="badge estime">estimé</span>}
          </div>
          <p class="headline-caption">
            {place.population.rank_2021}ᵉ préfecture la plus peuplée sur {place.population.total_prefectures}, {place.population.share_of_national_pct}% de la population nationale.
          </p>
          <p class="sentence">
            En 2003, {place.name_fr} comptait {fmt(place.population.pop_2003)} habitants (recensement) ; en 2021, l'estimation est de {fmt(place.population.pop_2021)}
            {place.population.pop_2025 && <> ; la projection ICASEES 2025 (cycle HNRP), somme des projections par sous-préfecture ci-dessous, est de {fmt(place.population.pop_2025)}</>}.
          </p>
        </div>
      )}

      {place.sous_prefectures.length > 0 && (
        <details class="section-toggle">
          <summary>Sous-préfectures</summary>
          <p class="headline-caption">
            Projection ICASEES 2025 (cycle HNRP), par sous-préfecture - la plus fine profondeur
            géographique disponible pour cet indicateur. Pas encore de page individuelle par
            sous-préfecture (Phase 4, étape suivante).
          </p>
          <div class="prefecture-block" style="margin-top: 8px;">
            <table>
              <thead>
                <tr><th>Sous-préfecture</th><th>2025</th></tr>
              </thead>
              <tbody>
                {[...place.sous_prefectures]
                  .sort((a: any, b: any) => b.pop_2025 - a.pop_2025)
                  .map((sp: any) => (
                    <tr>
                      <td>{sp.name_fr}</td>
                      <td>{fmt(sp.pop_2025)}</td>
                    </tr>
                  ))}
              </tbody>
            </table>
          </div>
        </details>
      )}

      {comparisonRows.length > 0 && (
        <>
          <h2>Comparaison régionale</h2>
          <p class="headline-caption">Population 2021, {place.name_fr} et les autres préfectures de la région {place.region_name}.</p>
          <div style="margin-top: 12px;">
            {comparisonRows.map((r) => (
              <div class="comparison-row">
                <span class={`comparison-label ${r.isSelf ? "isSelf" : ""}`}>{r.name_fr}</span>
                <div class="comparison-bar-track">
                  <div
                    class={`comparison-bar-fill ${r.isSelf ? "isSelf" : ""}`}
                    style={`width: ${(r.pop_2021 / maxComparisonPop * 100).toFixed(1)}%`}
                  ></div>
                </div>
                <span class="comparison-value">{fmt(r.pop_2021)}</span>
              </div>
            ))}
          </div>
        </>
      )}

      {nationalComparisonRows.length > 0 && (
        <>
          <h2>Comparaison nationale</h2>
          <p class="headline-caption">
            Population 2021 de {place.name_fr}, contre la moyenne nationale par préfecture
            (population nationale 2021 divisée par {place.population.total_prefectures}) -
            {" "}{place.name_fr} compte {nationalRatio.toFixed(1)}× cette moyenne.
          </p>
          <div style="margin-top: 12px;">
            {nationalComparisonRows.map((r) => (
              <div class="comparison-row">
                <span class={`comparison-label ${r.isSelf ? "isSelf" : ""}`}>{r.name_fr}</span>
                <div class="comparison-bar-track">
                  <div
                    class={`comparison-bar-fill ${r.isSelf ? "isSelf" : ""}`}
                    style={`width: ${(r.pop_2021 / maxNationalComparisonPop * 100).toFixed(1)}%`}
                  ></div>
                </div>
                <span class="comparison-value">{fmt(r.pop_2021)}</span>
              </div>
            ))}
          </div>
        </>
      )}

      {place.markets.length > 0 && (
        <>
          <h2>Prix au marché</h2>
          <p class="headline-caption">
            Dernier prix connu, par marché - francs CFA (manioc, riz, maïs et bœuf au kilogramme ; huile de palme au litre).
          </p>
          <div class="prefecture-block">
            <table>
              <thead>
                <tr>
                  <th>Marché</th>
                  {DENREE_ORDER.map((id) => <th>{DENREE_SHORT[id]}</th>)}
                </tr>
              </thead>
              <tbody>
                {place.markets.map((m: any) => (
                  <tr>
                    <td>{m.name_fr.replace("Marché de ", "")}</td>
                    {DENREE_ORDER.map((id) =>
                      m.prices[id]
                        ? <td>{fmtPrice(m.prices[id].value)}</td>
                        : <td style="color: var(--ink-faint);">-</td>
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="headline-caption" style="margin-top: 8px;">
            Détail national et évolution dans le temps : <a href="/prix/">page Prix</a>.
          </p>
        </>
      )}

      {place.sante_region && (
        <>
          <h2>Santé<span class="level-tag" style="margin-left: 8px;">niveau régional</span></h2>
          <p class="headline-caption">
            {place.name_fr} fait partie de la région {place.sante_region.region_name}, qui comptait{" "}
            {fmt(place.sante_region.value)} établissements de santé en {place.sante_region.period}
            (registre gouvernemental) - ce chiffre couvre toute la région, pas seulement cette préfecture ;
            aucune source consultée ne descend jusqu'au niveau préfecture pour ce thème.
          </p>
          <p class="headline-caption" style="margin-top: 8px;">
            Détail national et deuxième source : <a href="/sante/">page Santé</a>.
          </p>
        </>
      )}

      <h2>Ce que l'on sait, par thème</h2>
      <table class="freshness-table">
        <thead><tr><th>Thème</th><th>Donnée la plus récente</th></tr></thead>
        <tbody>
          {place.freshness.map((f: any) => (
            <tr>
              <td>{f.theme}</td>
              <td class={f.available ? "yes" : "no"}>
                {f.available
                  ? (f.level === "region"
                      ? `${f.period} (niveau régional)`
                      : f.level === "sous_prefecture"
                        ? `${f.period} (jusqu'à la sous-préfecture)`
                        : f.period)
                  : "aucune donnée à ce niveau"}
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      <h2>Ce qui n'est pas encore là</h2>
      <ul class="not-measured">
        <li>Carte de localisation : pas encore construite pour les pages de lieux - nécessite une nouvelle étape de génération de cartes (geo/mapshaper), distincte de ce lot de travail.</li>
        <li>Sous-préfectures de {place.name_fr} : leur population 2025 est listée ci-dessus, mais elles n'ont pas encore chacune leur propre page - viendra dans un lot ultérieur (Phase 4, étape suivante).</li>
        <li>Santé n'est connue qu'au niveau régional ici, pas préfecture - voir la section ci-dessus.</li>
        <li>Infrastructures, éducation, économie et agriculture : ces thèmes n'ont pour l'instant que des chiffres nationaux, aucune source consultée ne descend en dessous - voir <a href="/methode/">Méthode</a>.</li>
        <li>Téléchargement dédié à ce lieu (CSV, GeoJSON) : pas encore disponible - voir <a href="/donnees/">Données</a> pour l'export complet en attendant.</li>
      </ul>

      <footer>
        Données : voir chaque thème pour le détail des sources. Crosswalk géographique : <a href="/methode/">Méthode</a>.
        <nav class="site-nav">
          <a href="/population/">Population</a>
          <a href="/infrastructures/">Infrastructures</a>
          <a href="/education/">Éducation</a>
          <a href="/sante/">Santé</a>
          <a href="/economie/">Économie</a>
          <a href="/sources/">Sources</a>
          <a href="/methode/">Méthode</a>
          <a href="/donnees/">Données</a>
          <a href="/a-propos/">À propos</a>
        </nav>
      </footer>
    </main>
  </body>
</html>
