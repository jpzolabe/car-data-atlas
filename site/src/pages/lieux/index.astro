---
// Index for Phase 4's place pages - lists all 20 préfectures grouped by
// région, each linking to /lieux/prefecture/{slug}. Without this page the
// place pages built by [slug].astro would be orphaned (reachable only by
// guessing a URL or via search).
import lieux from "../../data/lieux_prefectures.json";
import ThemeInit from "../../components/ThemeInit.astro";
import SiteNav from "../../components/SiteNav.astro";

const places = Object.values(lieux) as any[];

const byRegion = new Map<string, any[]>();
for (const p of places) {
  if (!byRegion.has(p.region_name)) byRegion.set(p.region_name, []);
  byRegion.get(p.region_name)!.push(p);
}
for (const list of byRegion.values()) {
  list.sort((a, b) => a.name_fr.localeCompare(b.name_fr, "fr"));
}
const regions = [...byRegion.keys()].sort();

// Same région accents as population.astro, kept distinct so a reader moving
// between the two pages sees the same région = same color.
const REGION_COLORS: Record<string, string> = {
  "Plateaux": "#B33A5B",
  "Équateur": "#2E7D5B",
  "Yadé": "#6B4A9E",
  "Kaga": "#C2571F",
  "Fertit": "#1C7A9C",
  "Haut-Oubangui": "#8A6B1F",
  "Bas-Oubangui": "#5A6259",
};

const fmt = (n: number) => Math.round(n).toLocaleString("fr-FR");
---
<!doctype html>
<html lang="fr">
  <head>
    <ThemeInit />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Lieux - BeAfrika Data</title>
    <style>
      :root {
        --paper: #EDEEE6; --surface: #F8F8F2; --ink: #1B2420; --ink-muted: #5A6259;
        --ink-faint: #8B9188; --line: #D6D7C9;
        --t-lieu: #8B5E3C;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --paper: #171912; --surface: #1F221A; --ink: #E8E6DA; --ink-muted: #A6A895;
          --ink-faint: #6E7161; --line: #33362A;
          --t-lieu: #D4A574;
        }
      }
      :root[data-theme="dark"] {
        --paper: #171912; --surface: #1F221A; --ink: #E8E6DA; --ink-muted: #A6A895;
        --ink-faint: #6E7161; --line: #33362A;
        --t-lieu: #D4A574;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background-color: var(--paper);
        background-image:
          radial-gradient(1000px 520px at 10% -10%, color-mix(in srgb, var(--t-lieu) 9%, transparent), transparent 60%),
          radial-gradient(700px 420px at 100% 100%, color-mix(in srgb, var(--t-lieu) 6%, transparent), transparent 60%);
        background-attachment: fixed;
        color: var(--ink); font-family: system-ui, sans-serif; font-size: 15px; line-height: 1.5;
      }
      main { max-width: 1080px; margin: 0 auto; padding: 84px 24px 80px; }
      .crumb { font-family: ui-monospace, monospace; font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--ink-faint); margin-bottom: 6px; }
      .crumb a { color: var(--ink-faint); text-decoration: none; }
      .crumb a:hover { color: var(--t-lieu); text-decoration: underline; }
      h1 {
        font-size: 1.8rem; margin: 0 0 8px; display: inline-block;
        border-bottom: 3px solid var(--t-lieu); padding-bottom: 4px;
      }
      .lede { color: var(--ink-muted); max-width: 62ch; margin: 12px 0 24px; }
      .region-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-top: 8px; }
      .region-block {
        background: var(--surface); border: 1px solid var(--line);
        border-left: 3px solid var(--region-accent, var(--ink-faint)); border-radius: 3px;
        padding: 14px 16px;
      }
      .region-block h2 {
        font-size: 12.5px; text-transform: uppercase; letter-spacing: 0.04em;
        color: var(--region-accent, var(--ink)); margin: 0 0 10px; font-weight: 600;
        display: flex; align-items: center; gap: 6px;
      }
      .region-dot { width: 7px; height: 7px; border-radius: 50%; flex: none; background: var(--region-accent, var(--ink-faint)); }
      .place-list { list-style: none; margin: 0; padding: 0; }
      .place-list li { border-top: 1px solid var(--line); }
      .place-list li:first-child { border-top: none; }
      .place-list a {
        display: flex; justify-content: space-between; align-items: baseline;
        padding: 8px 0; color: var(--ink); text-decoration: none; font-size: 14px;
      }
      .place-list a:hover { color: var(--t-lieu); }
      .place-list .pop {
        font-family: ui-monospace, monospace; font-size: 12px; color: var(--ink-faint);
        font-variant-numeric: tabular-nums;
      }
      footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 12px; color: var(--ink-faint); }
      footer a { color: var(--ink-muted); }
      .site-nav { display: flex; gap: 14px; margin-top: 14px; flex-wrap: wrap; }
      .site-nav a { color: var(--t-lieu); font-size: 12.5px; transition: opacity 0.15s ease; }
      .site-nav a:hover { opacity: 0.7; }
    </style>
  </head>
  <body>
    <SiteNav />
    <main>
      <div class="crumb"><a href="/">République centrafricaine</a></div>
      <h1>Lieux</h1>
      <p class="lede">
        Les 20 préfectures, regroupées par région. Chaque page rassemble ce que
        l'on sait d'un lieu, tous thèmes confondus - et dit explicitement ce
        qui n'est pas encore mesuré à ce niveau.
      </p>

      <div class="region-grid">
        {regions.map((region) => (
          <div class="region-block" style={`--region-accent: ${REGION_COLORS[region] ?? "var(--ink-faint)"}`}>
            <h2><span class="region-dot"></span>{region}</h2>
            <ul class="place-list">
              {byRegion.get(region)!.map((p) => (
                <li>
                  <a href={`/lieux/prefecture/${p.slug}/`}>
                    <span>{p.name_fr}</span>
                    {p.population && <span class="pop">{fmt(p.population.pop_2021)} hab.</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <footer>
        Découpage administratif : COD-AB v02 (OCHA), 20 préfectures / 85 sous-préfectures.
        Voir <a href="/methode/">Méthode</a> pour le détail du crosswalk géographique.
        <nav class="site-nav">
          <a href="/population/">Population</a>
          <a href="/infrastructures/">Infrastructures</a>
          <a href="/education/">Éducation</a>
          <a href="/sante/">Santé</a>
          <a href="/economie/">Économie</a>
          <a href="/sources/">Sources</a>
          <a href="/methode/">Méthode</a>
          <a href="/donnees/">Données</a>
          <a href="/a-propos/">À propos</a>
        </nav>
      </footer>
    </main>
  </body>
</html>
