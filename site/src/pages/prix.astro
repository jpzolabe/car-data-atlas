---
// Second real content page. Chart geometry is computed here, at build time,
// from the JSON pipeline/export_prix_json.py materializes - no chart library
// ships to the client (CLAUDE.md's non-negotiable). See docs/decisions.md for
// why this is hand-computed rather than Observable Plot for now.
import data from "../data/prix.json";
import ThemeInit from "../components/ThemeInit.astro";
import SiteNav from "../components/SiteNav.astro";

const series = data.series;
const values = series.map((d) => d.value);
const min = Math.min(...values);
const max = Math.max(...values);

const W = 1000, H = 300, marginL = 50, marginR = 20, marginT = 20, marginB = 34;
const plotW = W - marginL - marginR;
const plotH = H - marginT - marginB;

const x = (i: number) => marginL + (i / (series.length - 1)) * plotW;
const y = (v: number) => marginT + plotH - ((v - min) / (max - min)) * plotH;

const points = series.map((d, i) => `${x(i).toFixed(1)},${y(d.value).toFixed(1)}`).join(" ");

// index of the last reconciled month (base-change boundary, Dec 2019 -> Jan 2020)
const boundaryIndex = series.findIndex((d) => !d.reconciled) - 1;
const boundaryX = boundaryIndex >= 0 ? x(boundaryIndex) : null;

// y-axis ticks: min, mid, max
const ticks = [min, (min + max) / 2, max];

// x-axis labels: January of each year present
const yearLabels = series
  .map((d, i) => ({ i, year: d.period.slice(0, 4), month: d.period.slice(5, 7) }))
  .filter((d) => d.month === "01");

const latest = series[series.length - 1];
const fmt = (n: number) => n.toLocaleString("fr-FR", { maximumFractionDigits: 1 });

const inflationLatest = data.inflation.latest;

// Short column headers for the by-préfecture breakdown table - full names
// (data.market.breakdown_labels) are too wide for a table column.
const DENREE_SHORT: Record<string, string> = {
  prix_manioc_kg: "Manioc",
  prix_riz_kg: "Riz",
  prix_mais_kg: "Maïs",
  prix_boeuf_kg: "Bœuf",
  prix_huile_palme_l: "Huile",
};
const DENREE_ORDER = Object.keys(DENREE_SHORT);

// Small build-time SVG sparkline for the "Par fonction" breakdown cards --
// same technique as education.astro's, duplicated rather than shared, per
// this project's one-file-per-page convention (no component library).
const SPARK_W = 460, SPARK_H = 90, SPARK_ML = 40, SPARK_MR = 10, SPARK_MT = 10, SPARK_MB = 18;
function sparkline(cat: { series: { period: string; value: number }[] }) {
  const s = cat.series;
  const plotW = SPARK_W - SPARK_ML - SPARK_MR;
  const plotH = SPARK_H - SPARK_MT - SPARK_MB;
  const values = s.map((d) => d.value);
  const sMin = Math.min(...values);
  const sMax = Math.max(...values);
  const x = (i: number) => SPARK_ML + (i / Math.max(s.length - 1, 1)) * plotW;
  const y = (v: number) => SPARK_MT + plotH - ((v - sMin) / (sMax - sMin)) * plotH;
  const points = s.map((d, i) => `${x(i).toFixed(1)},${y(d.value).toFixed(1)}`).join(" ");
  return {
    points, sMin, sMax, yMin: y(sMin), yMax: y(sMax),
    firstYear: s[0].period.slice(0, 4), lastYear: s[s.length - 1].period.slice(0, 4),
    xFirst: x(0), xLast: x(s.length - 1),
  };
}
---
<!doctype html>
<html lang="fr">
  <head>
    <ThemeInit />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Indice des prix à la consommation - BêAfrîka Data</title>
    <style>
      :root {
        --paper: #23251F; --surface: #2B2E27; --ink: #E8E6DA; --ink-muted: #A6A895;
        --ink-faint: #8C8F7F; --line: #33362A; --indigo: #6FA0E8;
        --t-prix: #B9CC4A;
        --ochre: #E0A83D; --ochre-soft: #3A2E12;
      }
      :root[data-theme="light"] {
        --paper: #EDEEE6; --surface: #F8F8F2; --ink: #1B2420; --ink-muted: #5A6259;
        --ink-faint: #8B9188; --line: #D6D7C9; --indigo: #2A56A8;
        --t-prix: #71811A;
        --ochre: #B8790F; --ochre-soft: #F1E3C6;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background-color: var(--paper);
        background-image:
          radial-gradient(1000px 520px at 10% -10%, color-mix(in srgb, var(--t-prix) 10%, transparent), transparent 60%),
          radial-gradient(700px 420px at 100% 100%, color-mix(in srgb, var(--t-prix) 6%, transparent), transparent 60%);
        background-attachment: fixed;
        color: var(--ink); font-family: system-ui, sans-serif; font-size: 15px; line-height: 1.5;
      }
      main { max-width: 1080px; margin: 0 auto; padding: 84px 24px 80px; }
      .crumb { font-family: ui-monospace, monospace; font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--ink-faint); margin-bottom: 6px; }
      .crumb a { color: var(--ink-faint); text-decoration: none; }
      .crumb a:hover { color: var(--t-prix); text-decoration: underline; }
      h1 {
        font-size: 1.8rem; margin: 0 0 8px; display: inline-block;
        border-bottom: 3px solid var(--t-prix); padding-bottom: 4px;
      }
      .lede { color: var(--ink-muted); max-width: 60ch; margin: 12px 0 20px; }
      .headline { font-family: ui-monospace, monospace; font-size: 2rem; margin: 0; color: var(--t-prix); }
      .headline .unit { font-size: 0.9rem; color: var(--ink-faint); font-family: system-ui, sans-serif; margin-left: 6px; }
      .headline-meta { color: var(--ink-faint); font-size: 12px; margin: 4px 0 8px; }
      .inflation-stat { font-size: 14px; color: var(--ink); margin: 0 0 20px; }
      .inflation-note { color: var(--ink-faint); font-size: 12px; }
      h2 { font-size: 1.15rem; margin: 36px 0 10px; padding-top: 16px; border-top: 1px solid var(--line); }
      .category-grid-note { font-size: 13px; color: var(--ink-muted); margin: 0 0 16px; }
      .category-grid {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(min(440px, 100%), 1fr));
        gap: 22px;
      }
      .category-card {
        background: var(--surface); border: 1px solid var(--line); border-radius: 3px;
        padding: 16px 18px;
      }
      .category-card .cat-name { font-size: 1rem; font-weight: 600; margin: 0 0 4px; }
      .category-card .cat-definition { font-size: 12.5px; color: var(--ink-muted); line-height: 1.5; margin: 0 0 8px; }
      .category-card .cat-value {
        font-family: ui-monospace, monospace; font-size: 1.5rem; font-weight: 600;
        color: var(--t-prix);
      }
      .category-card .cat-value .unit { font-size: 0.8rem; color: var(--ink-faint); font-family: system-ui, sans-serif; font-weight: 400; }
      svg.cat-sparkline { width: 100%; height: auto; display: block; margin-top: 8px; }
      .cat-spark-line {
        stroke: var(--t-prix); stroke-width: 2; fill: none;
        stroke-dasharray: 2000; stroke-dashoffset: 2000;
        animation: drawSpark 1.1s ease-out forwards;
      }
      @keyframes drawSpark { to { stroke-dashoffset: 0; } }
      @media (prefers-reduced-motion: reduce) { .cat-spark-line { animation: none; stroke-dashoffset: 0; } }
      .cat-spark-axis-label { fill: var(--ink-faint); font-size: 9px; font-family: ui-monospace, monospace; }
      .single-point-note {
        margin: 8px 0 0; padding: 8px 10px; font-size: 12px; color: var(--ink-faint);
        background: color-mix(in srgb, var(--t-prix) 6%, transparent);
        border-radius: 3px;
      }
      .cat-sentence { font-style: italic; font-size: 13px; color: var(--ink-muted); margin: 8px 0 0; }
      svg { width: 100%; height: auto; display: block; margin: 16px 0; }
      .gridline { stroke: var(--line); stroke-width: 1; }
      .axis-label { fill: var(--ink-faint); font-size: 10px; font-family: ui-monospace, monospace; }
      .line-reconciled { stroke: var(--ink-faint); stroke-width: 1.5; stroke-dasharray: 4 3; fill: none; }
      .line-published {
        stroke: var(--t-prix); stroke-width: 2.5; fill: none;
        stroke-dasharray: 4000; stroke-dashoffset: 4000;
        animation: drawLine 1.4s ease-out forwards;
      }
      .boundary { stroke: var(--ochre); stroke-width: 1; stroke-dasharray: 2 2; }
      .boundary-label { fill: var(--ochre); font-size: 10px; font-family: ui-monospace, monospace; }
      .chart-legend { display: flex; gap: 18px; font-family: ui-monospace, monospace; font-size: 10.5px; color: var(--ink-muted); margin-top: 4px; }
      .chart-legend span { display: inline-flex; align-items: center; gap: 5px; }
      .swatch { width: 14px; height: 2px; display: inline-block; }
      .gap-note { margin-top: 24px; font-style: italic; color: var(--ink-muted); font-size: 13.5px; border-left: 3px solid var(--ink-faint); padding-left: 12px; }
      .prefecture-grid {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 22px; margin: 8px 0 4px;
      }
      .prefecture-block {
        background: var(--surface); border: 1px solid var(--line); border-radius: 3px;
        padding: 12px 14px;
      }
      .prefecture-block h3 {
        font-size: 12.5px; text-transform: uppercase; letter-spacing: 0.04em;
        color: var(--t-prix); margin: 0 0 8px; font-weight: 600;
      }
      .prefecture-block table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
      .prefecture-block th { text-align: right; font-size: 10px; color: var(--ink-faint); font-weight: 400; padding: 0 0 4px 6px; }
      .prefecture-block th:first-child { text-align: left; padding-left: 0; }
      .prefecture-block td { text-align: right; padding: 3px 0 3px 6px; border-top: 1px solid var(--line); font-size: 12.5px; }
      .prefecture-block td:first-child { text-align: left; color: var(--ink-muted); }
      .prefecture-block td.missing { color: var(--ink-faint); }
      .sentence { font-style: italic; font-size: 17px; line-height: 1.5; color: var(--ink); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); border-left: 3px solid var(--t-prix); padding: 14px 0 14px 14px; margin: 20px 0; }
      footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 12px; color: var(--ink-faint); }
      footer a { color: var(--ink-muted); }
      .site-nav { display: flex; gap: 14px; margin-top: 14px; flex-wrap: wrap; }
      .site-nav a { color: var(--t-prix); font-size: 12.5px; transition: opacity 0.15s ease; }
      .site-nav a:hover { opacity: 0.7; }
      @keyframes drawLine { to { stroke-dashoffset: 0; } }
      @media (prefers-reduced-motion: reduce) {
        .line-published { animation: none; stroke-dashoffset: 0; }
      }
    </style>
  </head>
  <body>
    <SiteNav />
    <main>
      <div class="crumb"><a href="/">République centrafricaine</a></div>
      <h1>Indice des prix à la consommation</h1>
      <p class="lede">
        L'indice harmonisé des prix à la consommation (IHPC), toutes
        fonctions confondues, base 100 en 2019, en série mensuelle de
        janvier 2015 à {latest.period}. Plus bas, les prix réels de cinq
        denrées de grande consommation au marché de Bangui. Voir aussi
        <a href="/economie/">Économie</a>, où l'inflation est résumée aux
        côtés du PIB et des autres indicateurs macroéconomiques.
      </p>

      <p class="headline">{fmt(latest.value)}<span class="unit">indice, {latest.period}</span></p>
      <p class="headline-meta">{data.definition_fr}</p>
      <p class="headline-meta">Donnée la plus récente disponible dans la série ; pas nécessairement le mois en cours.</p>
      <p class="inflation-stat">
        Inflation publiée : <strong>{fmt(inflationLatest.value)}%</strong> ({inflationLatest.period})
        <span class="inflation-note">- chiffre publié par la source telle quelle ; voir la note ci-dessous.</span>
      </p>
      <p class="inflation-note">{data.inflation.definition_fr}</p>

      <p class="sentence">
        {data.lead_sentence}
      </p>

      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Indice des prix à la consommation de janvier 2015 à ${latest.period}`}>
        {ticks.map((t) => (
          <>
            <line class="gridline" x1={marginL} y1={y(t)} x2={W - marginR} y2={y(t)} />
            <text class="axis-label" x={marginL - 6} y={y(t) + 3} text-anchor="end">{fmt(t)}</text>
          </>
        ))}
        {yearLabels.map((d) => (
          <text class="axis-label" x={x(d.i)} y={H - marginB + 16} text-anchor="middle">{d.year}</text>
        ))}
        {boundaryX !== null && (
          <>
            <line class="boundary" x1={boundaryX} y1={marginT} x2={boundaryX} y2={H - marginB} />
            <text class="boundary-label" x={boundaryX + 4} y={marginT + 10}>changement de base</text>
          </>
        )}
        <polyline
          class="line-reconciled"
          points={series.slice(0, boundaryIndex + 2).map((d, i) => `${x(i).toFixed(1)},${y(d.value).toFixed(1)}`).join(" ")}
        />
        <polyline
          class="line-published"
          points={series.slice(boundaryIndex + 1).map((d, i) => `${x(i + boundaryIndex + 1).toFixed(1)},${y(d.value).toFixed(1)}`).join(" ")}
        />
      </svg>
      <div class="chart-legend">
        <span><span class="swatch" style="background:var(--ink-faint);border-top:1.5px dashed var(--ink-faint);height:0;"></span>reconcilié (base 1981 recalculée)</span>
        <span><span class="swatch" style="background:var(--t-prix);"></span>tel que publié (base 2019)</span>
      </div>

      <p class="gap-note">
        Les valeurs de janvier 2015 à décembre 2019 ont été recalculées sur la base
        2019 par la source elle-même, via un coefficient officiel - elles ne sont
        pas telles qu'originellement publiées. Voir
        <code>docs/verification-debt.md</code>. Le taux d'inflation ci-dessus est
        publié tel quel par la source : une recomputation glissement mensuel ou
        annuel à partir de l'indice global ne reproduit pas cette colonne, et sa
        méthodologie exacte n'est pas confirmée - voir
        <code>docs/verification-debt.md</code>.
      </p>

      <h2>Par fonction (COICOP)</h2>
      <p class="category-grid-note">
        3 des 12 fonctions de l'IHPC - les autres (habillement, logement,
        communications, loisirs, enseignement…) ne sont pas encore intégrées ;
        l'enseignement en particulier n'a que 76 des 136 mois renseignés dans
        le fichier source.
      </p>
      <div class="category-grid">
        {data.categories.map((cat) => {
          const spark = sparkline(cat);
          return (
            <div class="category-card">
              <p class="cat-name">{cat.name_fr}</p>
              <p class="cat-definition">{cat.definition_fr}</p>
              <p class="cat-value">{fmt(cat.latest.value)}<span class="unit"> indice, {cat.latest.period}</span></p>
              {cat.series.length > 1 ? (
                <svg class="cat-sparkline" viewBox={`0 0 ${SPARK_W} ${SPARK_H}`} role="img" aria-label={`${cat.name_fr}, ${spark.firstYear} à ${spark.lastYear}`}>
                  <polyline class="cat-spark-line" points={spark.points} />
                  <text class="cat-spark-axis-label" x={spark.xFirst} y={SPARK_H - 4} text-anchor="start">{spark.firstYear}</text>
                  <text class="cat-spark-axis-label" x={spark.xLast} y={SPARK_H - 4} text-anchor="end">{spark.lastYear}</text>
                </svg>
              ) : (
                <p class="single-point-note">Une seule mesure disponible ({cat.latest.period}) - pas d'évolution à montrer.</p>
              )}
              <p class="cat-sentence">{cat.lead_sentence}</p>
            </div>
          );
        })}
      </div>

      <h2>Denrées alimentaires au marché de Bangui</h2>
      <p class="category-grid-note">
        L'IHPC ci-dessus est un indice national. Ces 5 denrées sont des prix de
        détail réels, relevés au {data.market.entity_name} - le marché, un point
        précis et non une zone administrative, est le niveau géographique le
        plus fin que ce site couvre. Bangui a l'historique le plus complet
        (2004 à aujourd'hui) ; la section suivante compare le niveau actuel
        des prix à travers le pays. 34 autres denrées existent dans la même
        source mais ne sont pas encore intégrées.
      </p>
      <div class="category-grid">
        {data.market.denrees.map((d) => {
          const spark = sparkline(d);
          return (
            <div class="category-card">
              <p class="cat-name">{d.name_fr}</p>
              <p class="cat-definition">{d.definition_fr}</p>
              <p class="cat-value">{fmt(d.latest.value)}<span class="unit"> {d.unit}, {d.latest.period}</span></p>
              {d.series.length > 1 ? (
                <svg class="cat-sparkline" viewBox={`0 0 ${SPARK_W} ${SPARK_H}`} role="img" aria-label={`${d.name_fr}, ${spark.firstYear} à ${spark.lastYear}`}>
                  <polyline class="cat-spark-line" points={spark.points} />
                  <text class="cat-spark-axis-label" x={spark.xFirst} y={SPARK_H - 4} text-anchor="start">{spark.firstYear}</text>
                  <text class="cat-spark-axis-label" x={spark.xLast} y={SPARK_H - 4} text-anchor="end">{spark.lastYear}</text>
                </svg>
              ) : (
                <p class="single-point-note">Une seule mesure disponible ({d.latest.period}) - pas d'évolution à montrer.</p>
              )}
              <p class="cat-sentence">{d.lead_sentence}</p>
            </div>
          );
        })}
      </div>
      <p class="gap-note">
        Source distincte de l'IHPC ci-dessus : {data.market.source.producer} -
        {" "}{data.market.source.dataset_name}. Récupéré le {data.market.source.retrieved_at}.
      </p>

      <h2>Prix par préfecture</h2>
      <p class="category-grid-note">
        Dernier prix connu pour chaque denrée, marché par marché, groupé par
        préfecture - 34 marchés dans 16 des 20 préfectures. Bangui a en plus
        son historique complet ci-dessus ; ici, c'est le niveau actuel des
        prix qui compte, pas la tendance dans le temps. Une case vide
        signifie qu'aucun prix récent n'existe pour cette denrée à ce
        marché, pas un prix nul.
      </p>
      <div class="prefecture-grid">
        {data.market.breakdown.map((pref) => (
          <div class="prefecture-block">
            <h3>{pref.name_fr}</h3>
            <table>
              <thead>
                <tr>
                  <th>Marché</th>
                  {DENREE_ORDER.map((id) => <th>{DENREE_SHORT[id]}</th>)}
                </tr>
              </thead>
              <tbody>
                {pref.markets.map((m) => (
                  <tr>
                    <td>{m.name_fr.replace("Marché de ", "")}</td>
                    {DENREE_ORDER.map((id) =>
                      m.prices[id]
                        ? <td>{fmt(m.prices[id].value)}</td>
                        : <td class="missing">-</td>
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}
      </div>
      <p class="gap-note">
        Prix en francs CFA (manioc, riz, maïs et bœuf au kilogramme ; huile
        de palme au litre). 4 préfectures n'ont aucun marché avec des
        données récentes dans cette source : Basse-Kotto, Lim-Pendé,
        Mambéré et Ouham-Fafa.
      </p>

      <footer>
        Source : {data.source.producer} - {data.source.dataset_name}.
        Récupéré le {data.source.retrieved_at}.
        <a href={data.source.url}>{data.source.url}</a>
        <nav class="site-nav">
          <a href="/population/">Population</a>
          <a href="/infrastructures/">Infrastructures</a>
          <a href="/education/">Éducation</a>
          <a href="/sante/">Santé</a>
          <a href="/economie/">Économie</a>
          <a href="/sources/">Sources</a>
          <a href="/methode/">Méthode</a>
          <a href="/donnees/">Données</a>
          <a href="/a-propos/">À propos</a>
        </nav>
      </footer>
    </main>
  </body>
</html>
