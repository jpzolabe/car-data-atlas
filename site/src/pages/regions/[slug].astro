---
// Région pages - the admin level between pays and préfecture (7 régions,
// each covering several préfectures) that had entities.csv rows and
// site-wide grouping (prefectures/index.astro, each préfecture's
// region_name) but no page or URL of its own until an external UX review
// flagged it as the one tier in the hierarchy present in the data but
// absent from the site. Generated from site/src/data/lieux_regions.json
// (pipeline/export_lieux_regions_json.py).
//
// Région isn't an observed entity for most indicators - population here
// is a sum of its préfectures' own figures (same idea as a préfecture's
// pop_2025 being a sum of its sous-préfectures), labelled as such rather
// than presented as a directly published régional figure. Santé
// (nombre_etablissements_sante) is the one indicator genuinely observed
// at région level - this page is its canonical home; each préfecture
// page still shows its own région's figure too, since that remains the
// finest depth available for santé at that préfecture.
import lieuxRegions from "../../data/lieux_regions.json";
import ThemeInit from "../../components/ThemeInit.astro";
import SiteNav from "../../components/SiteNav.astro";

export function getStaticPaths() {
  return Object.values(lieuxRegions).map((r: any) => ({
    params: { slug: r.slug },
    props: { region: r },
  }));
}

const { region } = Astro.props;

const fmt = (n: number) => Math.round(n).toLocaleString("fr-FR");
const fmt1 = (n: number) => n.toLocaleString("fr-FR", { maximumFractionDigits: 1 });

const maxPrefecturePop = Math.max(1, ...region.prefectures.map((p: any) => p.pop_2021 || 0));

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://beafrikadata.com/" },
    { "@type": "ListItem", "position": 2, "name": "Préfectures", "item": "https://beafrikadata.com/prefectures/" },
    { "@type": "ListItem", "position": 3, "name": region.name_fr, "item": `https://beafrikadata.com/regions/${region.slug}/` },
  ],
};
---
<!doctype html>
<html lang="fr">
  <head>
    <ThemeInit />
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Région {region.name_fr} - BêAfrîka Data</title>
    <meta name="description" content={`Les préfectures de la région ${region.name_fr}, leur population et la santé au niveau régional, République centrafricaine.`} />
    <link rel="canonical" href={`https://beafrikadata.com/regions/${region.slug}/`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BêAfrîka Data" />
    <meta property="og:title" content={`Région ${region.name_fr} - BêAfrîka Data`} />
    <meta property="og:description" content={`Les préfectures de la région ${region.name_fr}, leur population et la santé au niveau régional, République centrafricaine.`} />
    <meta property="og:url" content={`https://beafrikadata.com/regions/${region.slug}/`} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`Région ${region.name_fr} - BêAfrîka Data`} />
    <meta name="twitter:description" content={`Les préfectures de la région ${region.name_fr}, leur population et la santé au niveau régional, République centrafricaine.`} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <style>
      :root {
        --paper: #23251F; --surface: #2B2E27; --ink: #E8E6DA; --ink-muted: #A6A895;
        --ink-faint: #8C8F7F; --line: #33362A;
        --t-lieu: #D4A574;
        --ochre: #E0A83D; --ochre-soft: #3A2E12;
      }
      :root[data-theme="light"] {
        --paper: #EDEEE6; --surface: #F8F8F2; --ink: #1B2420; --ink-muted: #5A6259;
        --ink-faint: #8B9188; --line: #D6D7C9;
        --t-lieu: #8B5E3C;
        --ochre: #8C5A0C; --ochre-soft: #F1E3C6;
      }
      @media print {
        :root {
          --paper: #EDEEE6; --surface: #F8F8F2; --ink: #1B2420; --ink-muted: #5A6259;
          --ink-faint: #8B9188; --line: #D6D7C9;
          --t-lieu: #8B5E3C;
          --ochre: #8C5A0C; --ochre-soft: #F1E3C6;
        }
        body { background: #fff !important; background-image: none !important; }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background-color: var(--paper);
        background-image:
          radial-gradient(1000px 520px at 10% -10%, color-mix(in srgb, var(--t-lieu) 9%, transparent), transparent 60%),
          radial-gradient(700px 420px at 100% 100%, color-mix(in srgb, var(--t-lieu) 6%, transparent), transparent 60%);
        background-attachment: fixed;
        color: var(--ink); font-family: system-ui, sans-serif; font-size: 15px; line-height: 1.5;
      }
      main { max-width: 1080px; margin: 0 auto; padding: 84px 24px 80px; }
      .crumb { font-family: ui-monospace, monospace; font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--ink-faint); margin-bottom: 6px; }
      .crumb a { color: var(--ink-faint); text-decoration: none; }
      .crumb a:hover { color: var(--t-lieu); text-decoration: underline; }
      h1 {
        font-size: 1.8rem; margin: 0 0 4px; display: inline-block;
        border-bottom: 3px solid var(--t-lieu); padding-bottom: 4px;
      }
      .level-tag {
        display: inline-block; font-family: ui-monospace, monospace; font-size: 11px;
        text-transform: uppercase; letter-spacing: 0.04em; color: var(--t-lieu);
        background: color-mix(in srgb, var(--t-lieu) 12%, var(--surface));
        padding: 2px 8px; border-radius: 2px; margin-left: 10px; vertical-align: middle;
      }
      .identity-block {
        margin: 17px 0 31px; padding: 15px 19px; background: var(--surface);
        border: 1px solid var(--line); border-left: 3px solid var(--t-lieu); border-radius: 3px;
        font-size: 13.5px; color: var(--ink-muted);
      }
      .identity-block dl { display: grid; grid-template-columns: max-content 1fr; gap: 4px 12px; margin: 0; }
      .identity-block dt { color: var(--ink-faint); font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.03em; padding-top: 2px; }
      .identity-block dd { margin: 0; }
      .headline-block {
        margin: 0 0 35px; padding: 23px 25px; background: var(--surface);
        border: 1px solid var(--line); border-left: 4px solid var(--t-lieu); border-radius: 3px;
      }
      .headline-value {
        font-family: ui-monospace, monospace; font-size: 2.6rem; font-weight: 600;
        color: var(--t-lieu); display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
      }
      .headline-value .unit { font-size: 1.1rem; color: var(--ink-faint); font-family: system-ui, sans-serif; margin-left: 6px; }
      .headline-caption { color: var(--ink-muted); font-size: 13.5px; margin: 4px 0 0; }
      h2 { font-size: 1.15rem; margin: 43px 0 13px; padding-top: 19px; border-top: 1px solid var(--line); }
      .prefecture-list { margin-top: 8px; display: flex; flex-direction: column; gap: 6px; }
      .prefecture-row { display: flex; align-items: center; gap: 10px; }
      .prefecture-row a { color: var(--ink); text-decoration: none; width: 150px; flex: none; font-size: 13.5px; }
      .prefecture-row a:hover { color: var(--t-lieu); text-decoration: underline; }
      .prefecture-bar-track { flex: 1; background: var(--line); border-radius: 2px; height: 18px; overflow: hidden; }
      .prefecture-bar-fill { height: 100%; background: var(--t-lieu); border-radius: 2px 0 0 2px; }
      .prefecture-value { width: 90px; flex: none; text-align: right; font-family: ui-monospace, monospace; font-size: 12.5px; color: var(--ink-muted); }
      .not-measured { margin: 14px 0 0; padding-left: 20px; color: var(--ink-muted); font-size: 14px; line-height: 1.7; }
      .not-measured li { margin-bottom: 4px; }
      footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 12px; color: var(--ink-faint); }
      footer a { color: var(--ink-muted); }
      .site-nav { display: flex; gap: 14px; margin-top: 14px; flex-wrap: wrap; }
      .site-nav a { color: var(--t-lieu); font-size: 12.5px; transition: opacity 0.15s ease; }
      .site-nav a:hover { opacity: 0.7; }
      a:focus-visible, summary:focus-visible, button:focus-visible {
        outline: 2px solid var(--ink-faint); outline-offset: 2px; border-radius: 2px;
      }
    </style>
  </head>
  <body>
    <SiteNav />
    <main id="main-content" data-pagefind-filter="theme:Préfectures">
      <div class="crumb">
        <a href="/">Accueil</a> › <a href="/prefectures/">Préfectures</a> › {region.name_fr}
      </div>
      <h1>{region.name_fr} <span class="level-tag">région</span></h1>

      <div class="identity-block">
        <dl>
          {region.chef_lieu && (<><dt>Chef-lieu régional</dt><dd>{region.chef_lieu}</dd></>)}
          <dt>Préfectures</dt><dd>{region.prefectures.length}</dd>
        </dl>
      </div>

      {region.population && (
        <div class="headline-block">
          <div class="headline-value">
            {fmt(region.population.pop_2025_total || region.population.pop_2021_total)}
            <span class="unit">habitants, {region.population.pop_2025_total ? "2025 (somme des préfectures, projection)" : "2021 (somme des préfectures, estimation)"}</span>
          </div>
          <p class="headline-caption">
            {fmt1(region.population.share_of_national_pct)}% de la population nationale, répartie sur {region.prefectures.length} préfectures.
          </p>
        </div>
      )}

      <h2>Préfectures de la région</h2>
      <div class="prefecture-list">
        {region.prefectures.map((p: any) => (
          <div class="prefecture-row">
            <a href={`/prefectures/${p.slug}/`}>{p.name_fr}</a>
            <div class="prefecture-bar-track">
              <div class="prefecture-bar-fill" style={`width: ${p.pop_2021 ? (p.pop_2021 / maxPrefecturePop * 100).toFixed(1) : 0}%`}></div>
            </div>
            <span class="prefecture-value">{p.pop_2021 ? `${fmt(p.pop_2021)} hab.` : "n/d"}</span>
          </div>
        ))}
      </div>

      {region.sante && (
        <>
          <h2>Santé <span class="level-tag" style="margin-left: 8px;">niveau régional</span></h2>
          <p class="headline-caption">
            La région {region.name_fr} comptait {fmt(region.sante.value)} établissements de santé en {region.sante.period}
            (registre gouvernemental) - ce chiffre couvre toute la région, pas une préfecture en particulier ;
            aucune source consultée ne descend jusqu'au niveau préfecture pour ce thème.
          </p>
          <p class="headline-caption" style="margin-top: 8px;">
            Détail national et deuxième source : <a href="/sante/">page Santé</a>.
          </p>
        </>
      )}

      <h2>Ce qui n'est pas encore là</h2>
      <ul class="not-measured">
        <li>Infrastructures, éducation, économie et agriculture : ces thèmes n'ont pour l'instant que des chiffres nationaux, aucune source consultée ne descend en dessous - voir <a href="/methode/">Méthode</a>.</li>
        <li>Prix alimentaires : suivis au marché, pas à la région - voir chaque page de préfecture.</li>
        <li>Téléchargement dédié à cette région (CSV, GeoJSON) : pas encore disponible - voir <a href="/donnees/">Données</a> pour l'export complet en attendant.</li>
      </ul>

      <footer>
        Données : voir chaque thème pour le détail des sources. Crosswalk géographique : <a href="/methode/">Méthode</a>.
        <nav class="site-nav">
          <a href="/population/">Population</a>
          <a href="/infrastructures/">Infrastructures</a>
          <a href="/education/">Éducation</a>
          <a href="/sante/">Santé</a>
          <a href="/economie/">Économie</a>
          <a href="/agriculture/">Agriculture</a>
          <a href="/prix/">Prix</a>
          <a href="/prefectures/">Préfectures</a>
          <a href="/sources/">Sources</a>
          <a href="/methode/">Méthode</a>
          <a href="/donnees/">Données</a>
          <a href="/contact/">Contact</a>
        </nav>
        <svg class="footer-flag" viewBox="0 0 900 600" width="24" height="16" role="img" aria-label="Drapeau de la République centrafricaine" style="display:block;margin-top:14px;">
          <rect width="900" height="150" fill="#003082"/>
          <rect y="150" width="900" height="150" fill="#FFFFFF"/>
          <rect y="300" width="900" height="150" fill="#009739"/>
          <rect y="450" width="900" height="150" fill="#FFD100"/>
          <rect x="375" width="150" height="600" fill="#CE1126"/>
          <path fill="#FFD100" d="M187.5,20 L199.8,58 L239.8,58 L207.5,81.5 L219.8,119.5 L187.5,96 L155.2,119.5 L167.5,81.5 L135.2,58 L175.2,58 Z"/>
        </svg>
      </footer>
    </main>
  </body>
</html>
