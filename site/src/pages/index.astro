---
// Still a placeholder, not the real home page from docs/plan.md §2.2 (that
// needs the headline-card/lead-story/theme-grid structure once more than two
// indicators exist) - but it now links everywhere real and carries the
// search box, which docs/plan.md calls "the primary navigation, not the
// menu." Search only works after a full `pnpm build` (Pagefind indexes the
// built dist/ output) - it's inert during `astro dev`. This is the one page
// that carries any client JS at all, per CLAUDE.md's explicit exception.
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Données RCA</title>
    <style>
      :root {
        --paper: #EDEEE6;
        --ink: #1B2420;
        --ink-muted: #5A6259;
        --ink-faint: #8B9188;
        --indigo: #2A56A8;
        --line: #D6D7C9;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background-color: var(--paper);
        background-image:
          radial-gradient(1100px 600px at 15% -10%, color-mix(in srgb, var(--indigo) 10%, transparent), transparent 60%),
          radial-gradient(900px 500px at 100% 100%, color-mix(in srgb, var(--indigo) 7%, transparent), transparent 60%);
        background-attachment: fixed;
        color: var(--ink);
        font-family: system-ui, sans-serif;
        display: flex;
        min-height: 100vh;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }
      main {
        max-width: 46ch;
        text-align: center;
      }
      h1 {
        font-size: 1.75rem;
        margin: 0 0 12px;
      }
      p {
        color: var(--ink-muted);
        line-height: 1.5;
        margin: 0;
      }
      .status {
        margin-top: 24px;
        font-family: ui-monospace, monospace;
        font-size: 0.75rem;
        color: var(--indigo);
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }
      #search {
        margin-top: 28px;
        text-align: left;
      }
      #search input {
        width: 100%;
        font: inherit;
        font-size: 0.95rem;
        padding: 10px 12px;
        border: 1px solid var(--line);
        border-radius: 3px;
        background: #F8F8F2;
        color: var(--ink);
      }
      #search input:focus {
        outline: 2px solid var(--indigo);
        outline-offset: 1px;
      }
      #search-results {
        list-style: none;
        margin: 10px 0 0;
        padding: 0;
      }
      #search-results li {
        border-top: 1px solid var(--line);
        padding: 10px 0;
      }
      #search-results a {
        color: var(--indigo);
        font-size: 0.9rem;
        text-decoration: none;
      }
      #search-results a:hover {
        text-decoration: underline;
      }
      #search-results .excerpt {
        display: block;
        color: var(--ink-muted);
        font-size: 0.8rem;
        margin-top: 3px;
      }
      #search-results .excerpt mark {
        background: none;
        color: var(--ink);
        font-weight: 600;
      }
      #search-status {
        font-family: ui-monospace, monospace;
        font-size: 0.7rem;
        color: var(--ink-faint);
        margin-top: 6px;
        display: block;
      }
      nav {
        margin-top: 24px;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 14px;
        padding-top: 16px;
        border-top: 1px solid var(--line);
      }
      nav a {
        color: var(--indigo);
        font-size: 0.85rem;
        transition: opacity 0.15s ease;
      }
      nav a:hover {
        opacity: 0.7;
      }
      nav a.secondary {
        color: var(--ink-faint);
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Données RCA</h1>
      <p>
        Explorer la République centrafricaine - ce que disent les données,
        d'où elles viennent, et ce que personne n'a encore mesuré.
      </p>
      <p class="status">En construction - 82 indicateurs pour l'instant</p>

      <div id="search">
        <input
          type="text"
          id="search-input"
          placeholder="Rechercher une préfecture, un indicateur…"
          autocomplete="off"
        />
        <span id="search-status"></span>
        <ul id="search-results"></ul>
      </div>

      <nav>
        <a href="/population/">Population par préfecture →</a>
        <a href="/infrastructures/">Infrastructures →</a>
        <a href="/education/">Éducation →</a>
        <a href="/sante/">Santé →</a>
        <a href="/economie/">Économie →</a>
        <a class="secondary" href="/sources/">Sources</a>
        <a class="secondary" href="/methode/">Méthode</a>
        <a class="secondary" href="/donnees/">Données</a>
        <a class="secondary" href="/a-propos/">À propos</a>
      </nav>
    </main>

    <script is:inline type="module">
      // Hand-built, not Pagefind's default UI bundle (~134 KB of JS/CSS for
      // widget chrome) - this site's page-weight budget is real, so search
      // uses the raw Pagefind API (~45 KB, loaded only on this page) plus a
      // few lines of vanilla JS matching the site's own styling instead.
      let pagefind;
      const input = document.getElementById("search-input");
      const results = document.getElementById("search-results");
      const status = document.getElementById("search-status");

      async function ensurePagefind() {
        if (!pagefind) {
          pagefind = await import("/pagefind/pagefind.js");
          await pagefind.init();
        }
        return pagefind;
      }

      let debounceTimer;
      input.addEventListener("input", () => {
        clearTimeout(debounceTimer);
        const term = input.value.trim();
        if (!term) {
          results.innerHTML = "";
          status.textContent = "";
          return;
        }
        debounceTimer = setTimeout(async () => {
          status.textContent = "Recherche…";
          const pf = await ensurePagefind();
          const search = await pf.search(term);
          const items = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));
          status.textContent = items.length
            ? `${items.length} résultat(s)`
            : `Aucun résultat pour « ${term} ».`;
          results.innerHTML = items
            .map(
              (item) =>
                `<li><a href="${item.url}">${item.meta.title || item.url}</a>` +
                `<span class="excerpt">${item.excerpt}</span></li>`
            )
            .join("");
        }, 150);
      });
    </script>
  </body>
</html>
