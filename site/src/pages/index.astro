---
// The real home page, docs/plan.md Sec2.2 - built 2026-09-13 now that all
// 7 themes exist with real data (the placeholder comment here used to say
// this needed "more than two indicators"; there are 86 now). Structure
// follows Sec2.2 with one deliberate departure from the original spec,
// per direct feedback: no lead-story block (Sec2.2's own §4, dropped -
// the headline cards plus the theme grid already do the "give a curious
// visitor the country in ninety seconds" job on their own), and the
// theme grid shows 5 main themes rather than all 7 site sections - prix
// and agriculture are their own pages (own URLs, own nav entries
// elsewhere) but conceptually sit inside économie, so the home page's
// top-level menu reflects that instead of listing 7 flat, equally-weighted
// rows. No map, per Sec2.2's own explicit call (a national choropleth
// would force picking one contested population figure over the others).
//
// Client JS on this page: the search box (existing exception) plus the
// sitewide dark-mode toggle every page carries - see CLAUDE.md's
// performance budget and ThemeToggle.astro. Everything else - headline
// cards - is computed here at build time from the same JSON artifacts
// each theme page already reads.
import population from "../data/population.json";
import prix from "../data/prix.json";
import infrastructures from "../data/infrastructures.json";
import education from "../data/education.json";
import economie from "../data/economie.json";
import ThemeInit from "../components/ThemeInit.astro";
import SiteNav from "../components/SiteNav.astro";

const CURRENT_YEAR = 2026;
const yearOf = (period: string) => Number(period.slice(0, 4));
const isStale = (period: string) => CURRENT_YEAR - yearOf(period) > 5;

const fmt = (n: number) => Math.round(n).toLocaleString("fr-FR");
const fmtPct = (n: number) => n.toLocaleString("fr-FR", { maximumFractionDigits: 1 });

// 5 main themes, not all 7 site sections - prix and agriculture nest
// under économie here (their own pages/nav entries still exist
// elsewhere, see footer). No freshness date at this level: with only 5
// broad rows this is a plain menu + one-line coverage description, not a
// vintage report - each theme's own page is where freshness actually
// belongs, indicator by indicator.
// One-glyph icon per theme, same stroke style as the nav bar's home icon
// (currentColor, 2px stroke, round caps) so the whole set reads as one
// family rather than mismatched clip-art - wayfinding, not decoration,
// same reasoning as the nav bar's own icon.
const ICONS = {
  population: `<circle cx="12" cy="8" r="3.2"></circle><path d="M5.5 20v-1.2a6.5 6.5 0 0 1 13 0V20"></path>`,
  infrastructures: `<path d="M13 2 5 14h5.5L9 22l9-13h-5.5L13 2Z"></path>`,
  education: `<path d="M12 6.2c-2-1.4-5-1.9-8-1.4v13.4c3-.5 6 0 8 1.4 2-1.4 5-1.9 8-1.4V4.8c-3-.5-6 0-8 1.4Z"></path><path d="M12 6.2v13.4"></path>`,
  sante: `<path d="M12 20s-7.3-4.4-9.6-8.7C.6 7.8 2.2 4 6 4c2.1 0 3.9 1.4 6 4 2.1-2.6 3.9-4 6-4 3.8 0 5.4 3.8 3.6 7.3C19.3 15.6 12 20 12 20Z"></path>`,
  economie: `<path d="M4 4v16h16"></path><path d="M7 15.5l4-4.5 3.2 3 5-6"></path>`,
};

const THEMES = [
  { name: "Population", href: "/population/", accent: "var(--t-pop)", icon: ICONS.population,
    description: "Recensements et projections, jusqu'à la sous-préfecture." },
  { name: "Infrastructures", href: "/infrastructures/", accent: "var(--t-infra)", icon: ICONS.infrastructures,
    description: "Électricité, eau, assainissement, internet et téléphonie." },
  { name: "Éducation", href: "/education/", accent: "var(--t-edu)", icon: ICONS.education,
    description: "Scolarisation, achèvement, alphabétisation, personnel enseignant." },
  { name: "Santé", href: "/sante/", accent: "var(--t-sante)", icon: ICONS.sante,
    description: "Espérance de vie, mortalité, vaccination, établissements de santé." },
  { name: "Économie", href: "/economie/", accent: "var(--t-eco)", icon: ICONS.economie,
    description: "PIB, commerce extérieur, dette - et prix et agriculture, en détail.",
    subLinks: [
      { name: "Prix", href: "/prix/" },
      { name: "Agriculture", href: "/agriculture/" },
    ] },
];

const manioc = prix.market.denrees.find((d: any) => d.indicator_id === "prix_manioc_kg");
// taux_croissance_pib's own "latest"/"national.headline" is deliberately
// ICASEES's 2021 figure on /economie/ itself (administrative data
// outranks a modelled estimate there, per méthode.astro's authority
// ranking - a considered policy, not staleness to fix). The home page's
// job is different: a quick, current snapshot, not the full ranked
// disclosure - so this specifically takes the last point of the World
// Bank's own annual series instead, the freshest real figure available
// (2025), labelled as what it is (a World Bank estimate, not the
// administrative one économie leads with).
const croissancePibSeries = economie.categories
  .flatMap((c: any) => c.indicators)
  .find((i: any) => i.indicator_id === "taux_croissance_pib").series;
const croissancePibLatest = croissancePibSeries[croissancePibSeries.length - 1];
const electricite = infrastructures.series[infrastructures.series.length - 1];
const achevementPrimaire = education.headline.national.headline;

// Deliberately mixes fresh and stale (docs/plan.md Sec2.2: "showing that
// electricity access comes from an older survey is the point").
const HEADLINE_CARDS = [
  {
    label: "Population", value: fmt(population.national.headline.value), unit: "habitants",
    period: population.national.headline.period, note: "provisoire",
    source: "ICASEES, RGPH-4", accent: "var(--t-pop)", href: "/population/",
  },
  {
    label: "Croissance du PIB", value: fmtPct(croissancePibLatest.value), unit: "%",
    period: croissancePibLatest.period, source: "Banque mondiale", accent: "var(--t-eco)", href: "/economie/",
  },
  {
    label: "Inflation annuelle", value: fmtPct(prix.inflation.latest.value), unit: "%",
    period: prix.inflation.latest.period, source: "ICASEES, IHPC", accent: "var(--t-prix)", href: "/prix/",
  },
  {
    label: "Accès à l'électricité", value: fmtPct(electricite.value), unit: "%",
    period: electricite.period, source: "Banque mondiale", accent: "var(--t-infra)", href: "/infrastructures/",
  },
  {
    label: "Achèvement du primaire", value: fmtPct(achevementPrimaire.value), unit: "%",
    period: achevementPrimaire.period, source: "UNESCO (UIS)", accent: "var(--t-edu)", href: "/education/",
  },
  {
    label: "Prix du manioc, Bangui", value: fmt(manioc.latest.value), unit: "FCFA/kg",
    period: manioc.latest.period, source: "ICASEES, IHPC", accent: "var(--t-prix)", href: "/prix/",
  },
];
---
<!doctype html>
<html lang="fr">
  <head>
    <ThemeInit />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Données RCA</title>
    <style>
      :root {
        --paper: #EDEEE6; --surface: #F8F8F2; --ink: #1B2420; --ink-muted: #5A6259;
        --ink-faint: #8B9188; --indigo: #2A56A8; --line: #D6D7C9;
        --stale: #AC3A1E; --stale-soft: #F1DFD2; --ochre: #B8790F; --ochre-soft: #F1E3C6;
        --t-pop: #2A56A8; --t-prix: #71811A; --t-infra: #6B4A9E; --t-edu: #A83C2E;
        --t-sante: #0E7C7B; --t-eco: #3D6373; --t-agri: #4C7A3D;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --paper: #171912; --surface: #1F221A; --ink: #E8E6DA; --ink-muted: #A6A895;
          --ink-faint: #6E7161; --indigo: #6FA0E8; --line: #33362A;
          --stale: #E2694A; --stale-soft: #3A211A; --ochre: #E0A83D; --ochre-soft: #3A2E12;
          --t-pop: #6FA0E8; --t-prix: #B9CC4A; --t-infra: #A98BDD; --t-edu: #E97A62;
          --t-sante: #4FC7C5; --t-eco: #7FB4C4; --t-agri: #86C46B;
        }
      }
      :root[data-theme="dark"] {
        --paper: #171912; --surface: #1F221A; --ink: #E8E6DA; --ink-muted: #A6A895;
        --ink-faint: #6E7161; --indigo: #6FA0E8; --line: #33362A;
        --stale: #E2694A; --stale-soft: #3A211A; --ochre: #E0A83D; --ochre-soft: #3A2E12;
        --t-pop: #6FA0E8; --t-prix: #B9CC4A; --t-infra: #A98BDD; --t-edu: #E97A62;
        --t-sante: #4FC7C5; --t-eco: #7FB4C4; --t-agri: #86C46B;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background-color: var(--paper);
        background-image:
          radial-gradient(1200px 640px at 15% -10%, color-mix(in srgb, var(--indigo) 9%, transparent), transparent 60%),
          radial-gradient(900px 520px at 100% 10%, color-mix(in srgb, var(--t-prix) 6%, transparent), transparent 60%);
        background-attachment: fixed;
        color: var(--ink); font-family: system-ui, sans-serif; font-size: 15px; line-height: 1.5;
      }
      main { max-width: 1080px; margin: 0 auto; padding: 84px 24px 80px; }

      .site-header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 20px; }
      h1 { font-size: 2.1rem; margin: 0; letter-spacing: -0.01em; }
      .tagline { color: var(--ink-muted); max-width: 46ch; margin: 6px 0 0; font-size: 14.5px; }

      #search { width: 100%; max-width: 380px; }
      #search input {
        width: 100%; font: inherit; font-size: 0.95rem; padding: 10px 12px;
        border: 1px solid var(--line); border-radius: 3px; background: var(--surface); color: var(--ink);
      }
      #search input:focus { outline: 2px solid var(--indigo); outline-offset: 1px; }
      #search-results { list-style: none; margin: 10px 0 0; padding: 0; position: relative; z-index: 5; }
      #search-results li { border-top: 1px solid var(--line); padding: 10px 0; background: var(--paper); }
      #search-results a { color: var(--indigo); font-size: 0.9rem; text-decoration: none; }
      #search-results a:hover { text-decoration: underline; }
      #search-results .excerpt { display: block; color: var(--ink-muted); font-size: 0.8rem; margin-top: 3px; }
      #search-results .excerpt mark { background: none; color: var(--ink); font-weight: 600; }
      #search-status { font-family: ui-monospace, monospace; font-size: 0.7rem; color: var(--ink-faint); margin-top: 6px; display: block; }

      .identity-strip {
        margin: 22px 0 0; font-size: 13.5px; color: var(--ink-muted);
        padding-top: 16px; border-top: 1px solid var(--line);
      }
      .identity-strip a { color: var(--indigo); text-decoration: none; border-bottom: 1px dotted var(--indigo); }
      .identity-strip a:hover { border-bottom-style: solid; }

      h2 { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-faint); font-weight: 600; margin: 40px 0 14px; }

      .stat-strip {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        background: var(--surface); border: 1px solid var(--line); border-radius: 4px;
        overflow: hidden;
      }
      .stat-item {
        padding: 16px 18px; text-decoration: none; color: inherit;
        border-left: 1px solid var(--line); border-top: 1px solid transparent;
        transition: background-color 0.15s ease;
      }
      .stat-item:first-child { border-left: none; }
      .stat-item:hover { background: color-mix(in srgb, var(--stat-accent) 7%, transparent); }
      .stat-label { font-size: 10.5px; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.03em; margin: 0 0 6px; }
      .stat-value {
        font-family: ui-monospace, monospace; font-size: 1.3rem; font-weight: 600; color: var(--stat-accent);
        margin: 0; display: flex; align-items: baseline; gap: 5px; flex-wrap: wrap;
      }
      .stat-value .unit { font-size: 0.62rem; color: var(--ink-faint); font-family: system-ui, sans-serif; font-weight: 400; }
      .stat-source { font-size: 10.5px; color: var(--ink-muted); margin: 6px 0 0; }
      .stat-source.stale { color: var(--stale); }
      .badge { display: inline-block; font-family: ui-monospace, monospace; font-size: 9.5px; padding: 1px 5px; border-radius: 2px; margin-left: 4px; background: var(--ochre-soft); color: var(--ochre); }

      .theme-rows {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 14px;
      }
      .theme-row {
        padding: 16px 18px; border-radius: 3px;
        background: var(--surface); border: 1px solid var(--line); border-left: 3px solid var(--row-accent);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }
      .theme-row:hover { transform: translateY(-2px); box-shadow: 0 8px 18px -12px color-mix(in srgb, var(--row-accent) 55%, transparent); }
      .theme-row .theme-heading { display: flex; align-items: center; gap: 9px; }
      .theme-row .theme-icon { flex: none; color: var(--row-accent); }
      .theme-row .theme-name { font-size: 16px; font-weight: 600; color: var(--row-accent); text-decoration: none; }
      .theme-row .theme-name:hover { text-decoration: underline; }
      .theme-row .theme-description { font-size: 12.5px; color: var(--ink-muted); margin: 7px 0 0; line-height: 1.45; }
      .theme-row .theme-sublinks { margin: 10px 0 0; display: flex; gap: 12px; }
      .theme-row .theme-sublinks a {
        font-size: 11.5px; color: var(--ink-faint);
        text-decoration: underline; text-decoration-style: dotted; text-underline-offset: 2px;
      }
      .theme-row .theme-sublinks a:hover { color: var(--row-accent); }

      footer {
        margin-top: 48px; padding-top: 18px; border-top: 1px solid var(--line);
        font-size: 12.5px; color: var(--ink-faint); display: flex; flex-wrap: wrap;
        justify-content: space-between; gap: 12px;
      }
      footer a { color: var(--ink-muted); }
      .site-nav { display: flex; gap: 14px; flex-wrap: wrap; }
      .site-nav a { color: var(--indigo); transition: opacity 0.15s ease; }
      .site-nav a:hover { opacity: 0.7; }
    </style>
  </head>
  <body>
    <SiteNav />
    <main>
      <div class="site-header">
        <div>
          <h1>Données RCA</h1>
          <p class="tagline">
            Explorer la République centrafricaine - ce que disent les données,
            d'où elles viennent, et ce que personne n'a encore mesuré.
          </p>
        </div>
        <div id="search">
          <input
            type="text" id="search-input"
            placeholder="Rechercher une préfecture, un indicateur…"
            autocomplete="off"
          />
          <span id="search-status"></span>
          <ul id="search-results"></ul>
        </div>
      </div>

      <p class="identity-strip">
        République centrafricaine ·
        <a href="/methode/#geographie">7 régions · 20 préfectures · 85 sous-préfectures</a>
      </p>

      <h2>En bref</h2>
      <div class="stat-strip">
        {HEADLINE_CARDS.map((c) => (
          <a class="stat-item" href={c.href} style={`--stat-accent: ${c.accent}`}>
            <p class="stat-label">{c.label}</p>
            <p class="stat-value">{c.value}<span class="unit">{c.unit}</span></p>
            <p class={`stat-source ${isStale(c.period) ? "stale" : ""}`}>
              {c.source}, {c.period}
              {c.note && <span class="badge">{c.note}</span>}
            </p>
          </a>
        ))}
      </div>

      <h2>Explorer par thème</h2>
      <div class="theme-rows">
        {THEMES.map((t) => (
          <div class="theme-row" style={`--row-accent: ${t.accent}`}>
            <div class="theme-heading">
              <svg class="theme-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.icon} />
              <a class="theme-name" href={t.href}>{t.name}</a>
            </div>
            <p class="theme-description">{t.description}</p>
            {t.subLinks && (
              <div class="theme-sublinks">
                {t.subLinks.map((s) => <a href={s.href}>{s.name}</a>)}
              </div>
            )}
          </div>
        ))}
      </div>

      <footer>
        <span>
          Données sous licence CC BY 4.0 (par source, voir <a href="/sources/">Sources</a>).
          Code sous licence MIT, <a href="https://github.com/jpzolabe/car-data-atlas">github.com/jpzolabe/car-data-atlas</a>.
        </span>
        <nav class="site-nav">
          <a href="/population/">Population</a>
          <a href="/infrastructures/">Infrastructures</a>
          <a href="/education/">Éducation</a>
          <a href="/sante/">Santé</a>
          <a href="/economie/">Économie</a>
          <a href="/sources/">Sources</a>
          <a href="/methode/">Méthode</a>
          <a href="/donnees/">Données</a>
          <a href="/a-propos/">À propos</a>
        </nav>
      </footer>
    </main>

    <script is:inline type="module">
      // Hand-built, not Pagefind's default UI bundle (~134 KB of JS/CSS for
      // widget chrome) - this site's page-weight budget is real, so search
      // uses the raw Pagefind API (~45 KB, loaded only on this page) plus a
      // few lines of vanilla JS matching the site's own styling instead.
      let pagefind;
      const input = document.getElementById("search-input");
      const results = document.getElementById("search-results");
      const status = document.getElementById("search-status");

      async function ensurePagefind() {
        if (!pagefind) {
          pagefind = await import("/pagefind/pagefind.js");
          await pagefind.init();
        }
        return pagefind;
      }

      let debounceTimer;
      input.addEventListener("input", () => {
        clearTimeout(debounceTimer);
        const term = input.value.trim();
        if (!term) {
          results.innerHTML = "";
          status.textContent = "";
          return;
        }
        debounceTimer = setTimeout(async () => {
          status.textContent = "Recherche…";
          const pf = await ensurePagefind();
          const search = await pf.search(term);
          const items = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));
          status.textContent = items.length
            ? `${items.length} résultat(s)`
            : `Aucun résultat pour « ${term} ».`;
          results.innerHTML = items
            .map(
              (item) =>
                `<li><a href="${item.url}">${item.meta.title || item.url}</a>` +
                `<span class="excerpt">${item.excerpt}</span></li>`
            )
            .join("");
        }, 150);
      });
    </script>
  </body>
</html>
