---
// Still a placeholder, not the real home page from docs/plan.md §2.2 —
// that needs the headline-card/lead-story/theme-grid structure once more
// than one indicator exists. This just links to what's actually built so
// far instead of being a dead end.
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Données RCA</title>
    <style>
      :root {
        --paper: #EDEEE6;
        --ink: #1B2420;
        --ink-muted: #5A6259;
        --indigo: #2A56A8;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: system-ui, sans-serif;
        display: flex;
        min-height: 100vh;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }
      main {
        max-width: 40ch;
        text-align: center;
      }
      h1 {
        font-size: 1.75rem;
        margin: 0 0 12px;
      }
      p {
        color: var(--ink-muted);
        line-height: 1.5;
        margin: 0;
      }
      .status {
        margin-top: 24px;
        font-family: ui-monospace, monospace;
        font-size: 0.75rem;
        color: var(--indigo);
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }
      nav {
        margin-top: 20px;
        display: flex;
        justify-content: center;
        gap: 16px;
      }
      nav a {
        color: var(--indigo);
        font-size: 0.9rem;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Données RCA</h1>
      <p>
        Explorer la République centrafricaine — ce que disent les données,
        d'où elles viennent, et ce que personne n'a encore mesuré.
      </p>
      <p class="status">En construction — deux indicateurs pour l'instant</p>
      <nav>
        <a href="/population/">Population par préfecture →</a>
        <a href="/prix/">Indice des prix →</a>
      </nav>
    </main>
  </body>
</html>
