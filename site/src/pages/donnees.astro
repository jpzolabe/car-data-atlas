---
// docs/plan.md site map: bulk downloads and the crosswalk. AGENTS.md's build
// order calls this "the credential that gets you a meeting at ICASEES" - the
// crosswalk is meant to be useful on its own, independent of the rest of the
// site. Files are copied into public/donnees/ by
// pipeline/export_public_data.py since the GitHub repo is currently private.
import data from "../data/donnees.json";
import ThemeInit from "../components/ThemeInit.astro";
import SiteNav from "../components/SiteNav.astro";
const files = data.files;
const totalRows = files.reduce((sum, f) => sum + f.rows, 0);
const coverage = data.coverage;

// Dataset structured data (schema.org/JSON-LD), with a real distribution
// entry per downloadable file - lets Google's Dataset Search index this
// as an actual dataset with its real download links, not just a page.
const datasetJsonLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "Données - BêAfrîka Data",
  "description": "Téléchargez directement les données de BêAfrîka Data : le rapprochement géographique complet de la République centrafricaine, en CSV.",
  "url": "https://beafrikadata.com/donnees/",
  "license": "https://creativecommons.org/licenses/by/4.0/legalcode",
  "creator": { "@type": "Organization", "name": "BêAfrîka Data", "url": "https://beafrikadata.com/" },
  "spatialCoverage": { "@type": "Place", "name": "République centrafricaine" },
  "inLanguage": "fr",
  "distribution": files.map((f) => ({
    "@type": "DataDownload",
    "name": f.name,
    "description": f.description,
    "encodingFormat": "text/csv",
    "contentUrl": `https://beafrikadata.com/donnees/${f.name}`,
  })),
};
---
<!doctype html>
<html lang="fr">
  <head>
    <ThemeInit />
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Données - BêAfrîka Data</title>
    <meta name="description" content="Téléchargez directement les données de BêAfrîka Data : le rapprochement géographique complet de la République centrafricaine, en CSV." />
    <link rel="canonical" href="https://beafrikadata.com/donnees/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BêAfrîka Data" />
    <meta property="og:title" content="Données - BêAfrîka Data" />
    <meta property="og:description" content="Téléchargez directement les données de BêAfrîka Data : le rapprochement géographique complet de la République centrafricaine, en CSV." />
    <meta property="og:url" content="https://beafrikadata.com/donnees/" />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Données - BêAfrîka Data" />
    <meta name="twitter:description" content="Téléchargez directement les données de BêAfrîka Data : le rapprochement géographique complet de la République centrafricaine, en CSV." />
    <script type="application/ld+json" set:html={JSON.stringify(datasetJsonLd)} />
    <style>
      @font-face {
        font-family: "IBM Plex Sans";
        src: url("/fonts/ibm-plex-sans-variable.woff2") format("woff2");
        font-weight: 400 700;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "IBM Plex Mono";
        src: url("/fonts/ibm-plex-mono-400.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "IBM Plex Mono";
        src: url("/fonts/ibm-plex-mono-700.woff2") format("woff2");
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
      :root {
        --paper: #23251F; --surface: #2B2E27; --ink: #E8E6DA; --ink-muted: #A6A895;
        --ink-faint: #8C8F7F; --line: #33362A; --indigo: #6FA0E8;
      }
      :root[data-theme="light"] { --paper: #F4F4F4; --surface: #EDEDED; --ink: #1B2420; --ink-muted: #4A524A; --ink-faint: #6E7468; --line: #D6D7C9; --indigo: #2A56A8; }
      @media print {
        :root { --paper: #F4F4F4; --surface: #EDEDED; --ink: #1B2420; --ink-muted: #4A524A; --ink-faint: #6E7468; --line: #D6D7C9; --indigo: #2A56A8; }
        body { background: #fff !important; background-image: none !important; }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background-color: var(--paper);
        background-image:
          radial-gradient(1000px 520px at 10% -10%, color-mix(in srgb, var(--indigo) 8%, transparent), transparent 60%),
          radial-gradient(700px 420px at 100% 100%, color-mix(in srgb, var(--indigo) 5%, transparent), transparent 60%);
        background-attachment: fixed;
        color: var(--ink); font-family: "IBM Plex Sans", system-ui, sans-serif; font-size: 16px; line-height: 1.5;
      }
      main { max-width: 1080px; margin: 0 auto; padding: 84px 24px 80px; }
      .file-grid {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
        gap: 18px;
      }
      h1 { font-size: 1.8rem; margin: 0 0 8px; }
      .lede { color: var(--ink-muted); margin: 0 0 8px; }
      .stat { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 12px; color: var(--indigo); margin: 0 0 24px; }
      .file-card {
        background: var(--surface); border: 1px solid var(--line); border-radius: 3px;
        padding: 15px 17px; display: flex; align-items: center; gap: 14px;
        transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
      }
      .file-card:hover {
        transform: translateY(-2px);
        border-color: color-mix(in srgb, var(--indigo) 40%, var(--line));
        box-shadow: 0 8px 18px -12px color-mix(in srgb, var(--indigo) 50%, transparent);
      }
      .file-card .name { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 13.5px; color: var(--ink); font-weight: 600; }
      .file-card .desc { color: var(--ink-muted); font-size: 12.5px; margin-top: 3px; }
      .file-card .rows { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 11px; color: var(--ink-faint); white-space: nowrap; }
      .file-card a.dl {
        margin-left: auto; flex: none; color: var(--indigo); font-family: "IBM Plex Mono", ui-monospace, monospace;
        font-size: 12px; text-decoration: none; border: 1px solid var(--indigo); border-radius: 3px;
        padding: 5px 10px; transition: background-color 0.15s ease, color 0.15s ease;
      }
      .file-card a.dl:hover { background: var(--indigo); color: var(--surface); }
      .file-main { flex: 1; min-width: 0; }
      h2 { font-size: 1rem; margin: 35px 0 9px; padding-top: 15px; border-top: 1px solid var(--line); }
      h2.first { margin-top: 0; padding-top: 0; border-top: none; }
      p { margin: 0 0 12px; }
      .category-grid-note { font-size: 13px; color: var(--ink-muted); margin: 0 0 16px; }
      .table-scroll { overflow-x: auto; margin-bottom: 8px; }
      .coverage-table { width: 100%; border-collapse: collapse; font-size: 13.5px; font-variant-numeric: tabular-nums; }
      .coverage-table th {
        text-align: left; font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 10.5px; text-transform: uppercase;
        letter-spacing: 0.04em; color: var(--ink-faint); font-weight: 400; padding: 0 14px 8px 0; white-space: nowrap;
      }
      .coverage-table td { padding: 7px 14px 7px 0; border-top: 1px solid var(--line); white-space: nowrap; }
      .coverage-table td.gap { color: var(--ink-faint); }
      a { color: var(--indigo); }
      code { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 0.9em; }
      footer { margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 12px; color: var(--ink-faint); text-align: center; }
      .site-nav { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
      .site-nav a { color: var(--indigo); font-size: 12.5px; transition: opacity 0.15s ease; }
      .site-nav a:hover { opacity: 0.7; }
      a:focus-visible, summary:focus-visible, button:focus-visible {
        outline: 2px solid var(--ink-faint); outline-offset: 2px; border-radius: 2px;
      }
    </style>
  </head>
  <body>
    <SiteNav />
    <main id="main-content">
      <h1>Données</h1>
      <p class="lede">
        Le rapprochement géographique complet, en téléchargement direct -
        indépendant du reste du site.
      </p>
      <p class="stat">{files.length} fichiers · {totalRows.toLocaleString("fr-FR")} lignes au total</p>

      <h2 class="first">Couverture</h2>
      <p class="category-grid-note">
        Pour chaque thème, le nombre d'indicateurs qui atteignent chaque niveau
        géographique, calculé directement depuis <code>indicators.csv</code> -
        un indicateur qui descend jusqu'à la sous-préfecture compte aussi pour
        les niveaux plus larges (région, préfecture), puisqu'un chiffre fin
        peut toujours être agrégé vers le haut. Le marché (colonne à part) est
        un point précis, pas une zone administrative - il ne s'emboîte pas
        dans les autres niveaux. Un 0 est une lacune réelle, pas une case
        vide : voir la section « Ce qui n'est pas mesuré » de chaque thème
        pour le détail.
      </p>
      <div class="table-scroll">
        <table class="coverage-table">
          <thead>
            <tr>
              <th scope="col">Thème</th>
              <th scope="col">Pays</th>
              <th scope="col">Région</th>
              <th scope="col">Préfecture</th>
              <th scope="col">Sous-préfecture</th>
              <th scope="col">Marché</th>
            </tr>
          </thead>
          <tbody>
            {coverage.map((row) => (
              <tr>
                <td><a href={`/${row.theme_id}/`}>{row.label}</a></td>
                <td class={row.by_level.pays === 0 ? "gap" : ""}>{row.by_level.pays}/{row.total}</td>
                <td class={row.by_level.region === 0 ? "gap" : ""}>{row.by_level.region}/{row.total}</td>
                <td class={row.by_level.prefecture === 0 ? "gap" : ""}>{row.by_level.prefecture}/{row.total}</td>
                <td class={row.by_level.sous_prefecture === 0 ? "gap" : ""}>{row.by_level.sous_prefecture}/{row.total}</td>
                <td class={row.marche === 0 ? "gap" : ""}>{row.marche > 0 ? `${row.marche}/${row.total}` : "-"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>Fichiers</h2>
      <div class="file-grid">
        {files.map((f) => (
          <div class="file-card">
            <div class="file-main">
              <div class="name">{f.name}</div>
              <div class="desc">{f.description}</div>
            </div>
            <span class="rows">{f.rows.toLocaleString("fr-FR")} lignes</span>
            <a class="dl" href={`/donnees/${f.name}`} download>Télécharger</a>
          </div>
        ))}
      </div>

      <h2>Licence</h2>
      <p>
        Toutes ces données sont sous licence
        <a href="https://creativecommons.org/licenses/by/4.0/legalcode">CC BY 4.0</a>.
        Détails et mises en garde par source sur la page
        <a href="/sources/">Sources</a> - certaines sources ont des conditions
        de réutilisation réelles, pas seulement théoriques.
      </p>

      <h2>Ce qui reste ouvert</h2>
      <p>
        <code>unresolved.csv</code> ne traduit pas un échec : il réunit les
        désaccords entre sources encore sans arbitrage.
      </p>

      <footer>
        <nav class="site-nav">
          <a href="/population/">Population</a>
          <a href="/infrastructures/">Infrastructures</a>
          <a href="/education/">Éducation</a>
          <a href="/sante/">Santé</a>
          <a href="/economie/">Économie</a>
          <a href="/agriculture/">Agriculture</a>
          <a href="/prix/">Prix</a>
          <a href="/prefectures/">Préfectures</a>
          <a href="/sources/">Sources</a>
          <a href="/methode/">Méthode</a>
          <a href="/donnees/">Données</a>
          <a href="/contact/">Contact</a>
        </nav>
        <div style="text-align:center;padding:64px 0 8px;">
          <svg class="footer-flag" viewBox="0 0 900 600" width="44" height="29" role="img" aria-label="Drapeau de la République centrafricaine" style="width:44px;height:29px;display:inline-block;">
            <rect width="900" height="150" fill="#003082"/>
            <rect y="150" width="900" height="150" fill="#FFFFFF"/>
            <rect y="300" width="900" height="150" fill="#009739"/>
            <rect y="450" width="900" height="150" fill="#FFD100"/>
            <rect x="375" width="150" height="600" fill="#CE1126"/>
            <path fill="#FFD100" d="M187.5,20 L199.8,58 L239.8,58 L207.5,81.5 L219.8,119.5 L187.5,96 L155.2,119.5 L167.5,81.5 L135.2,58 L175.2,58 Z"/>
          </svg>
        </div>
      </footer>
    </main>
  </body>
</html>
