---
// Added 2026-10-19 to replace à-propos's "Contact" section as the site's
// one reachable contact point, after à-propos itself was taken offline
// (moved to src/_offline/, not deleted - see that file's own note).
//
// Real form, not just a mailto link - submits via Web3Forms
// (web3forms.com): a plain HTML POST to their API, no JS needed, no
// account/dashboard required (unlike Formspree). Chosen over Netlify
// Forms specifically because the live site is deployed on Cloudflare,
// not Netlify - Netlify's native form handling only works when Netlify
// is actually serving the site. The access key below identifies which
// inbox submissions get forwarded to (hello.usex@gmail.com) - it's
// meant to be public, it isn't a secret the way an API key normally is.
// Honeypot field (botcheck) is Web3Forms' documented spam-trap pattern:
// hidden from humans via CSS, so only bots fill it in.
import ThemeInit from "../components/ThemeInit.astro";
import SiteNav from "../components/SiteNav.astro";

const WEB3FORMS_ACCESS_KEY = "WEB3FORMS_ACCESS_KEY_PLACEHOLDER";
---
<!doctype html>
<html lang="fr">
  <head>
    <ThemeInit />
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Contact - BêAfrîka Data</title>
    <meta name="description" content="Une question, une correction à signaler ou une source à proposer pour BêAfrîka Data : comment nous contacter." />
    <link rel="canonical" href="https://beafrikadata.com/contact/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BêAfrîka Data" />
    <meta property="og:title" content="Contact - BêAfrîka Data" />
    <meta property="og:description" content="Une question, une correction à signaler ou une source à proposer pour BêAfrîka Data : comment nous contacter." />
    <meta property="og:url" content="https://beafrikadata.com/contact/" />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Contact - BêAfrîka Data" />
    <meta name="twitter:description" content="Une question, une correction à signaler ou une source à proposer pour BêAfrîka Data : comment nous contacter." />
    <style>
      @font-face {
        font-family: "IBM Plex Sans";
        src: url("/fonts/ibm-plex-sans-variable.woff2") format("woff2");
        font-weight: 400 700;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "IBM Plex Mono";
        src: url("/fonts/ibm-plex-mono-400.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "IBM Plex Mono";
        src: url("/fonts/ibm-plex-mono-700.woff2") format("woff2");
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
      :root {
        --paper: #23251F; --ink: #E8E6DA; --ink-muted: #A6A895; --ink-faint: #8C8F7F;
        --line: #33362A; --indigo: #6FA0E8;
      }
      :root[data-theme="light"] { --paper: #F4F4F4; --ink: #1B2420; --ink-muted: #5A6259; --ink-faint: #8B9188; --line: #D6D7C9; --indigo: #2A56A8; }
      @media print {
        :root { --paper: #F4F4F4; --ink: #1B2420; --ink-muted: #5A6259; --ink-faint: #8B9188; --line: #D6D7C9; --indigo: #2A56A8; }
        body { background: #fff !important; background-image: none !important; }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background-color: var(--paper);
        background-image:
          radial-gradient(1000px 520px at 10% -10%, color-mix(in srgb, var(--indigo) 8%, transparent), transparent 60%),
          radial-gradient(700px 420px at 100% 100%, color-mix(in srgb, var(--indigo) 5%, transparent), transparent 60%);
        background-attachment: fixed;
        color: var(--ink); font-family: "IBM Plex Sans", system-ui, sans-serif; font-size: 15px; line-height: 1.6;
      }
      main { max-width: 560px; margin: 0 auto; padding: 84px 24px 80px; }
      h1 { font-size: 1.8rem; margin: 0 0 12px; }
      p { margin: 0 0 20px; color: var(--ink-muted); }
      form { margin-bottom: 8px; }
      .field { margin-bottom: 16px; }
      label {
        display: block; font-size: 12.5px; text-transform: uppercase;
        letter-spacing: 0.03em; color: var(--ink-faint); margin-bottom: 6px;
      }
      input, textarea {
        width: 100%; font: inherit; font-size: 14.5px; color: var(--ink);
        background: #2B2E27; border: 1px solid var(--line); border-radius: 4px;
        padding: 10px 12px;
      }
      :root[data-theme="light"] input, :root[data-theme="light"] textarea { background: #ECECEC; }
      input:focus, textarea:focus {
        outline: none; border-color: var(--indigo);
      }
      textarea { resize: vertical; min-height: 120px; }
      .botcheck { position: absolute; left: -9999px; }
      button[type="submit"] {
        font: inherit; font-size: 14.5px; font-weight: 600;
        color: var(--paper); background: var(--indigo);
        border: none; border-radius: 4px; padding: 11px 22px;
        cursor: pointer; transition: opacity 0.15s ease;
      }
      button[type="submit"]:hover { opacity: 0.85; }
      footer { margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 12px; color: var(--ink-faint); text-align: center; }
      .site-nav { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
      .site-nav a { color: var(--indigo); font-size: 12.5px; transition: opacity 0.15s ease; }
      .site-nav a:hover { opacity: 0.7; }
      a:focus-visible, summary:focus-visible, button:focus-visible {
        outline: 2px solid var(--ink-faint); outline-offset: 2px; border-radius: 2px;
      }
    </style>
  </head>
  <body>
    <SiteNav />
    <main id="main-content">
      <h1>Contact</h1>
      <p>
        Une question, une correction à signaler ou une source à proposer
        pour BêAfrîka Data : écrivez-nous ci-dessous.
      </p>

      <form action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
        <input type="hidden" name="subject" value="Nouveau message - BêAfrîka Data" />
        <input type="hidden" name="redirect" value="https://beafrikadata.com/contact/merci/" />
        <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" />

        <div class="field">
          <label for="name">Nom</label>
          <input type="text" id="name" name="name" required />
        </div>
        <div class="field">
          <label for="email">E-mail</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" required></textarea>
        </div>
        <button type="submit">Envoyer</button>
      </form>

      <footer>
        <nav class="site-nav">
          <a href="/population/">Population</a>
          <a href="/infrastructures/">Infrastructures</a>
          <a href="/education/">Éducation</a>
          <a href="/sante/">Santé</a>
          <a href="/economie/">Économie</a>
          <a href="/agriculture/">Agriculture</a>
          <a href="/prix/">Prix</a>
          <a href="/prefectures/">Préfectures</a>
          <a href="/sources/">Sources</a>
          <a href="/methode/">Méthode</a>
          <a href="/donnees/">Données</a>
          <a href="/contact/">Contact</a>
        </nav>
        <div style="text-align:center;padding:64px 0 8px;">
          <svg class="footer-flag" viewBox="0 0 900 600" width="44" height="29" role="img" aria-label="Drapeau de la République centrafricaine" style="width:44px;height:29px;display:inline-block;">
            <rect width="900" height="150" fill="#003082"/>
            <rect y="150" width="900" height="150" fill="#FFFFFF"/>
            <rect y="300" width="900" height="150" fill="#009739"/>
            <rect y="450" width="900" height="150" fill="#FFD100"/>
            <rect x="375" width="150" height="600" fill="#CE1126"/>
            <path fill="#FFD100" d="M187.5,20 L199.8,58 L239.8,58 L207.5,81.5 L219.8,119.5 L187.5,96 L155.2,119.5 L167.5,81.5 L135.2,58 L175.2,58 Z"/>
          </svg>
        </div>
      </footer>
    </main>
  </body>
</html>
