---
// Fourth theme page. Combines two patterns already established rather than
// inventing a third: the national multi-source disclosure block from
// population.astro (here: national survey vs. UIS modelled estimate, a real
// disagreement — see docs/decisions.md) and the build-time SVG line chart
// from prix.astro/infrastructures.astro, with the 4 real survey points drawn
// as distinct markers over the denser modelled line so the reader can see
// where the model and the survey data actually agree or diverge.
import data from "../data/education.json";

const national = data.national;
const distinctSources = [...new Set(national.all_sources.map((s) => s.producer + s.dataset_name))].length;

const series = data.series; // modelled, dense, 1981-2025
const surveyPoints = data.survey_points; // 4 real years

const W = 1000, H = 300, marginL = 46, marginR = 20, marginT = 20, marginB = 34;
const plotW = W - marginL - marginR;
const plotH = H - marginT - marginB;

const periodToIndex = new Map(series.map((d, i) => [d.period, i]));
const min = 0; // honest zero-based axis for a percentage
const allValues = [...series.map((d) => d.value), ...surveyPoints.map((d) => d.value)];
const max = Math.ceil(Math.max(...allValues) / 5) * 5;

const x = (i: number) => marginL + (i / (series.length - 1)) * plotW;
const y = (v: number) => marginT + plotH - ((v - min) / (max - min)) * plotH;
const points = series.map((d, i) => `${x(i).toFixed(1)},${y(d.value).toFixed(1)}`).join(" ");

const ticks = [0, max / 2, max];
const yearLabels = series.filter((d) => Number(d.period) % 5 === 0);

const fmt = (n: number) => n.toLocaleString("fr-FR", { maximumFractionDigits: 1 });
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Taux d'achèvement du primaire — Données RCA</title>
    <style>
      :root {
        --paper: #EDEEE6; --surface: #F8F8F2; --ink: #1B2420; --ink-muted: #5A6259;
        --ink-faint: #8B9188; --line: #D6D7C9;
        --t-edu: #A83C2E;
        --ochre: #B8790F; --ochre-soft: #F1E3C6;
        --stale: #AC3A1E; --stale-soft: #F6DCD5;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background-color: var(--paper);
        background-image:
          radial-gradient(1000px 520px at 10% -10%, color-mix(in srgb, var(--t-edu) 9%, transparent), transparent 60%),
          radial-gradient(700px 420px at 100% 100%, color-mix(in srgb, var(--t-edu) 6%, transparent), transparent 60%);
        background-attachment: fixed;
        color: var(--ink); font-family: system-ui, sans-serif; font-size: 15px; line-height: 1.5;
      }
      main { max-width: 1080px; margin: 0 auto; padding: 32px 24px 80px; }
      .crumb { font-family: ui-monospace, monospace; font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--ink-faint); margin-bottom: 6px; }
      .crumb a { color: var(--ink-faint); text-decoration: none; }
      .crumb a:hover { color: var(--t-edu); text-decoration: underline; }
      h1 {
        font-size: 1.8rem; margin: 0 0 8px; display: inline-block;
        border-bottom: 3px solid var(--t-edu); padding-bottom: 4px;
      }
      h2 { font-size: 1.1rem; margin: 32px 0 10px; }
      .lede { color: var(--ink-muted); max-width: 62ch; margin: 12px 0 20px; }
      .badge {
        display: inline-block; font-family: ui-monospace, monospace; font-size: 10.5px;
        padding: 2px 6px; border-radius: 2px; margin-left: 6px; vertical-align: middle;
      }
      .badge.estime { background: var(--ochre-soft); color: var(--ochre); }
      .badge.enquete { background: color-mix(in srgb, var(--t-edu) 14%, var(--surface)); color: var(--t-edu); }
      .national-figure {
        margin: 20px 0; padding: 18px 20px; background: var(--surface);
        border: 1px solid var(--line); border-left: 3px solid var(--t-edu); border-radius: 3px;
      }
      .national-value {
        font-family: ui-monospace, monospace; font-size: 2.1rem; font-weight: 600;
        color: var(--t-edu); display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap;
      }
      .national-value .unit {
        font-family: system-ui, sans-serif; font-size: 0.85rem; font-weight: 400; color: var(--ink-faint);
      }
      .national-meta { font-size: 12.5px; color: var(--ink-muted); margin-top: 4px; }
      .disclosure { margin-top: 12px; }
      .disclosure summary {
        cursor: pointer; font-family: ui-monospace, monospace; font-size: 12px; color: var(--t-edu);
        list-style: none; display: flex; align-items: center; gap: 6px;
      }
      .disclosure summary::-webkit-details-marker { display: none; }
      .disclosure summary::before { content: "▸"; font-size: 10px; transition: transform 0.15s ease; }
      .disclosure[open] summary::before { transform: rotate(90deg); }
      .disclosure-table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 12.5px; }
      .disclosure-table th {
        text-align: left; font-family: ui-monospace, monospace; font-size: 10px; text-transform: uppercase;
        color: var(--ink-faint); letter-spacing: 0.04em; padding: 0 10px 6px 0; font-weight: 400;
      }
      .disclosure-table td { padding: 7px 10px 7px 0; border-top: 1px solid var(--line); }
      .disclosure-table td.num { font-family: ui-monospace, monospace; }
      .disclosure-note { font-size: 11.5px; color: var(--ink-faint); margin: 10px 0 0; max-width: 64ch; }
      .sentence {
        font-style: italic; font-size: 17px; line-height: 1.5; color: var(--ink);
        border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
        border-left: 3px solid var(--t-edu); padding: 14px 0 14px 14px; margin: 20px 0;
      }
      .sentence-tag {
        display: block; font-style: normal; font-family: ui-monospace, monospace;
        font-size: 10px; color: var(--ink-faint); text-transform: uppercase;
        letter-spacing: 0.05em; margin-top: 6px;
      }
      svg { width: 100%; height: auto; display: block; margin: 16px 0; }
      .gridline { stroke: var(--line); stroke-width: 1; }
      .axis-label { fill: var(--ink-faint); font-size: 10px; font-family: ui-monospace, monospace; }
      .line-modelled {
        stroke: var(--t-edu); stroke-width: 2; stroke-dasharray: 4 3; fill: none; opacity: 0.75;
      }
      .survey-point { fill: var(--t-edu); stroke: var(--surface); stroke-width: 2; }
      .survey-label { fill: var(--ink); font-size: 10.5px; font-family: ui-monospace, monospace; }
      .chart-legend { display: flex; gap: 18px; font-family: ui-monospace, monospace; font-size: 10.5px; color: var(--ink-muted); margin-top: 4px; flex-wrap: wrap; }
      .chart-legend span { display: inline-flex; align-items: center; gap: 5px; }
      .swatch { width: 14px; height: 2px; display: inline-block; }
      .swatch-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; background: var(--t-edu); }
      .gap-note { margin-top: 24px; font-style: italic; color: var(--ink-muted); font-size: 13.5px; border-left: 3px solid var(--ink-faint); padding-left: 12px; }
      footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 12px; color: var(--ink-faint); }
      footer a { color: var(--ink-muted); }
      .site-nav { display: flex; gap: 14px; margin-top: 14px; flex-wrap: wrap; }
      .site-nav a { color: var(--t-edu); font-size: 12.5px; transition: opacity 0.15s ease; }
      .site-nav a:hover { opacity: 0.7; }
    </style>
  </head>
  <body>
    <main>
      <div class="crumb"><a href="/">République centrafricaine</a></div>
      <h1>Taux d'achèvement du primaire</h1>
      <p class="lede">
        Part d'une cohorte d'âge ayant achevé le cycle d'enseignement
        primaire, tous sexes confondus. Deux séries qui ne s'accordent pas
        toujours : une enquête nationale à quatre points dans le temps, et
        une estimation modélisée annuelle publiée par l'UNESCO.
      </p>

      <div class="national-figure">
        <div class="national-value">
          {fmt(national.headline.value)}<span class="unit">%</span>
          <span class="badge enquete">enquête</span>
        </div>
        <div class="national-meta">
          {national.headline.producer} — {national.headline.dataset_name}, {national.headline.period}
        </div>
        <details class="disclosure">
          <summary>{distinctSources} sources — écart de {national.spread_pct}% avec l'estimation modélisée de la même année</summary>
          <table class="disclosure-table">
            <thead>
              <tr><th>Valeur</th><th>Statut</th><th>Période</th></tr>
            </thead>
            <tbody>
              {national.all_sources.map((s) => (
                <tr>
                  <td class="num">{fmt(s.value)}%</td>
                  <td><span class={`badge ${s.quality_flag}`}>{s.quality_flag}</span></td>
                  <td>{s.period}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="disclosure-note">
            Écart calculé entre l'enquête et l'estimation modélisée pour la
            même année ({national.spread_vs_period}), pas contre la dernière
            année modélisée disponible — comparer des années différentes
            aurait mélangé deux désaccords distincts (source contre source,
            et passage du temps). Le plus grand écart réel entre les deux
            séries, sur les quatre années où l'on peut comparer, est en 2010
            (42,9% enquête contre 25,2% modèle). Classement d'autorité :
            enquête nationale &gt; estimation modélisée internationale — voir
            <a href="/methode/#classement">Méthode</a>.
          </p>
        </details>
      </div>

      <p class="sentence">
        {data.lead_sentence}
        <span class="sentence-tag">phrase générée · gabarit {data.lead_sentence_template_id}</span>
      </p>

      <h2>Série modélisée, 1981–{series[series.length - 1].period}</h2>
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Taux d'achèvement du primaire, estimation modélisée 1981-${series[series.length - 1].period}, avec les points d'enquête réels superposés`}>
        {ticks.map((t) => (
          <>
            <line class="gridline" x1={marginL} y1={y(t)} x2={W - marginR} y2={y(t)} />
            <text class="axis-label" x={marginL - 6} y={y(t) + 3} text-anchor="end">{fmt(t)}%</text>
          </>
        ))}
        {yearLabels.map((d) => (
          <text class="axis-label" x={x(periodToIndex.get(d.period)!)} y={H - marginB + 16} text-anchor="middle">{d.period}</text>
        ))}
        <polyline class="line-modelled" points={points} />
        {surveyPoints.map((d) => {
          const idx = periodToIndex.get(d.period);
          if (idx === undefined) return null;
          return (
            <>
              <circle class="survey-point" cx={x(idx)} cy={y(d.value)} r="5" />
              <text class="survey-label" x={x(idx)} y={y(d.value) - 10} text-anchor="middle">{fmt(d.value)}%</text>
            </>
          );
        })}
      </svg>
      <div class="chart-legend">
        <span><span class="swatch" style="background:var(--t-edu);border-top:2px dashed var(--t-edu);height:0;opacity:0.75;"></span>estimation modélisée (UIS, annuelle)</span>
        <span><span class="swatch-dot"></span>enquête nationale (4 points réels)</span>
      </div>

      <p class="gap-note">
        L'UIS n'a pas cité, dans cette réponse d'API, l'enquête précise
        (MICS, EHCVM…) qui a produit chaque point de la série « enquête » —
        seule l'année est fournie. Aucune ventilation par sexe, par milieu
        (urbain/rural) ou par quintile de richesse n'est encore intégrée ici,
        bien que l'UIS les publie aussi. Voir <code>docs/verification-debt.md</code>.
      </p>

      <footer>
        Série modélisée : {data.source.producer} — {data.source.dataset_name}.
        Récupéré le {data.source.retrieved_at}. <a href={data.source.url}>{data.source.url}</a>
        <br />
        Série enquête : {data.source_survey.dataset_name}.
        Récupéré le {data.source_survey.retrieved_at}. <a href={data.source_survey.url}>{data.source_survey.url}</a>
        <nav class="site-nav">
          <a href="/population/">Population</a>
          <a href="/prix/">Prix</a>
          <a href="/infrastructures/">Électricité</a>
          <a href="/sources/">Sources</a>
          <a href="/methode/">Méthode</a>
          <a href="/donnees/">Données</a>
          <a href="/a-propos/">À propos</a>
        </nav>
      </footer>
    </main>
  </body>
</html>
