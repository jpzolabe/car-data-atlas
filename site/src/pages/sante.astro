---
// First build of the santé theme (previously nonexistent — docs/plan.md's
// site map calls for 7 themes; this is theme #5). Same anatomy as
// education.astro (docs/plan.md Sec2.3): headline figure, categories ordered
// by logical sequence, "Ce qui n'est pas mesuré" hand-written. No disclosure
// blocks here -- every indicator has exactly one source so far, so every
// card is the plain latest-value-plus-series shape already used for
// infrastructures/prix/population's "Autres indicateurs" sections.
import data from "../data/sante.json";

const CURRENT_YEAR = 2026;
// 5-year threshold, matching méthode.astro's "administrative data" band --
// these are all annual World Bank estimates, not survey-linked.
function isStale(period: string): boolean {
  return CURRENT_YEAR - Number(period) > 5;
}

const fmt = (n: number) => n.toLocaleString("fr-FR", { maximumFractionDigits: 1 });

// Small build-time SVG sparkline, same technique as every other theme page.
const SPARK_W = 460, SPARK_H = 90, SPARK_ML = 40, SPARK_MR = 10, SPARK_MT = 10, SPARK_MB = 18;
function sparkline(ind: { series: { period: string; value: number }[] }) {
  const s = ind.series;
  const plotW = SPARK_W - SPARK_ML - SPARK_MR;
  const plotH = SPARK_H - SPARK_MT - SPARK_MB;
  const vals = s.map((d) => d.value);
  const sMin = Math.min(...vals) * 0.9;
  const sMax = Math.max(...vals) * 1.1;
  const sx = (i: number) => SPARK_ML + (i / Math.max(s.length - 1, 1)) * plotW;
  const sy = (v: number) => SPARK_MT + plotH - ((v - sMin) / (sMax - sMin)) * plotH;
  const points = s.map((d, i) => `${sx(i).toFixed(1)},${sy(d.value).toFixed(1)}`).join(" ");
  return {
    points, firstYear: s[0].period, lastYear: s[s.length - 1].period,
    xFirst: sx(0), xLast: sx(s.length - 1),
  };
}

const allIndicatorCount = data.categories.reduce((sum, c) => sum + c.indicators.length, 0);
const allPeriods = data.categories.flatMap((c) => c.indicators.map((i) => Number(i.latest.period)));
const oldestVintage = Math.min(...allPeriods);
const newestVintage = Math.max(...allPeriods);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Santé — Données RCA</title>
    <style>
      :root {
        --paper: #EDEEE6; --surface: #F8F8F2; --ink: #1B2420; --ink-muted: #5A6259;
        --ink-faint: #8B9188; --line: #D6D7C9;
        --t-sante: #0E7C7B;
        --stale: #AC3A1E; --stale-soft: #F6DCD5;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background-color: var(--paper);
        background-image:
          radial-gradient(1000px 520px at 10% -10%, color-mix(in srgb, var(--t-sante) 9%, transparent), transparent 60%),
          radial-gradient(700px 420px at 100% 100%, color-mix(in srgb, var(--t-sante) 6%, transparent), transparent 60%);
        background-attachment: fixed;
        color: var(--ink); font-family: system-ui, sans-serif; font-size: 15px; line-height: 1.5;
      }
      main { max-width: 1080px; margin: 0 auto; padding: 32px 24px 80px; }
      .crumb { font-family: ui-monospace, monospace; font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--ink-faint); margin-bottom: 6px; }
      .crumb a { color: var(--ink-faint); text-decoration: none; }
      .crumb a:hover { color: var(--t-sante); text-decoration: underline; }
      h1 {
        font-size: 1.8rem; margin: 0 0 8px; display: inline-block;
        border-bottom: 3px solid var(--t-sante); padding-bottom: 4px;
      }
      .lede { color: var(--ink-muted); max-width: 62ch; margin: 12px 0 8px; }
      .coverage { font-family: ui-monospace, monospace; font-size: 12px; color: var(--t-sante); margin: 0 0 28px; }
      .headline-block {
        margin: 0 0 32px; padding: 22px 24px; background: var(--surface);
        border: 1px solid var(--line); border-left: 4px solid var(--t-sante); border-radius: 3px;
      }
      .headline-value {
        font-family: ui-monospace, monospace; font-size: 2.6rem; font-weight: 600;
        color: var(--t-sante); display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
      }
      .headline-value .unit { font-size: 1.1rem; color: var(--ink-faint); font-family: system-ui, sans-serif; }
      .headline-caption { color: var(--ink-muted); font-size: 13.5px; margin: 4px 0 0; }
      h2 { font-size: 1.15rem; margin: 40px 0 12px; padding-top: 18px; border-top: 1px solid var(--line); }
      .badge {
        display: inline-block; font-family: ui-monospace, monospace; font-size: 10.5px;
        padding: 2px 6px; border-radius: 2px; margin-left: 6px; vertical-align: middle;
      }
      .badge.stale { background: var(--stale-soft); color: var(--stale); }
      .indicator-grid {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(440px, 1fr));
        gap: 14px;
      }
      .indicator-card {
        background: var(--surface); border: 1px solid var(--line); border-radius: 3px;
        padding: 16px 18px;
      }
      .indicator-card .ind-name { font-size: 1rem; font-weight: 600; margin: 0 0 6px; }
      .indicator-card .ind-value {
        font-family: ui-monospace, monospace; font-size: 1.5rem; font-weight: 600;
        color: var(--t-sante); display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap;
      }
      .indicator-card .ind-value .unit { font-size: 0.75rem; color: var(--ink-faint); font-family: system-ui, sans-serif; font-weight: 400; }
      svg.mini-sparkline { width: 100%; height: auto; display: block; margin-top: 8px; }
      .mini-spark-line {
        stroke: var(--t-sante); stroke-width: 2; fill: none;
        stroke-dasharray: 2000; stroke-dashoffset: 2000;
        animation: drawMiniSpark 1.1s ease-out forwards;
      }
      @keyframes drawMiniSpark { to { stroke-dashoffset: 0; } }
      @media (prefers-reduced-motion: reduce) { .mini-spark-line { animation: none; stroke-dashoffset: 0; } }
      .mini-spark-axis-label { fill: var(--ink-faint); font-size: 9px; font-family: ui-monospace, monospace; }
      .mini-sentence { font-style: italic; font-size: 13px; color: var(--ink-muted); margin: 8px 0 0; }
      .not-measured { margin: 14px 0 0; padding-left: 20px; color: var(--ink-muted); font-size: 14px; line-height: 1.7; }
      .not-measured li { margin-bottom: 4px; }
      footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 12px; color: var(--ink-faint); }
      footer a { color: var(--ink-muted); }
      .site-nav { display: flex; gap: 14px; margin-top: 14px; flex-wrap: wrap; }
      .site-nav a { color: var(--t-sante); font-size: 12.5px; transition: opacity 0.15s ease; }
      .site-nav a:hover { opacity: 0.7; }
    </style>
  </head>
  <body>
    <main>
      <div class="crumb"><a href="/">République centrafricaine</a></div>
      <h1>Santé</h1>
      <p class="lede">
        Système de santé, vaccination, mortalité, espérance de vie et VIH —
        10 indicateurs, tous de la Banque mondiale, tous nationaux. Premier
        thème santé du site.
      </p>
      <p class="coverage">
        {allIndicatorCount} indicateurs · données de {oldestVintage} à {newestVintage} selon l'indicateur ·
        niveau le plus fin : pays
      </p>

      <div class="headline-block">
        <div class="headline-value">
          {fmt(data.headline.latest.value)}<span class="unit">ans, {data.headline.latest.period}</span>
        </div>
        <p class="headline-caption">{data.headline.name_fr} — le chiffre le plus souvent cité pour résumer l'état de santé d'une population.</p>
        <p class="mini-sentence">
          {data.headline.lead_sentence}
        </p>
      </div>

      {data.categories.map((category) => (
        <>
          <h2>{category.label_fr}</h2>
          <div class="indicator-grid">
            {category.indicators.map((ind) => {
              const spark = sparkline(ind);
              const stale = isStale(ind.latest.period);
              return (
                <div class="indicator-card">
                  <p class="ind-name">{ind.name_fr}</p>
                  <div class="ind-value">
                    {fmt(ind.latest.value)}<span class="unit">, {ind.latest.period}</span>
                    {stale && <span class="badge stale">ancien</span>}
                  </div>
                  <svg class="mini-sparkline" viewBox={`0 0 ${SPARK_W} ${SPARK_H}`} role="img" aria-label={`${ind.name_fr}, ${spark.firstYear} à ${spark.lastYear}`}>
                    <polyline class="mini-spark-line" points={spark.points} />
                    <text class="mini-spark-axis-label" x={spark.xFirst} y={SPARK_H - 4} text-anchor="start">{spark.firstYear}</text>
                    <text class="mini-spark-axis-label" x={spark.xLast} y={SPARK_H - 4} text-anchor="end">{spark.lastYear}</text>
                  </svg>
                  <p class="mini-sentence">{ind.lead_sentence}</p>
                  <span style="font-size:11px;color:var(--ink-faint);display:block;margin-top:6px;">
                    {ind.source.producer}. Récupéré le {ind.source.retrieved_at}.
                  </span>
                </div>
              );
            })}
          </div>
        </>
      ))}

      <h2>Ce qui n'est pas mesuré</h2>
      <ul class="not-measured">
        <li>Rien par région, préfecture ou sous-préfecture — les 10 indicateurs sont tous nationaux.</li>
        <li>MICS7 (enquête nationale, lancée août 2026 selon <code>CLAUDE.md</code>) n'a pas encore publié de résultats intégrables ici.</li>
        <li>Le raster de temps de trajet à pied vers l'établissement de santé le plus proche existe déjà sur HDX — volontairement non reconstruit ici (<code>CLAUDE.md</code> : « ne pas reconstruire ce qui existe déjà »). Voir <a href="https://data.humdata.org/">HDX</a> directement.</li>
        <li>Aucune donnée de morbidité au-delà du VIH — paludisme, tuberculose et maladies évitables par la vaccination (au-delà de la rougeole et du DTC) ne sont pas intégrées.</li>
        <li>La densité de lits d'hôpital n'a qu'un point après 2011 — c'est réellement tout ce que la Banque mondiale a pour la RCA sur cet indicateur, pas un artefact d'affichage.</li>
      </ul>

      <footer>
        Toutes les données de cette page : World Bank (World Development Indicators),
        récupérées via l'API publique <a href="https://api.worldbank.org/v2/country/CAF/indicator/">api.worldbank.org</a>, le 2026-09-12.
        Détail par source sur la page <a href="/sources/">Sources</a>.
        <nav class="site-nav">
          <a href="/population/">Population</a>
          <a href="/prix/">Prix</a>
          <a href="/infrastructures/">Infrastructures</a>
          <a href="/education/">Éducation</a>
          <a href="/economie/">Économie</a>
          <a href="/agriculture/">Agriculture</a>
          <a href="/sources/">Sources</a>
          <a href="/methode/">Méthode</a>
          <a href="/donnees/">Données</a>
          <a href="/a-propos/">À propos</a>
        </nav>
      </footer>
    </main>
  </body>
</html>
