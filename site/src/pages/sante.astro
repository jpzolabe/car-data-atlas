---
// First build of the santé theme (previously nonexistent - docs/plan.md's
// site map calls for 7 themes; this is theme #5). Same anatomy as
// education.astro (docs/plan.md Sec2.3): headline figure, categories ordered
// by logical sequence, "Ce qui n'est pas mesuré" hand-written. No disclosure
// blocks here; every indicator has exactly one source so far, so every
// card is the plain latest-value-plus-series shape already used for
// infrastructures/prix/population's "Autres indicateurs" sections.
//
// section-nav (added 2026-09-13): sticky in-page jump menu, one link per
// category plus "Ce qui n'est pas mesuré" - same pattern as economie.astro
// and education.astro. Categories stay fully expanded; pure navigation.
import data from "../data/sante.json";
import ThemeInit from "../components/ThemeInit.astro";
import SiteNav from "../components/SiteNav.astro";

const CURRENT_YEAR = 2026;
// 5 maternal/child health indicators (added 2026-09-12, UNICEF Data
// Warehouse) are survey-linked (MICS-style, not annually updated) - 10-year
// threshold, matching éducation's SURVEY_LINKED band. Everything else here
// is an annual World Bank estimate - 5-year threshold.
const SURVEY_LINKED = new Set([
  "soins_prenatals_4visites", "accouchement_assiste", "allaitement_exclusif",
  "retard_croissance_enfants", "emaciation_enfants",
]);
function isStale(indicatorId: string, period: string): boolean {
  // méthode.astro's own threshold table: "< N ans" = actuel, "N ans" =
  // déjà ancien - so exactly N years old must already read as stale.
  const threshold = SURVEY_LINKED.has(indicatorId) ? 10 : 5;
  return CURRENT_YEAR - Number(period) >= threshold;
}

const fmt = (n: number) => n.toLocaleString("fr-FR", { maximumFractionDigits: 1 });

// Compact badge text - the raw quality_flag values ("enquete", "estime")
// are missing their accents.
function badgeLabel(flag: string): string {
  if (flag === "enquete") return "enquête";
  if (flag === "estime") return "estimé";
  if (flag === "osm") return "OSM";
  return flag;
}

// Small build-time SVG sparkline, same technique as every other theme page.
const SPARK_W = 460, SPARK_H = 90, SPARK_ML = 40, SPARK_MR = 10, SPARK_MT = 10, SPARK_MB = 18;
function sparkline(ind: { series: { period: string; value: number }[] }) {
  const s = ind.series;
  const plotW = SPARK_W - SPARK_ML - SPARK_MR;
  const plotH = SPARK_H - SPARK_MT - SPARK_MB;
  const vals = s.map((d) => d.value);
  const sMin = Math.min(...vals) * 0.9;
  const sMax = Math.max(...vals) * 1.1;
  const sx = (i: number) => SPARK_ML + (i / Math.max(s.length - 1, 1)) * plotW;
  const sy = (v: number) => SPARK_MT + plotH - ((v - sMin) / (sMax - sMin)) * plotH;
  const points = s.map((d, i) => `${sx(i).toFixed(1)},${sy(d.value).toFixed(1)}`).join(" ");
  // Hover targets: one per data point, native <title> tooltip - no chart
  // library or client JS needed (CLAUDE.md's zero-JS budget for charts).
  // See docs/decisions.md.
  const hoverPoints = s.map((d, i) => ({ cx: sx(i), cy: sy(d.value), period: d.period, value: d.value }));
  // One or two intermediate year labels (roughly a third and two-thirds of
  // the way through) - user feedback, only first/last year were labelled.
  const midLabels = [...new Set([
    Math.round((s.length - 1) / 3),
    Math.round((s.length - 1) * 2 / 3),
  ])]
    .filter((i) => i > 0 && i < s.length - 1)
    .map((i) => ({ x: sx(i), year: s[i].period }));
  return {
    points, hoverPoints, midLabels, firstYear: s[0].period, lastYear: s[s.length - 1].period,
    xFirst: sx(0), xLast: sx(s.length - 1),
  };
}

---
<!doctype html>
<html lang="fr">
  <head>
    <ThemeInit />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Santé - BêAfrîka Data</title>
    <style>
      :root {
        --paper: #23251F; --surface: #2B2E27; --ink: #E8E6DA; --ink-muted: #A6A895;
        --ink-faint: #8C8F7F; --line: #33362A;
        --t-sante: #4FC7C5;
        --stale: #E2694A; --stale-soft: #3A211A;
      }
      :root[data-theme="light"] {
        --paper: #EDEEE6; --surface: #F8F8F2; --ink: #1B2420; --ink-muted: #5A6259;
        --ink-faint: #8B9188; --line: #D6D7C9;
        --t-sante: #0E7C7B;
        --stale: #AC3A1E; --stale-soft: #F6DCD5;
      }
      @media print {
        :root {
        --paper: #EDEEE6; --surface: #F8F8F2; --ink: #1B2420; --ink-muted: #5A6259;
        --ink-faint: #8B9188; --line: #D6D7C9;
        --t-sante: #0E7C7B;
        --stale: #AC3A1E; --stale-soft: #F6DCD5;
      }
        body { background: #fff !important; background-image: none !important; }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background-color: var(--paper);
        background-image:
          radial-gradient(1000px 520px at 10% -10%, color-mix(in srgb, var(--t-sante) 9%, transparent), transparent 60%),
          radial-gradient(700px 420px at 100% 100%, color-mix(in srgb, var(--t-sante) 6%, transparent), transparent 60%);
        background-attachment: fixed;
        color: var(--ink); font-family: system-ui, sans-serif; font-size: 15px; line-height: 1.5;
      }
      main { max-width: 1080px; margin: 0 auto; padding: 84px 24px 80px; }
      h1 {
        font-size: 1.8rem; margin: 0 0 8px; display: inline-block;
        border-bottom: 3px solid var(--t-sante); padding-bottom: 4px;
      }
      .lede { color: var(--ink-muted); margin: 12px 0 8px; }
      .section-nav {
        position: sticky; top: 54px; z-index: 40;
        display: flex; gap: 6px; flex-wrap: wrap;
        padding: 10px 0; margin: 0 0 20px;
        background: color-mix(in srgb, var(--paper) 92%, transparent);
        backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
        border-bottom: 1px solid var(--line);
      }
      .section-nav a {
        font-family: ui-monospace, monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.03em;
        color: var(--ink-muted); text-decoration: none; white-space: nowrap;
        padding: 5px 10px; border-radius: 3px; border: 1px solid var(--line); background: var(--surface);
        transition: color 0.15s ease, border-color 0.15s ease;
      }
      .section-nav a:hover { color: var(--t-sante); border-color: var(--t-sante); }
      .headline-block {
        margin: 0 0 32px; padding: 22px 24px; background: var(--surface);
        border: 1px solid var(--line); border-left: 4px solid var(--t-sante); border-radius: 3px;
      }
      .headline-value {
        font-family: ui-monospace, monospace; font-size: 2.6rem; font-weight: 600;
        color: var(--t-sante); display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
      }
      .headline-value .unit { font-size: 1.1rem; color: var(--ink-faint); font-family: system-ui, sans-serif; }
      .headline-caption { color: var(--ink-muted); font-size: 13.5px; margin: 4px 0 0; }
      h2 { font-size: 1.15rem; margin: 43px 0 13px; padding-top: 19px; border-top: 1px solid var(--line); scroll-margin-top: 104px; }
      .badge {
        display: inline-block; font-family: ui-monospace, monospace; font-size: 10.5px;
        padding: 2px 6px; border-radius: 2px; margin-left: 6px; vertical-align: middle;
      }
      .badge.stale { background: var(--stale-soft); color: var(--stale); }
      .badge.administratif { background: color-mix(in srgb, var(--t-sante) 14%, var(--surface)); color: var(--t-sante); }
      .badge.osm { background: color-mix(in srgb, var(--ink-faint) 18%, var(--surface)); color: var(--ink-muted); }
      .national-figure {
        margin: 0; padding: 17px 19px; background: var(--surface);
        border: 1px solid var(--line); border-left: 3px solid var(--t-sante); border-radius: 3px;
      }
      .national-value {
        font-family: ui-monospace, monospace; font-size: 1.5rem; font-weight: 600;
        color: var(--t-sante); display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap;
      }
      .national-value .unit { font-family: system-ui, sans-serif; font-size: 0.75rem; font-weight: 400; color: var(--ink-faint); }
      .national-meta { font-size: 11px; color: var(--ink-faint); margin-top: 4px; }
      .disclosure { margin-top: 10px; }
      .disclosure summary {
        cursor: pointer; font-family: ui-monospace, monospace; font-size: 11.5px; color: var(--t-sante);
        list-style: none; display: flex; align-items: center; gap: 6px;
      }
      .disclosure summary::-webkit-details-marker { display: none; }
      .disclosure summary::before { content: "▸"; font-size: 10px; transition: transform 0.15s ease; }
      .disclosure[open] summary::before { transform: rotate(90deg); }
      .disclosure-table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 12px; }
      .disclosure-table th {
        text-align: left; font-family: ui-monospace, monospace; font-size: 9.5px; text-transform: uppercase;
        color: var(--ink-faint); letter-spacing: 0.04em; padding: 0 10px 6px 0; font-weight: 400;
      }
      .disclosure-table td { padding: 6px 10px 6px 0; border-top: 1px solid var(--line); }
      .disclosure-table td.num { font-family: ui-monospace, monospace; }
      .disclosure-note { font-size: 11px; color: var(--ink-faint); margin: 8px 0 0; max-width: 64ch; }
      .indicator-grid {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(min(440px, 100%), 1fr));
        gap: 25px;
      }
      .indicator-card {
        background: var(--surface); border: 1px solid var(--line); border-radius: 3px;
        padding: 17px 19px;
      }
      .indicator-card .ind-name { font-size: 1rem; font-weight: 600; margin: 0 0 4px; }
      .indicator-card .ind-definition { font-size: 12.5px; color: var(--ink-muted); line-height: 1.5; margin: 0 0 8px; }
      .indicator-card .ind-value {
        font-family: ui-monospace, monospace; font-size: 1.5rem; font-weight: 600;
        color: var(--t-sante); display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap;
      }
      .indicator-card .ind-value .unit { font-size: 0.75rem; color: var(--ink-faint); font-family: system-ui, sans-serif; font-weight: 400; }
      svg.mini-sparkline { width: 100%; height: auto; display: block; margin-top: 8px; }
      .hover-pt { fill: transparent; pointer-events: all; }
      .hover-pt:hover { fill: var(--t-sante); }
      .mini-spark-line {
        stroke: var(--t-sante); stroke-width: 2; fill: none;
        stroke-dasharray: 2000; stroke-dashoffset: 2000;
        animation: drawMiniSpark 1.1s ease-out forwards;
      }
      @keyframes drawMiniSpark { to { stroke-dashoffset: 0; } }
      @media (prefers-reduced-motion: reduce) { .mini-spark-line { animation: none; stroke-dashoffset: 0; } }
      .mini-spark-axis-label { fill: var(--ink-faint); font-size: 9px; font-family: ui-monospace, monospace; }
      .single-point-note {
        margin: 8px 0 0; padding: 8px 10px; font-size: 12px; color: var(--ink-faint);
        background: color-mix(in srgb, var(--t-sante) 6%, transparent);
        border-radius: 3px;
      }
      .mini-sentence { font-style: italic; font-size: 13px; color: var(--ink-muted); margin: 8px 0 0; }
      .not-measured { margin: 14px 0 0; padding-left: 20px; color: var(--ink-muted); font-size: 14px; line-height: 1.7; }
      .not-measured li { margin-bottom: 4px; }
      footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 12px; color: var(--ink-faint); }
      footer a { color: var(--ink-muted); }
      .site-nav { display: flex; gap: 14px; margin-top: 14px; flex-wrap: wrap; }
      .site-nav a { color: var(--t-sante); font-size: 12.5px; transition: opacity 0.15s ease; }
      .site-nav a:hover { opacity: 0.7; }
    </style>
  </head>
  <body>
    <SiteNav />
    <main id="main-content">
      <h1>Santé</h1>
      <p class="lede">
        Le système de santé dans son ensemble - vaccination, santé
        maternelle et infantile, mortalité, espérance de vie et VIH - à
        partir des données de la Banque mondiale, de l'OMS et de
        l'UNICEF, à l'échelle du pays uniquement : aucune ventilation par
        région ou préfecture pour l'instant. Le nombre d'établissements
        de santé provient de deux sources qui ne s'accordent pas
        nettement ; les deux sont présentées plutôt qu'un chiffre unique
        choisi arbitrairement.
      </p>

      <nav class="section-nav" aria-label="Sections de la page">
        {data.categories.map((category) => (
          <a href={`#${category.key}`}>{category.label_fr}</a>
        ))}
      </nav>

      <div class="headline-block">
        <div class="headline-value">
          {fmt(data.headline.latest.value)}<span class="unit">ans, {data.headline.latest.period}</span>
        </div>
        <p class="headline-caption">L'espérance de vie à la naissance est le chiffre le plus souvent cité pour résumer l'état de santé d'une population.</p>
        <p class="headline-caption">{data.headline.definition_fr}</p>
        <p class="mini-sentence">
          {data.headline.lead_sentence}
        </p>
      </div>

      {data.categories.map((category) => (
        <>
          <h2 id={category.key}>{category.label_fr}</h2>
          <div class="indicator-grid">
            {category.indicators.map((ind) => {
              const spark = sparkline(ind);
              const stale = isStale(ind.indicator_id, ind.latest.period);

              if ("national" in ind) {
                return (
                  <div class="indicator-card">
                    <p class="ind-name">{ind.name_fr}</p>
                    <p class="ind-definition">{ind.definition_fr}</p>
                    <div class="national-figure">
                      <div class="national-value">
                        {fmt(ind.national.headline.value)}<span class="unit"> {ind.unit}, {ind.national.headline.period}</span>
                        <span class={`badge ${ind.national.headline.quality_flag}`}>{badgeLabel(ind.national.headline.quality_flag)}</span>
                      </div>
                      <div class="national-meta">{ind.national.headline.producer}</div>
                      <details class="disclosure">
                        <summary>{ind.national.all_sources.length} sources - écart de {ind.national.spread_pct}%</summary>
                        <table class="disclosure-table">
                          <thead><tr><th scope="col">Valeur</th><th scope="col">Producteur</th><th scope="col">Période</th><th scope="col">Statut</th></tr></thead>
                          <tbody>
                            {ind.national.all_sources.map((s) => (
                              <tr>
                                <td class="num">{fmt(s.value)}</td>
                                <td>{s.producer}</td>
                                <td>{s.period}</td>
                                <td><span class={`badge ${s.quality_flag}`}>{badgeLabel(s.quality_flag)}</span></td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                        <p class="disclosure-note">
                          Deux sources indépendantes, deux méthodes différentes (registre
                          administratif statique contre cartographie communautaire continue) -
                          voir <a href="/sources/">Sources</a> pour le détail complet.
                        </p>
                      </details>
                      {ind.region_breakdown && ind.region_breakdown.length > 0 && (
                        <details class="disclosure">
                          <summary>Répartition régionale ({ind.region_breakdown.length} régions)</summary>
                          <table class="disclosure-table">
                            <thead><tr><th scope="col">Région</th><th scope="col">Établissements</th></tr></thead>
                            <tbody>
                              {ind.region_breakdown.map((r) => (
                                <tr>
                                  <td>{r.region_name}</td>
                                  <td class="num">{fmt(r.value)}</td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                          <p class="disclosure-note">
                            Même registre 2019 que le total national ci-dessus, ventilé par région -
                            aucun chiffre OpenStreetMap équivalent à ce niveau, donc un seul avis ici,
                            pas deux.
                          </p>
                        </details>
                      )}
                    </div>
                    {ind.series.length > 1 ? (
                      <svg class="mini-sparkline" viewBox={`0 0 ${SPARK_W} ${SPARK_H}`} role="img" aria-label={`${ind.name_fr}, ${spark.firstYear} à ${spark.lastYear}`}>
                        <polyline class="mini-spark-line" points={spark.points} />
                        <text class="mini-spark-axis-label" x={spark.xFirst} y={SPARK_H - 4} text-anchor="start">{spark.firstYear}</text>
                        {spark.midLabels.map((m) => (
                          <text class="mini-spark-axis-label" x={m.x} y={SPARK_H - 4} text-anchor="middle">{m.year}</text>
                        ))}
                        <text class="mini-spark-axis-label" x={spark.xLast} y={SPARK_H - 4} text-anchor="end">{spark.lastYear}</text>
                        {spark.hoverPoints.map((p) => (
                          <circle class="hover-pt" cx={p.cx} cy={p.cy} r="4">
                            <title>{p.period} : {fmt(p.value)} {ind.unit}</title>
                          </circle>
                        ))}
                      </svg>
                    ) : (
                      <p class="single-point-note">Une seule mesure disponible ({ind.latest.period}) - pas d'évolution à montrer.</p>
                    )}
                    <p class="mini-sentence">{ind.lead_sentence}</p>
                  </div>
                );
              }

              return (
                <div class="indicator-card">
                  <p class="ind-name">{ind.name_fr}</p>
                  <p class="ind-definition">{ind.definition_fr}</p>
                  <div class="ind-value">
                    {fmt(ind.latest.value)}<span class="unit"> {ind.unit}, {ind.latest.period}</span>
                    {stale && <span class="badge stale">ancien</span>}
                  </div>
                  {ind.series.length > 1 ? (
                    <svg class="mini-sparkline" viewBox={`0 0 ${SPARK_W} ${SPARK_H}`} role="img" aria-label={`${ind.name_fr}, ${spark.firstYear} à ${spark.lastYear}`}>
                      <polyline class="mini-spark-line" points={spark.points} />
                      <text class="mini-spark-axis-label" x={spark.xFirst} y={SPARK_H - 4} text-anchor="start">{spark.firstYear}</text>
                      {spark.midLabels.map((m) => (
                        <text class="mini-spark-axis-label" x={m.x} y={SPARK_H - 4} text-anchor="middle">{m.year}</text>
                      ))}
                      <text class="mini-spark-axis-label" x={spark.xLast} y={SPARK_H - 4} text-anchor="end">{spark.lastYear}</text>
                      {spark.hoverPoints.map((p) => (
                        <circle class="hover-pt" cx={p.cx} cy={p.cy} r="4">
                          <title>{p.period} : {fmt(p.value)} {ind.unit}</title>
                        </circle>
                      ))}
                    </svg>
                  ) : (
                    <p class="single-point-note">Une seule mesure disponible ({ind.latest.period}) - pas d'évolution à montrer.</p>
                  )}
                  <p class="mini-sentence">{ind.lead_sentence}</p>
                  <span style="font-size:11px;color:var(--ink-faint);display:block;margin-top:6px;">
                    {ind.source.producer}. Récupéré le {ind.source.retrieved_at}.
                  </span>
                </div>
              );
            })}
          </div>
        </>
      ))}

      <h2 id="non-mesure">Ce qui n'est pas mesuré</h2>
      <ul class="not-measured">
        <li>Rien par région, préfecture ou sous-préfecture : toutes ces données sont nationales.</li>
        <li>MICS7 (enquête nationale, lancée en août 2026) n'a pas encore publié de résultats ; la santé maternelle et infantile ci-dessus vient de MICS6 (2018-2019), le round précédent.</li>
        <li>Le raster de temps de trajet à pied vers l'établissement de santé le plus proche existe déjà sur <a href="https://data.humdata.org/">HDX</a> - volontairement non reconstruit ici.</li>
        <li>Le registre gouvernemental des établissements de santé date de 2019 - largement au-delà du seuil de fraîcheur de 2 ans publié dans <a href="/methode/">Méthode</a> pour ce type de donnée ; c'est réellement la donnée la plus récente trouvée, pas un artefact d'affichage.</li>
        <li>Localisation précise des établissements de santé (latitude/longitude) : disponible dans les deux sources mais non exploitée ici - ce thème reste au niveau national pour l'instant.</li>
        <li>Aucune donnée de morbidité au-delà du VIH - paludisme, tuberculose et maladies évitables par la vaccination (au-delà de la rougeole et du DTC) ne sont pas intégrées.</li>
        <li>La densité de lits d'hôpital n'a qu'un point après 2011 - c'est réellement tout ce que la Banque mondiale a pour la RCA sur cet indicateur, pas un artefact d'affichage.</li>
        <li>Aucun décompte de lits d'hôpital n'est publié directement par la Banque mondiale ou l'OMS - celui affiché ici est calculé (densité x population de la même année), pas une donnée brute.</li>
        <li>Le personnel infirmier varie fortement d'une année à l'autre dans les données de l'OMS (835 en 2008, 5 653 en 2023, 2 331 en 2024) - probablement un changement de méthode de collecte, non confirmé.</li>
      </ul>

      <footer>
        Données de cette page : World Bank (World Development Indicators),
        OMS (Global Health Observatory), UNICEF (Data Warehouse), Maina et
        al. (Master Facility List) et OpenStreetMap - source indiquée sous
        chaque indicateur. Détail complet par source sur la
        page <a href="/sources/">Sources</a>.
        <nav class="site-nav">
          <a href="/population/">Population</a>
          <a href="/infrastructures/">Infrastructures</a>
          <a href="/education/">Éducation</a>
          <a href="/sante/">Santé</a>
          <a href="/economie/">Économie</a>
          <a href="/prefectures/">Préfectures</a>
          <a href="/sources/">Sources</a>
          <a href="/methode/">Méthode</a>
          <a href="/donnees/">Données</a>
          <a href="/a-propos/">À propos</a>
        </nav>
      </footer>
    </main>
  </body>
</html>
