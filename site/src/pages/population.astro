---
// First real content page - Phase 2. Reads a build-time JSON artifact
// materialized by pipeline/export_population_json.py (data/observations.csv ->
// DuckDB join -> JSON). Astro never parses the raw CSVs itself - see
// docs/decisions.md.
//
// section-nav (added 2026-09-13): sticky in-page jump menu. This page has no
// dynamic categories like economie/education/sante, just 3 static sections
// (Classement, Par région, Autres indicateurs) - hand-written links rather
// than a .map() over a categories array. Same visual pattern as the other
// theme pages otherwise; sections stay fully expanded, pure navigation.
import data from "../data/population.json";
import ThemeInit from "../components/ThemeInit.astro";
import SiteNav from "../components/SiteNav.astro";

const byRegion = new Map<string, typeof data.prefectures>();
for (const row of data.prefectures) {
  if (!byRegion.has(row.region)) byRegion.set(row.region, []);
  byRegion.get(row.region)!.push(row);
}
const regions = [...byRegion.keys()].sort();

const fmt = (n: number) => n.toLocaleString("fr-FR");
const fmtDecimal = (n: number) => n.toLocaleString("fr-FR", { maximumFractionDigits: 1 });

const national = data.national;
const distinctSources = [...new Set(national.all_sources.map((s) => s.producer))];

// One distinct accent per région - wayfinding, not decoration: with 7 tables
// sitting side by side in a grid, color is what lets the eye tell them apart
// without re-reading every header. Bas-Oubangui (Bangui alone) gets a neutral
// rather than a 7th saturated hue, since it's the odd-one-out single-préfecture
// région. Kept distinct from --t-pop/--t-prix used elsewhere on this page.
const REGION_COLORS: Record<string, string> = {
  "Plateaux": "#B33A5B",
  "Équateur": "#2E7D5B",
  "Yadé": "#6B4A9E",
  "Kaga": "#C2571F",
  "Fertit": "#1C7A9C",
  "Haut-Oubangui": "#8A6B1F",
  "Bas-Oubangui": "#5A6259",
};

// Build-time bar chart - all 20 préfectures, 2021 estimate, ranked. Computed
// here rather than shipped as a client chart library, per CLAUDE.md's
// build-time-SVG approach (the "no client JS" default still holds here, it's
// just not the letter of the budget rule that was the point - see the chat).
const ranked = [...data.prefectures].sort((a, b) => b.pop_2021 - a.pop_2021);
const CHART_W = 1000;

// Small build-time SVG sparkline for the "Autres indicateurs" cards; same
// technique as education.astro/prix.astro/infrastructures.astro's,
// duplicated per this project's one-file-per-page convention.
const SPARK_W = 460, SPARK_H = 90, SPARK_ML = 34, SPARK_MR = 10, SPARK_MT = 10, SPARK_MB = 18;
function sparkline(ind: { series: { period: string; value: number }[] }) {
  const s = ind.series;
  const plotW2 = SPARK_W - SPARK_ML - SPARK_MR;
  const plotH2 = SPARK_H - SPARK_MT - SPARK_MB;
  const vals = s.map((d) => d.value);
  const sMin = Math.min(...vals) * 0.9;
  const sMax = Math.max(...vals) * 1.1;
  const sx = (i: number) => SPARK_ML + (i / Math.max(s.length - 1, 1)) * plotW2;
  const sy = (v: number) => SPARK_MT + plotH2 - ((v - sMin) / (sMax - sMin)) * plotH2;
  const pts = s.map((d, i) => `${sx(i).toFixed(1)},${sy(d.value).toFixed(1)}`).join(" ");
  return {
    points: pts, firstYear: s[0].period, lastYear: s[s.length - 1].period,
    xFirst: sx(0), xLast: sx(s.length - 1),
  };
}
const ROW_H = 22;
const MARGIN_L = 148;
const MARGIN_R = 56;
const BAR_MAX_W = CHART_W - MARGIN_L - MARGIN_R;
const maxPop = Math.max(...ranked.map((r) => r.pop_2021));
const CHART_H = ranked.length * ROW_H + 10;
const barWidth = (v: number) => (v / maxPop) * BAR_MAX_W;
---
<!doctype html>
<html lang="fr">
  <head>
    <ThemeInit />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Population - BêAfrîka Data</title>
    <style>
      :root {
        --paper: #23251F; --surface: #2B2E27; --ink: #E8E6DA; --ink-muted: #A6A895;
        --ink-faint: #8C8F7F; --line: #33362A; --indigo: #6FA0E8; --t-pop: #6FA0E8;
        --stale: #E2694A; --stale-soft: #3A211A; --ochre: #E0A83D; --ochre-soft: #3A2E12;
      }
      :root[data-theme="light"] {
        --paper: #EDEEE6;
        --surface: #F8F8F2;
        --ink: #1B2420;
        --ink-muted: #5A6259;
        --ink-faint: #8B9188;
        --line: #D6D7C9;
        --indigo: #2A56A8;
        --t-pop: #2A56A8;
        --stale: #AC3A1E;
        --stale-soft: #F1DFD2;
        --ochre: #8C5A0C;
        --ochre-soft: #F1E3C6;
      }
      @media print {
        :root {
        --paper: #EDEEE6;
        --surface: #F8F8F2;
        --ink: #1B2420;
        --ink-muted: #5A6259;
        --ink-faint: #8B9188;
        --line: #D6D7C9;
        --indigo: #2A56A8;
        --t-pop: #2A56A8;
        --stale: #AC3A1E;
        --stale-soft: #F1DFD2;
        --ochre: #8C5A0C;
        --ochre-soft: #F1E3C6;
      }
        body { background: #fff !important; background-image: none !important; }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background-color: var(--paper);
        background-image:
          radial-gradient(1000px 520px at 10% -10%, color-mix(in srgb, var(--t-pop) 10%, transparent), transparent 60%),
          radial-gradient(700px 420px at 100% 100%, color-mix(in srgb, var(--t-pop) 6%, transparent), transparent 60%);
        background-attachment: fixed;
        color: var(--ink);
        font-family: system-ui, sans-serif;
        font-size: 15px;
        line-height: 1.5;
      }
      main { max-width: 1080px; margin: 0 auto; padding: 84px 24px 80px; }
      .crumb {
        font-family: ui-monospace, monospace; font-size: 11px; text-transform: uppercase;
        letter-spacing: .05em; color: var(--ink-faint); margin-bottom: 6px;
      }
      .crumb a { color: var(--ink-faint); text-decoration: none; }
      .crumb a:hover { color: var(--t-pop); text-decoration: underline; }
      h1 {
        font-size: 1.8rem; margin: 0 0 8px; display: inline-block;
        border-bottom: 3px solid var(--t-pop); padding-bottom: 4px;
      }
      .lede { color: var(--ink-muted); max-width: 60ch; margin: 12px 0 24px; }
      .section-nav {
        position: sticky; top: 54px; z-index: 40;
        display: flex; gap: 6px; flex-wrap: wrap;
        padding: 10px 0; margin: 0 0 20px;
        background: color-mix(in srgb, var(--paper) 92%, transparent);
        backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
        border-bottom: 1px solid var(--line);
      }
      .section-nav a {
        font-family: ui-monospace, monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.03em;
        color: var(--ink-muted); text-decoration: none; white-space: nowrap;
        padding: 5px 10px; border-radius: 3px; border: 1px solid var(--line); background: var(--surface);
        transition: color 0.15s ease, border-color 0.15s ease;
      }
      .section-nav a:hover { color: var(--t-pop); border-color: var(--t-pop); }
      h2 {
        font-size: 0.85rem; text-transform: uppercase; letter-spacing: .05em;
        color: var(--t-pop); font-weight: 600; margin: 32px 0 8px;
        border-bottom: 1px solid var(--line); padding-bottom: 6px;
        scroll-margin-top: 104px;
      }
      .section-toggle { margin: 32px 0 8px; }
      .section-toggle summary {
        font-size: 0.85rem; text-transform: uppercase; letter-spacing: .05em;
        color: var(--t-pop); font-weight: 600; margin: 0 0 8px;
        border-bottom: 1px solid var(--line); padding-bottom: 6px;
        cursor: pointer; list-style: none; display: flex; align-items: center; gap: 6px;
      }
      .section-toggle summary::-webkit-details-marker { display: none; }
      .section-toggle summary::before { content: "▸"; font-size: 11px; transition: transform 0.15s ease; }
      .section-toggle[open] summary::before { transform: rotate(90deg); }
      .section-toggle summary:hover { color: var(--indigo); }
      .not-measured { margin: 14px 0 0; padding-left: 20px; color: var(--ink-muted); font-size: 14px; line-height: 1.7; }
      .not-measured li { margin-bottom: 4px; }
      svg { width: 100%; height: auto; display: block; margin: 10px 0 4px; }
      .indicator-grid {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(min(440px, 100%), 1fr));
        gap: 22px;
      }
      .indicator-card {
        background: var(--surface); border: 1px solid var(--line); border-radius: 3px;
        padding: 16px 18px;
      }
      .indicator-card .ind-name { font-size: 1rem; font-weight: 600; margin: 0 0 4px; }
      .indicator-card .ind-definition { font-size: 12.5px; color: var(--ink-muted); line-height: 1.5; margin: 0 0 8px; }
      .indicator-card .ind-value {
        font-family: ui-monospace, monospace; font-size: 1.5rem; font-weight: 600;
        color: var(--t-pop);
      }
      .indicator-card .ind-value .unit { font-size: 0.8rem; color: var(--ink-faint); font-family: system-ui, sans-serif; font-weight: 400; }
      svg.mini-sparkline { width: 100%; height: auto; display: block; margin-top: 8px; }
      .mini-spark-line {
        stroke: var(--t-pop); stroke-width: 2; fill: none;
        stroke-dasharray: 2000; stroke-dashoffset: 2000;
        animation: drawMiniSpark 1.1s ease-out forwards;
      }
      @keyframes drawMiniSpark { to { stroke-dashoffset: 0; } }
      @media (prefers-reduced-motion: reduce) { .mini-spark-line { animation: none; stroke-dashoffset: 0; } }
      .mini-spark-axis-label { fill: var(--ink-faint); font-size: 9px; font-family: ui-monospace, monospace; }
      .single-point-note {
        margin: 8px 0 0; padding: 8px 10px; font-size: 12px; color: var(--ink-faint);
        background: color-mix(in srgb, var(--t-pop) 6%, transparent);
        border-radius: 3px;
      }
      .mini-sentence { font-style: italic; font-size: 13px; color: var(--ink-muted); margin: 8px 0 0; }
      .bar-label { font-family: ui-monospace, monospace; font-size: 10.5px; fill: var(--ink-muted); }
      .bar-value { font-family: ui-monospace, monospace; font-size: 10.5px; fill: var(--ink); font-weight: 600; }
      .bar-rect {
        fill: var(--t-pop);
        transition: opacity 0.15s ease;
      }
      .bar-row:hover .bar-rect { opacity: 0.75; }
      .bar-row:hover .bar-label { fill: var(--t-pop); }
      .legend-note {
        font-family: ui-monospace, monospace; font-size: 11.5px; color: var(--ink-faint);
        margin: 4px 0 18px; display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
      }
      .region-grid {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 24px; margin-top: 8px;
      }
      .region-block {
        background: var(--surface);
        border: 1px solid var(--line);
        border-left: 3px solid var(--region-accent, var(--ink-faint));
        border-radius: 3px;
        padding: 14px 16px 8px;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }
      .region-block:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 18px -12px color-mix(in srgb, var(--region-accent, var(--ink-faint)) 55%, transparent);
      }
      .region-block h3 {
        font-size: 12.5px; text-transform: uppercase; letter-spacing: 0.04em;
        color: var(--region-accent, var(--ink)); margin: 0 0 8px; font-weight: 600;
        display: flex; align-items: center; gap: 6px;
      }
      .region-dot {
        width: 7px; height: 7px; border-radius: 50%; flex: none;
        background: var(--region-accent, var(--ink-faint));
      }
      .region-block table { font-size: 13.5px; }
      .region-block td, .region-block th { padding: 5px 6px 5px 0; }
      table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
      th { text-align: left; font-size: 11px; text-transform: uppercase; color: var(--ink-faint);
           font-weight: 400; padding: 0 8px 6px 0; }
      th.num, td.num { text-align: right; }
      td { padding: 7px 8px 7px 0; border-top: 1px solid var(--line); }
      tbody tr { transition: background-color 0.12s ease; }
      tbody tr:hover { background: color-mix(in srgb, var(--t-pop) 6%, transparent); }
      .badge {
        display: inline-block; font-family: ui-monospace, monospace; font-size: 10px;
        padding: 2px 6px; border-radius: 2px; margin-left: 6px;
      }
      .badge.stale { background: var(--stale-soft); color: var(--stale); }
      .badge.estime { background: var(--ochre-soft); color: var(--ochre); }
      .badge.provisoire {
        background: color-mix(in srgb, var(--t-pop) 14%, var(--surface));
        color: var(--t-pop);
      }
      .national-figure {
        margin: 20px 0; padding: 18px 20px; background: var(--surface);
        border: 1px solid var(--line); border-left: 3px solid var(--t-pop); border-radius: 3px;
      }
      .national-value {
        font-family: ui-monospace, monospace; font-size: 2.1rem; font-weight: 600;
        color: var(--t-pop); display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap;
      }
      .national-value .unit {
        font-family: system-ui, sans-serif; font-size: 0.85rem; font-weight: 400; color: var(--ink-faint);
      }
      .national-meta { font-size: 12.5px; color: var(--ink-muted); margin-top: 4px; }
      .disclosure { margin-top: 12px; }
      .disclosure summary {
        cursor: pointer; font-family: ui-monospace, monospace; font-size: 12px; color: var(--t-pop);
        list-style: none; display: flex; align-items: center; gap: 6px;
      }
      .disclosure summary::-webkit-details-marker { display: none; }
      .disclosure summary::before { content: "▸"; font-size: 10px; transition: transform 0.15s ease; }
      .disclosure[open] summary::before { transform: rotate(90deg); }
      .disclosure-table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 12.5px; }
      .disclosure-table th {
        text-align: left; font-family: ui-monospace, monospace; font-size: 10px; text-transform: uppercase;
        color: var(--ink-faint); letter-spacing: 0.04em; padding: 0 10px 6px 0; font-weight: 400;
      }
      .disclosure-table td { padding: 7px 10px 7px 0; border-top: 1px solid var(--line); }
      .disclosure-table td.num { font-family: ui-monospace, monospace; }
      .disclosure-note { font-size: 11.5px; color: var(--ink-faint); margin: 10px 0 0; max-width: 64ch; }
      .sexe-split { margin-top: 16px; max-width: 420px; }
      .sexe-bar { display: flex; height: 10px; border-radius: 2px; overflow: hidden; }
      .sexe-hommes { background: var(--t-pop); }
      .sexe-femmes { background: var(--ochre); }
      .sexe-labels { display: flex; justify-content: space-between; gap: 12px; font-size: 12px; color: var(--ink-muted); margin-top: 5px; }
      footer {
        margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line);
        font-size: 12px; color: var(--ink-faint);
      }
      footer a { color: var(--ink-muted); }
      .site-nav { display: flex; gap: 14px; margin-top: 14px; flex-wrap: wrap; }
      .site-nav a { color: var(--t-pop); font-size: 12.5px; transition: opacity 0.15s ease; }
      .site-nav a:hover { opacity: 0.7; }
      .gap-note {
        margin-top: 24px; font-style: italic; color: var(--ink-muted); font-size: 13.5px;
        border-left: 3px solid var(--ink-faint); padding-left: 12px;
      }
      .prefecture-grid {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 22px; margin: 8px 0 4px;
      }
      .prefecture-block {
        background: var(--surface); border: 1px solid var(--line); border-radius: 3px;
        padding: 12px 14px;
      }
      .prefecture-block h3 {
        font-size: 12.5px; text-transform: uppercase; letter-spacing: 0.04em;
        color: var(--t-pop); margin: 0 0 8px; font-weight: 600;
      }
      .prefecture-block table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
      .prefecture-block th { text-align: right; font-size: 10px; color: var(--ink-faint); font-weight: 400; padding: 0 0 4px 6px; }
      .prefecture-block th:first-child { text-align: left; padding-left: 0; }
      .prefecture-block td { text-align: right; padding: 3px 0 3px 6px; border-top: 1px solid var(--line); font-size: 12.5px; }
      .prefecture-block td:first-child { text-align: left; color: var(--ink-muted); }
      .sentence {
        font-style: italic; font-size: 17px; line-height: 1.5; color: var(--ink);
        border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
        border-left: 3px solid var(--t-pop);
        padding: 14px 0 14px 14px; margin: 20px 0;
      }
      @keyframes growBar { from { transform: scaleX(0); } to { transform: scaleX(1); } }
      .bar-rect { transform-origin: left; animation: growBar 0.6s ease-out backwards; }
      @media (prefers-reduced-motion: reduce) {
        .bar-rect { animation: none; }
      }
    </style>
  </head>
  <body>
    <SiteNav />
    <main id="main-content">
      <div class="crumb"><a href="/">République centrafricaine</a></div>
      <h1>Population</h1>
      <p class="lede">
        Recensements et projections de la population, du niveau national
        jusqu'à la sous-préfecture : les résultats provisoires du 4ᵉ
        recensement (RGPH-4) et leur répartition par sexe, une
        comparaison par préfecture entre le recensement de 2003 (RGPH-3),
        l'estimation de 2021 et la projection de 2025, ainsi que des
        indicateurs démographiques complémentaires (urbanisation,
        dépendance, enregistrement des naissances, mariage précoce).
      </p>

      <nav class="section-nav" aria-label="Sections de la page">
        <a href="#classement">Classement des préfectures, 2021</a>
        <a href="#par-region">Population par région</a>
        <a href="#autres-indicateurs">Autres indicateurs démographiques</a>
      </nav>

      <div class="national-figure">
        <div class="national-value">
          {fmt(Math.round(national.headline.value))}
          <span class="unit">habitants</span>
          <span class="badge provisoire">provisoire</span>
        </div>
        <p class="national-meta">{data.definition_fr}</p>
        <div class="national-meta">
          {national.headline.producer} - {national.headline.dataset_name}, {national.headline.period}
        </div>
        <details class="disclosure">
          <summary>{distinctSources.length} sources - écart de {national.spread_pct}% avec l'estimation la plus récente</summary>
          <table class="disclosure-table">
            <thead>
              <tr><th scope="col">Valeur</th><th scope="col">Producteur</th><th scope="col">Période</th><th scope="col">Statut</th></tr>
            </thead>
            <tbody>
              {national.all_sources.map((s) => (
                <tr>
                  <td class="num">{fmt(Math.round(s.value))}</td>
                  <td>{s.producer}</td>
                  <td>{s.period}</td>
                  <td><span class={`badge ${s.quality_flag}`}>{s.quality_flag}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="disclosure-note">
            Écart calculé entre le chiffre retenu par défaut (recensement, {national.headline.period})
            et l'estimation la plus récente d'une autre source ({national.spread_vs_period}).
            Classement d'autorité : recensement national &gt; enquête nationale &gt;
            estimation modélisée internationale - voir <a href="/methode/#classement">Méthode</a>.
          </p>
        </details>
        <div class="sexe-split">
          <div class="sexe-bar">
            <div class="sexe-hommes" style={`width: ${data.repartition_sexe.hommes_pct}%`}></div>
            <div class="sexe-femmes" style={`width: ${data.repartition_sexe.femmes_pct}%`}></div>
          </div>
          <div class="sexe-labels">
            <span>Hommes - {fmtDecimal(data.repartition_sexe.hommes_pct)}% ({fmt(data.repartition_sexe.hommes)})</span>
            <span>Femmes - {fmtDecimal(data.repartition_sexe.femmes_pct)}% ({fmt(data.repartition_sexe.femmes)})</span>
          </div>
        </div>
      </div>

      <p class="sentence">
        {data.lead_sentence}
      </p>

      <h2 id="classement">Classement des préfectures, 2021</h2>
      <svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} role="img" aria-label="Population par préfecture, estimation 2021, classée par ordre décroissant">
        {ranked.map((row, i) => (
          <g class="bar-row" transform={`translate(0, ${i * ROW_H})`}>
            <text class="bar-label" x={MARGIN_L - 8} y={ROW_H / 2 + 4} text-anchor="end">{row.prefecture}</text>
            <rect
              class="bar-rect"
              x={MARGIN_L}
              y={4}
              width={barWidth(row.pop_2021)}
              height={ROW_H - 8}
              style={`animation-delay: ${i * 25}ms`}
            />
            <text class="bar-value" x={MARGIN_L + barWidth(row.pop_2021) + 6} y={ROW_H / 2 + 4}>
              {fmt(row.pop_2021)}
            </text>
          </g>
        ))}
      </svg>

      <h2 id="par-region">Population par région</h2>
      <p class="legend-note">
        Dans les tableaux ci-dessous : <span class="badge stale">2003</span> = recensement, ancien -
        <span class="badge estime">2021</span> et <span class="badge estime">2025</span> = estimations.
        Voir la note ci-dessus pour le détail.
      </p>
      <div class="region-grid">
        {regions.map((region) => (
          <div class="region-block" style={`--region-accent: ${REGION_COLORS[region] ?? "var(--ink-faint)"}`}>
            <h3><span class="region-dot"></span>{region}</h3>
            <table>
              <thead>
                <tr>
                  <th scope="col">Préfecture</th>
                  <th scope="col" class="num">2003</th>
                  <th scope="col" class="num">2021</th>
                  <th scope="col" class="num">2025</th>
                </tr>
              </thead>
              <tbody>
                {byRegion.get(region)!.map((row) => (
                  <tr>
                    <td>{row.prefecture}</td>
                    <td class="num">{fmt(row.pop_2003)}</td>
                    <td class="num">{fmt(row.pop_2021)}</td>
                    <td class="num">{fmt(row.pop_2025)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}
      </div>

      <p class="gap-note">
        Non montré ici : le découpage interne de Bangui (arrondissements,
        Bimbo, Bégoua) fait l'objet d'un désaccord réel entre trois sources -
        voir <code>docs/verification-debt.md</code>.
      </p>

      <details class="section-toggle">
        <summary>Par sous-préfecture</summary>
        <p class="legend-note">
          Projection ICASEES 2025 (cycle HNRP), la plus fine profondeur géographique
          disponible pour cet indicateur - 85 sous-préfectures, groupées par préfecture.
        </p>
        <div class="prefecture-grid">
          {data.prefectures.map((p) => (
            <div class="prefecture-block">
              <h3>{p.prefecture}</h3>
              <table>
                <thead>
                  <tr><th scope="col">Sous-préfecture</th><th scope="col">2025</th></tr>
                </thead>
                <tbody>
                  {p.sous_prefectures.map((sp: any) => (
                    <tr>
                      <td>{sp.name_fr}</td>
                      <td>{fmt(sp.pop_2025)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
        </div>
      </details>

      <h2 id="autres-indicateurs">Autres indicateurs démographiques</h2>
      <div class="indicator-grid">
        {data.other_indicators.map((ind) => {
          const spark = sparkline(ind);
          return (
            <div class="indicator-card">
              <p class="ind-name">{ind.name_fr}</p>
              <p class="ind-definition">{ind.definition_fr}</p>
              <p class="ind-value">{fmt(Math.round(ind.latest.value * 10) / 10)}<span class="unit">%, {ind.latest.period}</span></p>
              {ind.series.length > 1 ? (
                <svg class="mini-sparkline" viewBox={`0 0 ${SPARK_W} ${SPARK_H}`} role="img" aria-label={`${ind.name_fr}, ${spark.firstYear} à ${spark.lastYear}`}>
                  <polyline class="mini-spark-line" points={spark.points} />
                  <text class="mini-spark-axis-label" x={spark.xFirst} y={SPARK_H - 4} text-anchor="start">{spark.firstYear}</text>
                  <text class="mini-spark-axis-label" x={spark.xLast} y={SPARK_H - 4} text-anchor="end">{spark.lastYear}</text>
                </svg>
              ) : (
                <p class="single-point-note">Une seule mesure disponible ({ind.latest.period}) - pas d'évolution à montrer.</p>
              )}
              <p class="mini-sentence">{ind.lead_sentence}</p>
              <span style="font-size:11px;color:var(--ink-faint);display:block;margin-top:6px;">
                {ind.source.producer}. Récupéré le {ind.source.retrieved_at}.
              </span>
            </div>
          );
        })}
      </div>

      <h2 id="non-mesure">Ce qui n'est pas mesuré</h2>
      <ul class="not-measured">
        <li>Rien au niveau commune ou localité : COD-AB v02, la source de référence pour la géographie de ce projet, ne publie rien de plus fin que la sous-préfecture.</li>
        <li>Aucune structure par âge (pyramide des âges) - seule la répartition par sexe est disponible pour l'instant.</li>
        <li>Fécondité, mortalité et migration ne sont pas couvertes par ce thème ; l'espérance de vie figure sur la page <a href="/sante/">Santé</a>.</li>
        <li>Au niveau sous-préfecture, seule la population totale (projection 2025) est disponible - urbanisation, dépendance démographique, enregistrement des naissances et mariage précoce restent au niveau national.</li>
      </ul>

      <footer>
        Source : {data.source.producer} - {data.source.dataset_name}.
        Récupéré le {data.source.retrieved_at}.
        <a href={data.source.url}>{data.source.url}</a>
        <nav class="site-nav">
          <a href="/population/">Population</a>
          <a href="/infrastructures/">Infrastructures</a>
          <a href="/education/">Éducation</a>
          <a href="/sante/">Santé</a>
          <a href="/economie/">Économie</a>
          <a href="/sources/">Sources</a>
          <a href="/methode/">Méthode</a>
          <a href="/donnees/">Données</a>
          <a href="/a-propos/">À propos</a>
        </nav>
      </footer>
    </main>
  </body>
</html>
