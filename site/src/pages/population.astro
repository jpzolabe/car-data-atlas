---
// First real content page — Phase 2. Reads a build-time JSON artifact
// materialized by pipeline/export_population_json.py (data/observations.csv ->
// DuckDB join -> JSON). Astro never parses the raw CSVs itself — see
// docs/decisions.md.
import data from "../data/population.json";

const byRegion = new Map<string, typeof data.prefectures>();
for (const row of data.prefectures) {
  if (!byRegion.has(row.region)) byRegion.set(row.region, []);
  byRegion.get(row.region)!.push(row);
}
const regions = [...byRegion.keys()].sort();

const fmt = (n: number) => n.toLocaleString("fr-FR");
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Population par préfecture — Données RCA</title>
    <style>
      :root {
        --paper: #EDEEE6;
        --surface: #F8F8F2;
        --ink: #1B2420;
        --ink-muted: #5A6259;
        --ink-faint: #8B9188;
        --line: #D6D7C9;
        --indigo: #2A56A8;
        --stale: #AC3A1E;
        --stale-soft: #F1DFD2;
        --ochre: #B8790F;
        --ochre-soft: #F1E3C6;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: system-ui, sans-serif;
        font-size: 15px;
        line-height: 1.5;
      }
      main { max-width: 760px; margin: 0 auto; padding: 32px 24px 80px; }
      .crumb {
        font-family: ui-monospace, monospace; font-size: 11px; text-transform: uppercase;
        letter-spacing: .05em; color: var(--ink-faint); margin-bottom: 6px;
      }
      .crumb a { color: var(--ink-faint); text-decoration: none; }
      .crumb a:hover { color: var(--indigo); text-decoration: underline; }
      h1 { font-size: 1.8rem; margin: 0 0 8px; }
      .lede { color: var(--ink-muted); max-width: 60ch; margin: 0 0 24px; }
      h2 {
        font-size: 0.85rem; text-transform: uppercase; letter-spacing: .05em;
        color: var(--ink-faint); font-weight: 600; margin: 32px 0 8px;
        border-bottom: 1px solid var(--line); padding-bottom: 6px;
      }
      table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
      th { text-align: left; font-size: 11px; text-transform: uppercase; color: var(--ink-faint);
           font-weight: 400; padding: 0 8px 6px 0; }
      th.num, td.num { text-align: right; }
      td { padding: 7px 8px 7px 0; border-top: 1px solid var(--line); }
      .badge {
        display: inline-block; font-family: ui-monospace, monospace; font-size: 10px;
        padding: 2px 6px; border-radius: 2px; margin-left: 6px;
      }
      .badge.stale { background: var(--stale-soft); color: var(--stale); }
      .badge.estime { background: var(--ochre-soft); color: var(--ochre); }
      footer {
        margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line);
        font-size: 12px; color: var(--ink-faint);
      }
      footer a { color: var(--ink-muted); }
      .site-nav { display: flex; gap: 14px; margin-top: 14px; }
      .site-nav a { color: var(--indigo); font-size: 12.5px; }
      .gap-note {
        margin-top: 24px; font-style: italic; color: var(--ink-muted); font-size: 13.5px;
        border-left: 3px solid var(--ink-faint); padding-left: 12px;
      }
      .sentence {
        font-style: italic; font-size: 17px; line-height: 1.5; color: var(--ink);
        border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
        padding: 14px 0; margin: 20px 0;
      }
      .sentence-tag {
        display: block; font-style: normal; font-family: ui-monospace, monospace;
        font-size: 10px; color: var(--ink-faint); text-transform: uppercase;
        letter-spacing: 0.05em; margin-top: 6px;
      }
    </style>
  </head>
  <body>
    <main>
      <div class="crumb"><a href="/">République centrafricaine</a></div>
      <h1>Population par préfecture</h1>
      <p class="lede">
        Deux séries : le recensement de 2003 (RGPH-3) et une estimation 2021.
        Aucune des deux n'est actuelle — voir les notes sur chaque colonne.
      </p>

      <p class="sentence">
        {data.lead_sentence}
        <span class="sentence-tag">phrase générée · gabarit {data.lead_sentence_template_id}</span>
      </p>

      {regions.map((region) => (
        <>
          <h2>Région {region}</h2>
          <table>
            <thead>
              <tr>
                <th>Préfecture</th>
                <th class="num">2003 (recensement)</th>
                <th class="num">2021 (estimation)</th>
              </tr>
            </thead>
            <tbody>
              {byRegion.get(region)!.map((row) => (
                <tr>
                  <td>{row.prefecture}</td>
                  <td class="num">
                    {fmt(row.pop_2003)}
                    <span class="badge stale">ancien</span>
                  </td>
                  <td class="num">
                    {fmt(row.pop_2021)}
                    <span class="badge estime">estimé</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </>
      ))}

      <p class="gap-note">
        Non montré ici : le découpage interne de Bangui (arrondissements,
        Bimbo, Bégoua) fait l'objet d'un désaccord réel entre trois sources —
        voir <code>docs/verification-debt.md</code>. Les données par
        sous-préfecture n'existent pas encore pour cet indicateur.
      </p>

      <footer>
        Source : {data.source.producer} — {data.source.dataset_name}.
        Récupéré le {data.source.retrieved_at}.
        <a href={data.source.url}>{data.source.url}</a>
        <nav class="site-nav">
          <a href="/prix/">Indice des prix</a>
          <a href="/sources/">Sources</a>
          <a href="/methode/">Méthode</a>
          <a href="/a-propos/">À propos</a>
        </nav>
      </footer>
    </main>
  </body>
</html>
