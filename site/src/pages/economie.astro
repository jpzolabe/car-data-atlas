---
// Second brand-new theme this pass (théme #6 of 7 in docs/plan.md's site
// map). Same anatomy as sante.astro: headline figure, categories ordered by
// logical sequence, "Ce qui n'est pas mesuré" hand-written.
//
// section-nav (added 2026-09-13): a sticky in-page jump menu, one link per
// category plus the agriculture/prix satellite cards and "Ce qui n'est pas
// mesuré" - lets a reader jump straight to a section instead of scrolling.
// Explicit request: categories themselves stay fully expanded, nothing gets
// collapsed - this is pure navigation. Zero JS: plain <a href="#id"> anchor
// links, position:sticky to stay visible under SiteNav's own fixed bar while
// scrolling. h2's scroll-margin-top accounts for both bars' combined height
// so a jump doesn't hide the heading underneath them.
//
// taux_croissance_pib (added 2026-09-12) is the one disclosure indicator on
// this page: ICASEES's rebased comptes nationaux disagree substantially
// with World Bank's modelled estimate for 2020-2021. Rendered via the
// "national" in ind check below, population.astro-style disclosure rather
// than education.astro's dual-line chart; simpler, and there are only 2
// years of overlap to show, not a long modelled series with survey points.
// Headline flipped 2026-09-13 to show World Bank's latest point rather than
// ICASEES's: on this page, current beats authoritative-but-stale for the
// default figure - see export_economie_json.py's build_croissance_disclosure
// and docs/decisions.md. ICASEES's figure is still fully shown, just in the
// disclosure table instead of as the default.
//
// Two indicators (pib_total, pib_par_habitant) are monetary (US$), not
// percentages like everything else on this page; formatValue() below
// branches on that rather than assuming every card is a "%".
//
// Reorganized 2026-09-12: prix and agriculture are full standalone theme
// pages (own URL) but conceptually both sit inside "the economy" the way
// most real economic dashboards treat them (IMF Article IV, World Bank
// country pages, Trading Economics all fold prices into the economy view;
// AGENTS.md's own original theme list literally said "agriculture et prix"
// as one theme before this session split them out). Rather than merge the
// pages or move URLs, prix.json/agriculture.json are imported here too,
// just for two brief summary cards with a link to the full page;
// presentation only, no data ownership change. économie is now the only
// one of the two still linked from the home page's top-level nav;
// agriculture and prix are reached through it (their footer cross-links on
// every other page are unchanged). Cards ordered agriculture then prix,
// injected right after whichever category renders first in data.categories
// (production, originally - moved to right after finances publiques on
// 2026-09-13 request, see the category.key check below and
// export_economie_json.py's CATEGORIES order). See docs/decisions.md.
import data from "../data/economie.json";
import prixData from "../data/prix.json";
import agricultureData from "../data/agriculture.json";
import ThemeInit from "../components/ThemeInit.astro";
import SiteNav from "../components/SiteNav.astro";

// Dataset structured data (schema.org/JSON-LD) - lets Google's
// Dataset Search index this theme's indicators as a dataset,
// separate from regular web search.
const datasetJsonLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "Économie - BêAfrîka Data",
  "description": "PIB, finances publiques, commerce extérieur et niveau de vie de la République centrafricaine, à l'échelle nationale, avec prix et agriculture en détail.",
  "url": "https://beafrikadata.com/economie/",
  "license": "https://creativecommons.org/licenses/by/4.0/legalcode",
  "creator": { "@type": "Organization", "name": "BêAfrîka Data", "url": "https://beafrikadata.com/" },
  "spatialCoverage": { "@type": "Place", "name": "République centrafricaine" },
  "inLanguage": "fr",
};

const CURRENT_YEAR = 2026;
function isStale(period: string): boolean {
  // indice_activite_economique's periods look like "2023-Q1" (quarterly);
  // taking the leading 4-digit year works for both that and every plain
  // "YYYY" annual period on this page. méthode.astro's own threshold
  // table: "< 5 ans" = actuel, "5 ans" = déjà ancien - so exactly 5
  // years old must already read as stale.
  return CURRENT_YEAR - Number(period.slice(0, 4)) >= 5;
}

const fmtPct = (n: number) => n.toLocaleString("fr-FR", { maximumFractionDigits: 1 });
// Trade-composition values (OEC/BACI) are all in the tens-to-low-hundreds
// of millions - same "M US$" shape as formatValue's MONTANT_INDICATORS
// branch below, but these indicator_ids don't go through that per-card
// dispatch since they're rendered as ranked lists, not indicator cards.
const fmtTradeUSD = (n: number) => `${(n / 1e6).toLocaleString("fr-FR", { maximumFractionDigits: 1 })} M US$`;

// Compact badge text - the raw quality_flag values ("enquete", "estime")
// are missing their accents.
function badgeLabel(flag: string): string {
  if (flag === "enquete") return "enquête";
  if (flag === "estime") return "estimé";
  if (flag === "osm") return "OSM";
  return flag;
}

const MONTANT_INDICATORS = new Set(["exportations_montant", "importations_montant", "dette_exterieure_montant"]);
const BUDGET_INDICATORS = new Set(["budget_ressources_totales", "budget_depenses_totales", "budget_solde_global"]);
// BOP/TOFE/PIB-par-secteur (BEAC) share the same "Md FCFA" display shape as
// BUDGET_INDICATORS - kept as separate sets rather than merged into it since
// they're different underlying concepts (balance-of-payments balances,
// budget execution, sector GDP) that just happen to format the same way.
const FCFA_MD_INDICATORS = new Set([
  "bop_solde_transactions_courantes", "bop_solde_biens", "bop_solde_services",
  "bop_besoin_financement_global", "tofe_recettes_totales_execution",
  "tofe_depenses_totales_execution", "tofe_solde_global_execution",
  "pib_secteur_primaire_fcfa", "pib_secteur_secondaire_fcfa", "pib_secteur_tertiaire_fcfa",
]);

function formatValue(indicatorId: string, value: number): { display: string; unit: string } {
  if (indicatorId === "pib_total") {
    return { display: (value / 1e9).toLocaleString("fr-FR", { maximumFractionDigits: 2 }), unit: " Md US$" };
  }
  if (indicatorId === "pib_par_habitant") {
    return { display: Math.round(value).toLocaleString("fr-FR"), unit: " US$" };
  }
  if (indicatorId === "pib_total_fcfa") {
    return { display: (value / 1e9).toLocaleString("fr-FR", { maximumFractionDigits: 1 }), unit: " Md FCFA" };
  }
  if (indicatorId === "pib_par_habitant_fcfa") {
    return { display: Math.round(value).toLocaleString("fr-FR"), unit: " FCFA" };
  }
  if (indicatorId === "indice_activite_economique") {
    return { display: value.toLocaleString("fr-FR", { maximumFractionDigits: 1 }), unit: " indice" };
  }
  if (BUDGET_INDICATORS.has(indicatorId) || FCFA_MD_INDICATORS.has(indicatorId)) {
    return { display: (value / 1e9).toLocaleString("fr-FR", { maximumFractionDigits: 2 }), unit: " Md FCFA" };
  }
  if (MONTANT_INDICATORS.has(indicatorId)) {
    return value >= 1e9
      ? { display: (value / 1e9).toLocaleString("fr-FR", { maximumFractionDigits: 2 }), unit: " Md US$" }
      : { display: (value / 1e6).toLocaleString("fr-FR", { maximumFractionDigits: 1 }), unit: " M US$" };
  }
  return { display: fmtPct(value), unit: "%" };
}

// Small build-time SVG sparkline, same technique as every other theme page.
const SPARK_W = 460, SPARK_H = 90, SPARK_ML = 40, SPARK_MR = 10, SPARK_MT = 10, SPARK_MB = 18;
function sparkline(
  ind: { series: { period: string; value: number }[] },
  projection: { period: string; value: number }[] = []
) {
  const s = ind.series;
  const totalLen = s.length + projection.length;
  const plotW = SPARK_W - SPARK_ML - SPARK_MR;
  const plotH = SPARK_H - SPARK_MT - SPARK_MB;
  const vals = [...s.map((d) => d.value), ...projection.map((d) => d.value)];
  const sMin = Math.min(...vals) * 0.9;
  const sMax = Math.max(...vals) * 1.1;
  const sx = (i: number) => SPARK_ML + (i / Math.max(totalLen - 1, 1)) * plotW;
  const sy = (v: number) => SPARK_MT + plotH - ((v - sMin) / (sMax - sMin)) * plotH;
  const points = s.map((d, i) => `${sx(i).toFixed(1)},${sy(d.value).toFixed(1)}`).join(" ");
  // Hover targets: one per data point, native <title> tooltip - no chart
  // library or client JS needed (AGENTS.md's zero-JS budget for charts).
  // See docs/decisions.md.
  const hoverPoints = s.map((d, i) => ({ cx: sx(i), cy: sy(d.value), period: d.period, value: d.value }));
  // One or two intermediate year labels (roughly a third and two-thirds of
  // the way through) - user feedback, only first/last year were labelled.
  const midLabels = [...new Set([
    Math.round((s.length - 1) / 3),
    Math.round((s.length - 1) * 2 / 3),
  ])]
    .filter((i) => i > 0 && i < s.length - 1)
    .map((i) => ({ x: sx(i), year: s[i].period }));

  // Projection (if any): a dashed continuation from the last actual point
  // through each projected point, same scale as the rest of the chart -
  // visually a future extension, not another historical observation.
  let projectionPoints = "";
  let projectionHoverPoints: { cx: number; cy: number; period: string; value: number }[] = [];
  if (projection.length > 0) {
    const lastActual = { x: sx(s.length - 1), y: sy(s[s.length - 1].value) };
    const projCoords = projection.map((d, i) => ({
      x: sx(s.length + i), y: sy(d.value), period: d.period, value: d.value,
    }));
    projectionPoints = [lastActual, ...projCoords]
      .map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(" ");
    projectionHoverPoints = projCoords;
  }

  return {
    points, hoverPoints, midLabels, firstYear: s[0].period,
    lastYear: projection.length > 0 ? projection[projection.length - 1].period : s[s.length - 1].period,
    xFirst: sx(0), xLast: sx(totalLen - 1),
    projectionPoints, projectionHoverPoints,
  };
}

const headlineValue = formatValue("pib_par_habitant", data.headline.latest.value);
---
<!doctype html>
<html lang="fr">
  <head>
    <ThemeInit />
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Économie - BêAfrîka Data</title>
    <meta name="description" content="PIB, finances publiques, commerce extérieur et niveau de vie de la République centrafricaine, à l'échelle nationale, avec prix et agriculture en détail." />
    <link rel="canonical" href="https://beafrikadata.com/economie/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BêAfrîka Data" />
    <meta property="og:title" content="Économie - BêAfrîka Data" />
    <meta property="og:description" content="PIB, finances publiques, commerce extérieur et niveau de vie de la République centrafricaine, à l'échelle nationale, avec prix et agriculture en détail." />
    <meta property="og:url" content="https://beafrikadata.com/economie/" />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Économie - BêAfrîka Data" />
    <meta name="twitter:description" content="PIB, finances publiques, commerce extérieur et niveau de vie de la République centrafricaine, à l'échelle nationale, avec prix et agriculture en détail." />
    <script type="application/ld+json" set:html={JSON.stringify(datasetJsonLd)} />
    <style>
      @font-face {
        font-family: "IBM Plex Sans";
        src: url("/fonts/ibm-plex-sans-variable.woff2") format("woff2");
        font-weight: 400 700;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "IBM Plex Mono";
        src: url("/fonts/ibm-plex-mono-400.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "IBM Plex Mono";
        src: url("/fonts/ibm-plex-mono-700.woff2") format("woff2");
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
      :root {
        --paper: #23251F; --surface: #2B2E27; --ink: #E8E6DA; --ink-muted: #A6A895;
        --ink-faint: #8C8F7F; --line: #33362A;
        --t-eco: #7FB4C4;
        --stale: #E2694A; --stale-soft: #3A211A;
        --ochre: #E0A83D; --ochre-soft: #3A2E12;
      }
      :root[data-theme="light"] {
        --paper: #EDEEE6; --surface: #F8F8F2; --ink: #1B2420; --ink-muted: #5A6259;
        --ink-faint: #8B9188; --line: #D6D7C9;
        --t-eco: #3D6373;
        --stale: #AC3A1E; --stale-soft: #F6DCD5;
        --ochre: #8C5A0C; --ochre-soft: #F1E3C6;
      }
      @media print {
        :root {
        --paper: #EDEEE6; --surface: #F8F8F2; --ink: #1B2420; --ink-muted: #5A6259;
        --ink-faint: #8B9188; --line: #D6D7C9;
        --t-eco: #3D6373;
        --stale: #AC3A1E; --stale-soft: #F6DCD5;
        --ochre: #8C5A0C; --ochre-soft: #F1E3C6;
      }
        body { background: #fff !important; background-image: none !important; }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background-color: var(--paper);
        background-image:
          radial-gradient(1000px 520px at 10% -10%, color-mix(in srgb, var(--t-eco) 9%, transparent), transparent 60%),
          radial-gradient(700px 420px at 100% 100%, color-mix(in srgb, var(--t-eco) 6%, transparent), transparent 60%);
        background-attachment: fixed;
        color: var(--ink); font-family: "IBM Plex Sans", system-ui, sans-serif; font-size: 15px; line-height: 1.5;
      }
      main { max-width: 1080px; margin: 0 auto; padding: 84px 24px 80px; }
      h1 {
        font-size: 1.8rem; margin: 0 0 8px; display: inline-block;
        border-bottom: 3px solid var(--t-eco); padding-bottom: 4px;
      }
      .lede { color: var(--ink-muted); margin: 12px 0 8px; }
      .section-nav {
        position: sticky; top: 54px; z-index: 40;
        display: flex; gap: 6px; flex-wrap: wrap;
        padding: 10px 0; margin: 0 0 20px;
        background: color-mix(in srgb, var(--paper) 92%, transparent);
        backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
        border-bottom: 1px solid var(--line);
      }
      .section-nav a {
        font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.03em;
        color: var(--ink-muted); text-decoration: none; white-space: nowrap;
        padding: 5px 10px; border-radius: 3px; border: 1px solid var(--line); background: var(--surface);
        transition: color 0.15s ease, border-color 0.15s ease;
      }
      .section-nav a:hover { color: var(--t-eco); border-color: var(--t-eco); }
      .headline-block {
        margin: 0 0 35px; padding: 23px 25px; background: var(--surface);
        border: 1px solid var(--line); border-left: 4px solid var(--t-eco); border-radius: 3px;
      }
      .headline-value {
        font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 2.6rem; font-weight: 600;
        color: var(--t-eco); display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
      }
      .headline-value .unit { font-size: 1.1rem; color: var(--ink-faint); font-family: "IBM Plex Sans", system-ui, sans-serif; margin-left: 6px; }
      .headline-caption { color: var(--ink-muted); font-size: 13.5px; margin: 4px 0 0; }
      h2 { font-size: 1.15rem; margin: 43px 0 13px; padding-top: 19px; border-top: 1px solid var(--line); scroll-margin-top: 104px; }
      .category-note { font-size: 13px; color: var(--ink-muted); margin: 0 0 12px; }
      .category-note a { color: var(--t-eco); }
      .satellite-card {
        background: var(--surface); border: 1px dashed var(--line); border-radius: 3px;
        padding: 17px 19px; max-width: 640px;
      }
      .satellite-card .ind-value {
        font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 1.3rem; font-weight: 600;
        color: var(--t-eco);
      }
      .satellite-card .ind-value .unit { font-size: 0.75rem; color: var(--ink-faint); font-family: "IBM Plex Sans", system-ui, sans-serif; font-weight: 400; margin-left: 6px; }
      .satellite-link { display: inline-block; margin-top: 10px; font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 12px; color: var(--t-eco); }
      .trade-composition-grid {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
        gap: 26px; margin-top: 4px;
      }
      .trade-list h3 { font-size: 13px; margin: 0 0 10px; color: var(--ink-muted); font-weight: 600; }
      .rank-list { list-style: none; margin: 0; padding: 0; }
      .rank-list li { margin-bottom: 12px; }
      .rank-row { display: flex; justify-content: space-between; gap: 10px; font-size: 13px; margin-bottom: 4px; }
      .rank-label { color: var(--ink); flex: 1 1 auto; min-width: 0; }
      .rank-value { font-family: "IBM Plex Mono", ui-monospace, monospace; color: var(--t-eco); white-space: nowrap; }
      .rank-bar-track { background: var(--line); border-radius: 2px; height: 6px; overflow: hidden; }
      .rank-bar-fill { background: var(--t-eco); height: 100%; border-radius: 2px 0 0 2px; }
      .badge {
        display: inline-block; font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 10.5px;
        padding: 2px 6px; border-radius: 2px; margin-left: 6px; vertical-align: middle;
      }
      .badge.stale { background: var(--stale-soft); color: var(--stale); }
      .badge.estime { background: var(--ochre-soft); color: var(--ochre); }
      .badge.administratif { background: color-mix(in srgb, var(--t-eco) 14%, var(--surface)); color: var(--t-eco); }
      .national-figure {
        margin: 0; padding: 17px 19px; background: var(--surface);
        border: 1px solid var(--line); border-left: 3px solid var(--t-eco); border-radius: 3px;
      }
      .national-value {
        font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 1.5rem; font-weight: 600;
        color: var(--t-eco); display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap;
      }
      .national-value .unit { font-family: "IBM Plex Sans", system-ui, sans-serif; font-size: 0.75rem; font-weight: 400; color: var(--ink-faint); margin-left: 6px; }
      .national-meta { font-size: 11px; color: var(--ink-faint); margin-top: 4px; }
      .disclosure { margin-top: 10px; }
      .disclosure summary {
        cursor: pointer; font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 11.5px; color: var(--t-eco);
        list-style: none; display: flex; align-items: center; gap: 6px;
      }
      .disclosure summary::-webkit-details-marker { display: none; }
      .disclosure summary::before { content: "▸"; font-size: 10px; transition: transform 0.15s ease; }
      .disclosure[open] summary::before { transform: rotate(90deg); }
      .disclosure-table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 12px; }
      .disclosure-table th {
        text-align: left; font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 9.5px; text-transform: uppercase;
        color: var(--ink-faint); letter-spacing: 0.04em; padding: 0 10px 6px 0; font-weight: 400;
      }
      .disclosure-table td { padding: 6px 10px 6px 0; border-top: 1px solid var(--line); }
      .disclosure-table td.num { font-family: "IBM Plex Mono", ui-monospace, monospace; }
      .disclosure-note { font-size: 11px; color: var(--ink-faint); margin: 8px 0 0; max-width: 64ch; }
      .indicator-grid {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(min(440px, 100%), 1fr));
        gap: 25px;
      }
      .indicator-card {
        background: var(--surface); border: 1px solid var(--line); border-radius: 3px;
        padding: 17px 19px;
      }
      .indicator-card .ind-name { font-size: 1rem; font-weight: 600; margin: 0 0 4px; }
      .indicator-card .ind-definition { font-size: 12.5px; color: var(--ink-muted); line-height: 1.5; margin: 0 0 8px; }
      .indicator-card .ind-value {
        font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 1.5rem; font-weight: 600;
        color: var(--t-eco); display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap;
      }
      .indicator-card .ind-value .unit { font-size: 0.75rem; color: var(--ink-faint); font-family: "IBM Plex Sans", system-ui, sans-serif; font-weight: 400; margin-left: 6px; }
      svg.mini-sparkline { width: 100%; height: auto; display: block; margin-top: 8px; }
      .hover-pt { fill: transparent; pointer-events: all; }
      .hover-pt:hover { fill: var(--t-eco); }
      .mini-spark-line {
        stroke: var(--t-eco); stroke-width: 2; fill: none;
        stroke-dasharray: 2000; stroke-dashoffset: 2000;
        animation: drawMiniSpark 1.1s ease-out forwards;
      }
      @keyframes drawMiniSpark { to { stroke-dashoffset: 0; } }
      @media (prefers-reduced-motion: reduce) { .mini-spark-line { animation: none; stroke-dashoffset: 0; } }
      .mini-spark-projection { stroke: var(--t-eco); stroke-width: 2; fill: none; stroke-dasharray: 4 3; opacity: 0.6; }
      .mini-spark-axis-label { fill: var(--ink-faint); font-size: 9px; font-family: "IBM Plex Mono", ui-monospace, monospace; }
      .single-point-note {
        margin: 8px 0 0; padding: 8px 10px; font-size: 12px; color: var(--ink-faint);
        background: color-mix(in srgb, var(--t-eco) 6%, transparent);
        border-radius: 3px;
      }
      .mini-sentence { font-style: italic; font-size: 13px; color: var(--ink-muted); margin: 8px 0 0; }
      .not-measured { margin: 14px 0 0; padding-left: 20px; color: var(--ink-muted); font-size: 14px; line-height: 1.7; }
      .not-measured li { margin-bottom: 4px; }
      footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 12px; color: var(--ink-faint); text-align: center; }
      footer a { color: var(--ink-muted); }
      .site-nav { display: flex; gap: 14px; margin-top: 14px; flex-wrap: wrap; justify-content: center; }
      .site-nav a { color: var(--t-eco); font-size: 12.5px; transition: opacity 0.15s ease; }
      .site-nav a:hover { opacity: 0.7; }
      a:focus-visible, summary:focus-visible, button:focus-visible {
        outline: 2px solid var(--ink-faint); outline-offset: 2px; border-radius: 2px;
      }
    </style>
  </head>
  <body>
    <SiteNav />
    <main id="main-content" data-pagefind-filter="theme:Économie">
      <h1>Économie</h1>
      <p class="lede">
        La production économique, les finances publiques, le commerce extérieur et
        le niveau de vie, à partir des données de la Banque mondiale
        portant sur l'ensemble du pays (aucune ventilation par région ou
        préfecture). Prix et agriculture, deux thèmes complets à part
        entière, sont résumés plus bas avec un lien vers leur page
        dédiée.
      </p>

      <nav class="section-nav" aria-label="Sections de la page">
        {data.categories.map((category) => (
          <>
            <a href={`#${category.key}`}>{category.label_fr}</a>
            {category.key === "finances_publiques" && (
              <>
                <a href="#secteur-agricole">Secteur agricole</a>
                <a href="#prix">Prix</a>
              </>
            )}
            {category.key === "commerce" && (
              <a href="#composition-commerce">Composition</a>
            )}
          </>
        ))}
      </nav>

      <div class="headline-block">
        <div class="headline-value">
          {headlineValue.display}<span class="unit">{headlineValue.unit}/habitant, {data.headline.latest.period}</span>
        </div>
        <p class="headline-caption">Le PIB par habitant est le chiffre le plus souvent cité pour résumer le niveau de richesse d'un pays.</p>
        <p class="headline-caption">{data.headline.definition_fr}</p>
        <p class="mini-sentence">
          {data.headline.lead_sentence}
        </p>
      </div>

      {data.categories.map((category) => (
        <>
          <h2 id={category.key}>{category.label_fr}</h2>
          <div class="indicator-grid">
            {category.indicators.map((ind) => {
              const spark = sparkline(ind, ind.projection ?? []);
              const stale = isStale(ind.latest.period);
              const val = formatValue(ind.indicator_id, ind.latest.value);

              if ("national" in ind) {
                const fmtRate = (n: number) => n.toLocaleString("fr-FR", { maximumFractionDigits: 2 });
                return (
                  <div class="indicator-card">
                    <h3 class="ind-name" id={ind.indicator_id}>{ind.name_fr}</h3>
                    <p class="ind-definition">{ind.definition_fr}</p>
                    <div class="national-figure">
                      <div class="national-value">
                        {fmtRate(ind.national.headline.value)}<span class="unit">%, {ind.national.headline.period}</span>
                        <span class={`badge ${ind.national.headline.quality_flag}`}>{badgeLabel(ind.national.headline.quality_flag)}</span>
                      </div>
                      <div class="national-meta">
                        {ind.national.headline.producer} - {ind.national.headline.dataset_name}
                      </div>
                      <details class="disclosure">
                        <summary>{ind.national.all_sources.length} sources - la donnée administrative de {ind.national.spread_vs_period} diffère de {fmtPct(ind.national.spread_pct)}% de l'estimation modélisée de la même année</summary>
                        <table class="disclosure-table">
                          <thead><tr><th scope="col">Valeur</th><th scope="col">Producteur</th><th scope="col">Période</th><th scope="col">Statut</th></tr></thead>
                          <tbody>
                            {ind.national.all_sources.map((s) => (
                              <tr>
                                <td class="num">{fmtRate(s.value)}%</td>
                                <td>{s.producer}</td>
                                <td>{s.period}</td>
                                <td><span class={`badge ${s.quality_flag}`}>{badgeLabel(s.quality_flag)}</span></td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                        <p class="disclosure-note">
                          La figure ci-dessus est la plus récente disponible, pas
                          nécessairement la plus autorisée : classement d'autorité, donnée
                          administrative nationale &gt; estimation modélisée internationale
                          - voir <a href="/methode/#classement">Méthode</a>. L'ICASEES
                          n'a pas encore republié de comptes nationaux au-delà de 2021 ;
                          en attendant, cette page affiche l'estimation la plus actuelle
                          de la Banque mondiale plutôt que la dernière donnée
                          administrative.
                        </p>
                      </details>
                    </div>
                    <svg class="mini-sparkline" viewBox={`0 0 ${SPARK_W} ${SPARK_H}`} role="img" aria-label={`${ind.name_fr}, ${spark.firstYear} à ${spark.lastYear}`}>
                      <polyline class="mini-spark-line" points={spark.points} />
                      {spark.projectionPoints && (
                        <polyline class="mini-spark-projection" points={spark.projectionPoints} />
                      )}
                      <text class="mini-spark-axis-label" x={spark.xFirst} y={SPARK_H - 4} text-anchor="start">{spark.firstYear}</text>
                      {spark.midLabels.map((m) => (
                        <text class="mini-spark-axis-label" x={m.x} y={SPARK_H - 4} text-anchor="middle">{m.year}</text>
                      ))}
                      <text class="mini-spark-axis-label" x={spark.xLast} y={SPARK_H - 4} text-anchor="end">{spark.lastYear}</text>
                      {spark.hoverPoints.map((p) => {
                        const pv = formatValue(ind.indicator_id, p.value);
                        return (
                          <circle class="hover-pt" cx={p.cx} cy={p.cy} r="4">
                            <title>{p.period} : {pv.display}{pv.unit}</title>
                          </circle>
                        );
                      })}
                      {spark.projectionHoverPoints.map((p) => {
                        const pv = formatValue(ind.indicator_id, p.value);
                        return (
                          <circle class="hover-pt hover-pt-projection" cx={p.cx} cy={p.cy} r="4">
                            <title>{p.period} : {pv.display}{pv.unit} (projection AfDB)</title>
                          </circle>
                        );
                      })}
                    </svg>
                    <p class="mini-sentence">{ind.lead_sentence}</p>
                    <span style="font-size:11px;color:var(--ink-faint);display:block;margin-top:6px;">
                      Graphique : {ind.source.producer} (série complète). Récupéré le {ind.source.retrieved_at}.
                      {ind.projection && ind.projection.length > 0 && (
                        <>
                          {" "}Pointillés : projection {ind.projection_source.producer} ({ind.projection.map((p) => `${p.period} : ${formatValue(ind.indicator_id, p.value).display}%`).join(", ")}).
                        </>
                      )}
                    </span>
                  </div>
                );
              }

              return (
                <div class="indicator-card">
                  <h3 class="ind-name" id={ind.indicator_id}>{ind.name_fr}</h3>
                  <p class="ind-definition">{ind.definition_fr}</p>
                  <div class="ind-value">
                    {val.display}<span class="unit">{val.unit}, {ind.latest.period}</span>
                    {stale && <span class="badge stale">ancien</span>}
                  </div>
                  {ind.series.length > 1 ? (
                    <svg class="mini-sparkline" viewBox={`0 0 ${SPARK_W} ${SPARK_H}`} role="img" aria-label={`${ind.name_fr}, ${spark.firstYear} à ${spark.lastYear}`}>
                      <polyline class="mini-spark-line" points={spark.points} />
                      <text class="mini-spark-axis-label" x={spark.xFirst} y={SPARK_H - 4} text-anchor="start">{spark.firstYear}</text>
                      {spark.midLabels.map((m) => (
                        <text class="mini-spark-axis-label" x={m.x} y={SPARK_H - 4} text-anchor="middle">{m.year}</text>
                      ))}
                      <text class="mini-spark-axis-label" x={spark.xLast} y={SPARK_H - 4} text-anchor="end">{spark.lastYear}</text>
                      {spark.hoverPoints.map((p) => {
                        const pv = formatValue(ind.indicator_id, p.value);
                        return (
                          <circle class="hover-pt" cx={p.cx} cy={p.cy} r="4">
                            <title>{p.period} : {pv.display}{pv.unit}</title>
                          </circle>
                        );
                      })}
                    </svg>
                  ) : (
                    <p class="single-point-note">Une seule mesure disponible ({ind.latest.period}) - pas d'évolution à montrer.</p>
                  )}
                  <p class="mini-sentence">{ind.lead_sentence}</p>
                  <span style="font-size:11px;color:var(--ink-faint);display:block;margin-top:6px;">
                    {ind.source.producer}. Récupéré le {ind.source.retrieved_at}.
                  </span>
                </div>
              );
            })}
          </div>

          {category.key === "finances_publiques" && (
            <>
              <h2 id="secteur-agricole">Secteur agricole</h2>
              <p class="category-note">
                L'agriculture représente une part importante de l'économie et de l'emploi en République centrafricaine.
              </p>
              <div class="satellite-card">
                <div class="ind-value">
                  {fmtPct(agricultureData.headline.latest.value)}<span class="unit">%, {agricultureData.headline.latest.period}</span>
                </div>
                <p class="mini-sentence">{agricultureData.headline.lead_sentence}</p>
                <a class="satellite-link" href="/agriculture/">Voir le détail (terres, production, alimentation) →</a>
              </div>

              <h2 id="prix">Prix</h2>
              <p class="category-note">
                L'inflation résume en un chiffre l'évolution des prix à la consommation.
              </p>
              <div class="satellite-card">
                <div class="ind-value">
                  {fmtPct(prixData.inflation.latest.value)}<span class="unit">%, {prixData.inflation.latest.period}</span>
                </div>
                <p class="mini-sentence">{prixData.inflation.lead_sentence}</p>
                <a class="satellite-link" href="/prix/">Voir le détail (indice, par fonction COICOP) →</a>
              </div>
            </>
          )}

          {category.key === "commerce" && (
            <>
              <h2 id="composition-commerce">Composition du commerce extérieur</h2>
              <p class="category-note">
                Les premiers postes, {data.trade_composition.year} - une donnée miroir
                de commerce (OEC/BACI), distincte des totaux Banque mondiale ci-dessus.
              </p>
              <div class="trade-composition-grid">
                <div class="trade-list">
                  <h3>Principaux produits exportés</h3>
                  <ul class="rank-list">
                    {data.trade_composition.top_exports.map((r: any) => (
                      <li>
                        <div class="rank-row">
                          <span class="rank-label">{r.name_fr.replace("Exportations - ", "")}</span>
                          <span class="rank-value">{fmtTradeUSD(r.value)}</span>
                        </div>
                        <div class="rank-bar-track">
                          <div class="rank-bar-fill" style={`width:${(r.value / data.trade_composition.top_exports[0].value * 100).toFixed(1)}%`}></div>
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="trade-list">
                  <h3>Principales destinations à l'export</h3>
                  <ul class="rank-list">
                    {data.trade_composition.top_export_partners.map((r: any) => (
                      <li>
                        <div class="rank-row">
                          <span class="rank-label">{r.name_fr.replace("Exportations vers ", "").replace(/^(le |la |l')/, "")}</span>
                          <span class="rank-value">{fmtTradeUSD(r.value)}</span>
                        </div>
                        <div class="rank-bar-track">
                          <div class="rank-bar-fill" style={`width:${(r.value / data.trade_composition.top_export_partners[0].value * 100).toFixed(1)}%`}></div>
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="trade-list">
                  <h3>Principales origines à l'import</h3>
                  <ul class="rank-list">
                    {data.trade_composition.top_import_partners.map((r: any) => (
                      <li>
                        <div class="rank-row">
                          <span class="rank-label">{r.name_fr.replace("Importations depuis ", "").replace(/^(le |la |les |l')/, "")}</span>
                          <span class="rank-value">{fmtTradeUSD(r.value)}</span>
                        </div>
                        <div class="rank-bar-track">
                          <div class="rank-bar-fill" style={`width:${(r.value / data.trade_composition.top_import_partners[0].value * 100).toFixed(1)}%`}></div>
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
              <span style="font-size:11px;color:var(--ink-faint);display:block;margin-top:10px;">
                {data.trade_composition.source.producer}. Récupéré le {data.trade_composition.source.retrieved_at}.
              </span>
            </>
          )}
        </>
      ))}

      <h2 id="non-mesure">Ce qui n'est pas mesuré</h2>
      <ul class="not-measured">
        <li>Rien par région, préfecture ou sous-préfecture : toutes ces données sont nationales.</li>
        <li>Le taux de pauvreté n'a que 3 points dans le temps (1992, un point intermédiaire, 2021) - il dépend de la disponibilité d'enquêtes de ménages, pas d'une série annuelle.</li>
        <li>Les recettes publiques n'ont pas de point après 2021.</li>
        <li>Aucune ventilation par secteur au-delà de l'agriculture (industrie, services) et aucune donnée sur l'inflation des prix à la production - la page <a href="/prix/">Prix</a> ne couvre que l'inflation à la consommation.</li>
        <li>Les comptes nationaux de l'ICASEES ne couvrent que 2019 à 2021 pour l'instant - pas de mise à jour au-delà.</li>
        <li>Le cadre e-GDDS du FMI est censé couvrir le PIB, les prix, la dette et le secteur monétaire, mais la RCA n'y publie pour l'instant qu'un seul indicateur (l'indice d'activité économique ci-dessus), arrêté au premier trimestre 2023.</li>
      </ul>

      <footer>
        Toutes les données de cette page : World Bank (World Development Indicators),
        récupérées via l'API publique <a href="https://api.worldbank.org/v2/country/CAF/indicator/">api.worldbank.org</a>, le 2026-09-12.
        Détail par source sur la page <a href="/sources/">Sources</a>.
