---
// docs/plan.md §2.1: "About, licence, contact." No institutional partner
// exists yet (tracked as an open question in docs/plan.md Part 8) - left
// unmentioned here rather than inventing one or surfacing an internal
// "still needed" note as if it were reader-facing content (2026-09-13:
// a visible on-page TODO box was removed for exactly that reason).
import ThemeInit from "../components/ThemeInit.astro";
import SiteNav from "../components/SiteNav.astro";
---
<!doctype html>
<html lang="fr">
  <head>
    <ThemeInit />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>À propos - BêAfrîka Data</title>
    <style>
      :root {
        --paper: #23251F; --ink: #E8E6DA; --ink-muted: #A6A895; --ink-faint: #8C8F7F;
        --line: #33362A; --indigo: #6FA0E8; --ochre: #E0A83D;
      }
      :root[data-theme="light"] { --paper: #EDEEE6; --ink: #1B2420; --ink-muted: #5A6259; --ink-faint: #8B9188; --line: #D6D7C9; --indigo: #2A56A8; --ochre: #8C5A0C; }
      @media print {
        :root { --paper: #EDEEE6; --ink: #1B2420; --ink-muted: #5A6259; --ink-faint: #8B9188; --line: #D6D7C9; --indigo: #2A56A8; --ochre: #8C5A0C; }
        body { background: #fff !important; background-image: none !important; }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background-color: var(--paper);
        background-image:
          radial-gradient(1000px 520px at 10% -10%, color-mix(in srgb, var(--indigo) 8%, transparent), transparent 60%),
          radial-gradient(700px 420px at 100% 100%, color-mix(in srgb, var(--indigo) 5%, transparent), transparent 60%);
        background-attachment: fixed;
        color: var(--ink); font-family: system-ui, sans-serif; font-size: 15px; line-height: 1.6;
      }
      main { max-width: 640px; margin: 0 auto; padding: 84px 24px 80px; }
      h1 { font-size: 1.8rem; margin: 0 0 8px; }
      h2 { font-size: 1rem; margin: 31px 0 9px; padding-top: 15px; border-top: 1px solid var(--line); }
      p { margin: 0 0 12px; }
      a { color: var(--indigo); transition: opacity 0.15s ease; }
      a:hover { opacity: 0.75; }
      code { font-family: ui-monospace, monospace; font-size: 0.9em; }
      ul { padding-left: 20px; margin: 0 0 12px; }
      footer { margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 12px; color: var(--ink-faint); }
      .site-nav { display: flex; gap: 14px; flex-wrap: wrap; }
      .site-nav a { color: var(--indigo); font-size: 12.5px; transition: opacity 0.15s ease; }
      .site-nav a:hover { opacity: 0.7; }
    </style>
  </head>
  <body>
    <SiteNav />
    <main id="main-content">
      <h1>À propos</h1>

      <h2>Ce que c'est</h2>
      <p>
        Une œuvre de référence publique sur la République centrafricaine :
        des chiffres nationaux par thème, avec la possibilité de descendre
        jusqu'à la région, la préfecture et la sous-préfecture, chaque
        chiffre accompagné de sa source et de sa date - pas un portail de
        données, pas un tableau de bord.
      </p>
      <p>
        Ce site complète l'ICASEES (Institut Centrafricain des Statistiques
        et des Études Économiques et Sociales) et d'autres portails comme
        celui de la Banque mondiale : c'est une couche qui rassemble leurs
        données déjà publiées, la plupart sous licence CC BY 4.0, pour les
        rendre plus faciles à consulter et à situer géographiquement.
      </p>

      <h2>Qui le construit</h2>
      <p>
        Jean Paul Zolabe, passionné de projets citoyens et de vulgarisation
        technologique <a href="https://www.linkedin.com/in/jean-paul-zolabe-75515912b/">LinkedIn</a>.
      </p>

      <h2>Licence</h2>
      <p>
        Les données (<code>data/</code>, <code>geo/</code>, et les extractions
        de <code>raw/</code>) sont sous licence
        <a href="https://creativecommons.org/licenses/by/4.0/legalcode">CC BY 4.0</a>.
        Le code est sous licence MIT. Détails et mises en garde par source :
        <a href="/sources/">Sources</a>.
      </p>

      <h2>Code source</h2>
      <p>
        Le dépôt complet - données, pipeline et site - est public :
        <a href="https://github.com/jpzolabe/car-data-atlas">github.com/jpzolabe/car-data-atlas</a>.
      </p>

      <h2>Contact</h2>
      <p>
        <a href="https://www.linkedin.com/in/jean-paul-zolabe-75515912b/">LinkedIn</a>.
      </p>

      <footer>
        <nav class="site-nav">
          <a href="/population/">Population</a>
          <a href="/infrastructures/">Infrastructures</a>
          <a href="/education/">Éducation</a>
          <a href="/sante/">Santé</a>
          <a href="/economie/">Économie</a>
          <a href="/prefectures/">Préfectures</a>
          <a href="/sources/">Sources</a>
          <a href="/methode/">Méthode</a>
          <a href="/donnees/">Données</a>
          <a href="/a-propos/">À propos</a>
        </nav>
      </footer>
    </main>
  </body>
</html>
