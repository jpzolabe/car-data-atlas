---
// Shared breadcrumb, replacing 13 near-identical copies of a plain-text
// "République centrafricaine" link to home - as inert body text it gave no
// visual hint it was a link. Reuses SiteNav's home glyph so the same shape
// means "go home" everywhere on the site.
interface Props {
  trail?: { label: string; href: string }[];
  accent?: string; // CSS custom property name for the hover colour, e.g. "--t-agri"
}
const { trail = [], accent = "--indigo" } = Astro.props;
---

<div class="crumb" style={`--crumb-accent: var(${accent})`}>
  <a href="/" class="crumb-home">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 11.5 12 4l9 7.5"></path>
      <path d="M5.5 10v9.5a1 1 0 0 0 1 1H9.5v-6h5v6H17.5a1 1 0 0 0 1-1V10"></path>
    </svg>
    <span>République centrafricaine</span>
  </a>
  {trail.map((t) => (
    <>
      {" / "}
      <a href={t.href}>{t.label}</a>
    </>
  ))}
</div>

<style>
  .crumb {
    display: flex; align-items: center; flex-wrap: wrap; gap: 4px;
    font-family: ui-monospace, monospace; font-size: 11px; text-transform: uppercase;
    letter-spacing: .05em; color: var(--ink-faint); margin-bottom: 6px;
  }
  .crumb a { color: var(--ink-faint); text-decoration: none; }
  .crumb a:hover { color: var(--crumb-accent); text-decoration: underline; }
  .crumb-home { display: inline-flex; align-items: center; gap: 4px; }
  .crumb-home svg { flex-shrink: 0; }
</style>
